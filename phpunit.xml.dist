<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         backupGlobals="false">
    <testsuites>
        <testsuite name="WP MCP AI Plugin Test Suite">
            <directory suffix=".php">tests</directory>
            <directory suffix=".php">addons/pro/tests</directory>
            <directory suffix=".php">addons/canvas-toolkit/tests</directory>
            <directory suffix=".php">addons/media-studio/tests</directory>
            <directory suffix=".php">addons/saas-controller/tests</directory>
            <directory suffix=".php">addons/checkout-api/tests</directory>
            <directory suffix=".php">addons/nvoos-design-system/tests</directory>
            			<directory suffix=".php">addons/schedule-anything-platform/tests</directory>
            			<directory suffix=".php">addons/nvoos-astro-bridge/tests</directory>
            <exclude>tests/manual-test-preset-preview.php</exclude>
            <exclude>tests/manual-verify-auto-aspect-ratio.php</exclude>
            <exclude>tests/manual</exclude>
            <exclude>tests/bootstrap.php</exclude>
            <exclude>tests/fixtures</exclude>
            <exclude>tests/regression</exclude>
            <!-- The base+pro matrix runs this suite under phpunit-basepro.xml.dist
                 with WP_MCP_AI_BASE_VERSION=true; the monolith suite boots with the
                 full-version constant and must not pick these tests up. -->
            <exclude>tests/basepro</exclude>
            <exclude>tests/wp-cli-smoke.php</exclude>
            <exclude>tests/wp-tests-config.php</exclude>
            <!-- Standalone smoke harnesses (no WordPress, minimal stubs) —
                 PHPUnit must never load these: they redeclare core WP
                 functions and fatal at discovery. Run them directly:
                 php tests/pro/tools/food-beverage/smoke-run.php
                 php tests/pro/tools/food-beverage/validate-assistant-packs.php -->
            <exclude>tests/pro/tools/food-beverage/smoke-run.php</exclude>
            <exclude>tests/pro/tools/food-beverage/validate-assistant-packs.php</exclude>
            <exclude>tests/helpers</exclude>
            <exclude>tests/abilities/class-wp-mcp-ai-ability-bridge-mock-tool.php</exclude>
            <exclude>tests/abilities/trait-wp-mcp-ai-ability-test-bootstrap.php</exclude>
            <exclude>tests/graphify/bootstrap.php</exclude>
            <exclude>tests/paper-store/trait-paper-store-test-helpers.php</exclude>
            <exclude>addons/pro/tests/class-wp-mcp-ai-workflow-log-context-recorder-tool.php</exclude>
            <exclude>addons/pro/tests/class-wp-mcp-ai-media-toolkit-stub.php</exclude>
            <exclude>addons/pro/tests/class-docs-hub-stubs.php</exclude>
            <exclude>addons/pro/tests/class-sa-tools-rest-stub-tool.php</exclude>
            <!-- Stub files required lazily from inside test methods
                 (test-pro-spa-config-island-endpoints.php). Loading them
                 during discovery defines the real NV_oOS_Media_Studio/
                 Document_Editor_Shortcode classes (or empty stubs), which
                 breaks the bare-environment feature-flag contract. -->
            <exclude>addons/pro/tests/class-media-studio-stub.php</exclude>
            <exclude>addons/pro/tests/class-document-editor-stub.php</exclude>
            <exclude>addons/saas-controller/tests/bootstrap.php</exclude>
            <exclude>addons/checkout-api/tests/bootstrap.php</exclude>
            <exclude>addons/nvoos-design-system/tests/bootstrap.php</exclude>
            			<exclude>addons/schedule-anything-platform/tests/bootstrap.php</exclude>
            			<exclude>addons/nvoos-astro-bridge/tests/bootstrap.php</exclude>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>external-http</group>
        </exclude>
    </groups>
    	<source>
    		<include>
    			<directory suffix=".php">includes</directory>
    			<directory suffix=".php">addons/pro/includes</directory>
    			<directory suffix=".php">addons/chat-spa/includes</directory>
    			<directory suffix=".php">addons/canvas-toolkit/includes</directory>
    			<directory suffix=".php">addons/document-editor/includes</directory>
    			<directory suffix=".php">addons/media-studio/includes</directory>
    			<directory suffix=".php">addons/toolkit-shell/includes</directory>
    			<directory suffix=".php">addons/docs-hub/includes</directory>
    			<directory suffix=".php">addons/saas-controller/includes</directory>
    			<directory suffix=".php">addons/embedded/includes</directory>
    			<directory suffix=".php">addons/algorave/includes</directory>
    			<directory suffix=".php">addons/fantasy-football/includes</directory>
    			<directory suffix=".php">addons/graphify/includes</directory>
    			<directory suffix=".php">addons/checkout-api/includes</directory>
    			<directory suffix=".php">addons/nvoos-design-system/includes</directory>
    		</include>
    		<!--
    			No <exclude> directories: PHPUnit 11's SourceMapper recursively
    			walks every exclude path to build its file map, and none of the
    			previously-listed trees (vendor, node_modules, tests, bin,
    			examples, assets/examples) is ever reachable from an include
    			directory above — they were semantic no-ops that still paid the
    			full walk cost (pathological on bind-mounted worktrees where
    			examples/nvoos-dictate/src-tauri's Rust target/ alone is 70 GB+).
    		-->
    	</source>
    <coverage includeUncoveredFiles="true"
              pathCoverage="false"
              ignoreDeprecatedCodeUnits="true"
              disableCodeCoverageIgnore="false">
        <report>
            <clover outputFile="coverage.xml"/>
            <html outputDirectory="coverage/html"/>
            <text outputFile="coverage/coverage.txt" showUncoveredFiles="false" showOnlySummary="true"/>
        </report>
    </coverage>
</phpunit>
