<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="WP MCP AI Plugin Test Suite">
            <directory suffix=".php">tests</directory>
            <directory suffix=".php">addons/pro/tests</directory>
            <exclude>tests/bootstrap.php</exclude>
            <exclude>tests/wp-tests-config.php</exclude>
            <exclude>tests/helpers</exclude>
            <exclude>tests/manual-test-preset-preview.php</exclude>
            <exclude>tests/manual-verify-auto-aspect-ratio.php</exclude>
            <exclude>tests/manual</exclude>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>external-http</group>
        </exclude>
    </groups>
</phpunit>
