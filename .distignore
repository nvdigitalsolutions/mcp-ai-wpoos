# Build output and build-time directories (not needed in SVN)
# Note: build/workflow-builder/ is included (contains pre-built visual builder assets)
svn-*
addons
core
shared
lib

# Specific exclusions for this plugin
# Note: test-capability-flags-integration.php moved to bin/ which is already excluded
# mcp-ai-wpoos-base.php is a restricted-mode entry point for private/custom builds only;
# it sets WP_MCP_AI_BASE_VERSION=true which hides built-in tools and shows Pro upsells.
# Excluded from WP.org distribution to ensure all included tools are always available.
mcp-ai-wpoos-base.php
mcp-diagnostic-debug.php
test-storage-service.html
examples
assets/examples

# CDN-dependent features (not compliant with WordPress.org)
# These files load external runtime dependencies from jsdelivr CDN
# They are Pro features and excluded from WordPress.org deployment
includes/class-wp-mcp-ai-langchain-enqueue.php
includes/class-wp-mcp-ai-transformers-enqueue.php
includes/class-wp-mcp-ai-webworker-enqueue.php
assets/js/langchain-tool-adapter.min.js
assets/js/langchain-tool-adapter.js
assets/js/langchain-orchestration.min.js
assets/js/langchain-orchestration.js
assets/js/transformers-tasks-client.min.js
assets/js/transformers-tasks-client.js
assets/js/web-worker-manager.min.js
assets/js/web-worker-manager.js
assets/js/workers

# Keep these files (negation - they will be included)
!readme.txt
!LICENSE

# AI-generated documentation and development files (WordPress.org compliance)
archive/
