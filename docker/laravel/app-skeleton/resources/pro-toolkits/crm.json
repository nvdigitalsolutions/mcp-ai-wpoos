{
  "slug": "crm",
  "name": "CRM",
  "version": "1.0.0",
  "description": "Lead scoring, routing, consent, outbound channels and sourcing settings for the CRM toolkit.",
  "icon": "🤝",
  "feature": "crm",
  "screens": ["settings"],
  "tab_labels": {
    "qualification": "Lead qualification",
    "routing": "Lead routing",
    "consent": "Consent",
    "integrations": "Integrations",
    "hygiene": "Email hygiene",
    "upwork": "Upwork",
    "linkedin": "LinkedIn",
    "sourcing": "Sourcing",
    "results": "Results & notifications",
    "operations": "Operations"
  },
  "settings": [
    {
      "key": "qualification_framework",
      "label": "Qualification framework",
      "type": "select",
      "tab": "qualification",
      "default": "bant",
      "options": ["bant", "meddic", "champ"],
      "description": "Framework the qualification tools apply to a lead."
    },
    {
      "key": "hot_score_threshold",
      "label": "Hot lead threshold",
      "type": "number",
      "tab": "qualification",
      "default": 70,
      "description": "Leads scoring at or above this value are hot."
    },
    {
      "key": "warm_score_threshold",
      "label": "Warm lead threshold",
      "type": "number",
      "tab": "qualification",
      "default": 40,
      "description": "Leads scoring at or above this value are warm."
    },
    {
      "key": "routing_strategy",
      "label": "Routing strategy",
      "type": "select",
      "tab": "routing",
      "default": "round_robin",
      "options": ["round_robin", "weighted"],
      "description": "Round robin distributes evenly; weighted assigns to the rep with the fewest active leads."
    },
    {
      "key": "require_double_opt_in",
      "label": "Require double opt-in",
      "type": "boolean",
      "tab": "consent",
      "default": false,
      "description": "Only leads that confirmed their address are treated as marketable."
    },
    {
      "key": "physical_address",
      "label": "CAN-SPAM physical address",
      "type": "text",
      "tab": "consent",
      "default": "",
      "description": "Appended to outbound email footers."
    },
    {
      "key": "gmail_default_query",
      "label": "Default Gmail import query",
      "type": "text",
      "tab": "integrations",
      "default": "",
      "description": "Gmail search expression used when an inbox scan has no explicit query."
    },
    {
      "key": "gmail_poll_interval",
      "label": "Gmail poll interval (seconds)",
      "type": "number",
      "tab": "integrations",
      "default": 300
    },
    {
      "key": "gmail_max_per_poll",
      "label": "Max emails per poll",
      "type": "number",
      "tab": "integrations",
      "default": 10
    },
    {
      "key": "gmail_use_history_sync",
      "label": "Incremental sync (historyId)",
      "type": "boolean",
      "tab": "integrations",
      "default": false,
      "description": "Resume from the last history cursor instead of re-reading the query window."
    },
    {
      "key": "sms_provider",
      "label": "SMS provider",
      "type": "select",
      "tab": "integrations",
      "default": "twilio",
      "options": ["twilio", "notifylk"]
    },
    {
      "key": "twilio_account_sid",
      "label": "Twilio account SID",
      "type": "text",
      "tab": "integrations",
      "default": ""
    },
    {
      "key": "twilio_auth_token",
      "label": "Twilio auth token",
      "type": "secret",
      "tab": "integrations"
    },
    {
      "key": "twilio_from_number",
      "label": "Twilio from number",
      "type": "text",
      "tab": "integrations",
      "default": ""
    },
    {
      "key": "whatsapp_access_token",
      "label": "WhatsApp access token",
      "type": "secret",
      "tab": "integrations"
    },
    {
      "key": "whatsapp_phone_number_id",
      "label": "WhatsApp phone number ID",
      "type": "text",
      "tab": "integrations",
      "default": ""
    },
    {
      "key": "whatsapp_app_secret",
      "label": "WhatsApp app secret",
      "type": "secret",
      "tab": "integrations"
    },
    {
      "key": "notifylk_user_id",
      "label": "notify.lk user ID",
      "type": "text",
      "tab": "integrations",
      "default": ""
    },
    {
      "key": "notifylk_api_key",
      "label": "notify.lk API key",
      "type": "secret",
      "tab": "integrations"
    },
    {
      "key": "notifylk_sender_id",
      "label": "notify.lk sender ID",
      "type": "text",
      "tab": "integrations",
      "default": ""
    },
    {
      "key": "exclude_list",
      "label": "Exclude list",
      "type": "textarea",
      "tab": "hygiene",
      "rows": 5,
      "default": "",
      "description": "Addresses or domains to always skip during import. One per line; use @domain.com to block a domain."
    },
    {
      "key": "priority_list",
      "label": "Priority list",
      "type": "textarea",
      "tab": "hygiene",
      "rows": 5,
      "default": "",
      "description": "Addresses or domains to always fast-track. One per line."
    },
    {
      "key": "spam_domains",
      "label": "Spam domains",
      "type": "textarea",
      "tab": "hygiene",
      "rows": 3,
      "default": "",
      "description": "Known spam domains; substring match."
    },
    {
      "key": "promotional_domains",
      "label": "Promotional domains",
      "type": "textarea",
      "tab": "hygiene",
      "rows": 3,
      "default": "",
      "description": "Bulk-marketing senders, so the classifier can spot promotional mail from new addresses."
    },
    {
      "key": "priority_domains",
      "label": "Priority domains",
      "type": "textarea",
      "tab": "hygiene",
      "rows": 3,
      "default": "",
      "description": "Sender domains that are always treated as priority."
    },
    {
      "key": "promotional_keywords",
      "label": "Promotional keywords",
      "type": "textarea",
      "tab": "hygiene",
      "rows": 3,
      "default": "",
      "description": "Phrases that indicate promotional content. One per line; case-insensitive."
    },
    {
