APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── NV oOS runtime ─────────────────────────────────────────────────────────────
# Pro entitlement (Proposal 090-B ADR-7 · Proposal 149 T-0.8).
# driver: allow | deny | config | license. Unknown values fail closed.
#   allow   — every feature entitled (development and CI; this is the default).
#   deny    — nothing entitled.
#   config  — only the features listed in config/oos.php `pro_entitlement.features`.
#   license — resolve against the commercial licence server below.
NVOOS_PRO_ENTITLEMENT_DRIVER=allow
# NVOOS_PRO_LICENSE_KEY=
# NVOOS_PRO_LICENSE_SERVER=https://licences.example.com
# NVOOS_PRO_LICENSE_INSTANCE=https://app.example.com
# NVOOS_PRO_LICENSE_PRODUCT=mcp-ai-wpoos-pro
# NVOOS_PRO_PLAN=compliance
# NVOOS_PRO_ENTITLEMENT_TTL=43200
# NVOOS_PRO_ENTITLEMENT_DENIED_TTL=300
# NVOOS_PRO_ENTITLEMENT_GRACE_TTL=604800
# NVOOS_PRO_ENTITLEMENT_TIMEOUT=10

# ADS design tokens for the Filament admin palette (Proposal 149 T-0.6).
# A normal checkout needs no override; the docker-compose stack sets it because
# the repo is a bind mount at /workspace/oos rather than a parent path.
# NVOOS_TOKENS_PATH=/workspace/oos/examples/nvoos-astro-velocity/src/tokens
