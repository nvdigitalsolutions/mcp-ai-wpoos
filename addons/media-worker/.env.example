# ─────────────────────────────────────────────────────────────
# Design Stack Media Worker — environment configuration
# Copy to .env and adjust. Every variable is optional except
# where noted; unset variables fall back to safe defaults.
# ─────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────
# Port to listen on (managed hosts inject this themselves).
PORT=3100
# Set to 1 when running behind NGINX/load balancer (Cloudways Velocity)
# so rate limiting sees the real client IP from X-Forwarded-For.
TRUST_PROXY=1
NODE_ENV=production
# JSON body limit (OWASP: keep small; upload routes use multer's 50 MB).
MAX_JSON_BODY=10mb
# Hard per-request timeout in milliseconds.
REQUEST_TIMEOUT_MS=60000

# ── Security ─────────────────────────────────────────────────
# Shared secret required on every /api/* request (X-Site-Token header).
# Must match the WordPress side (wp_mcp_ai_media_worker_token option or
# WP_MEDIA_WORKER_TOKEN constant). Use >= 32 random characters.
# When unset, the API is OPEN (local Docker development only).
WORKER_API_TOKEN=
# fail closed when no token is configured ("strict"); default lenient.
AUTH_MODE=strict

# ── Multi-tenant (shared worker mode, optional) ─────────────
# JSON map of site slug -> token. When set, the worker runs in
# multi-tenant mode: WORKER_API_TOKEN is ignored, every /api/* request
# must carry a token belonging to a known site (fail-closed), and
# files/queues/rate limits are namespaced per site. Use one slug per
# WordPress site (e.g. "client-a"). The matching per-site token goes
# into that site's WP_MEDIA_WORKER_TOKEN.
SITE_TOKENS={"site-a":"<tokenA>","site-b":"<tokenB>"}
# Alternative per-site form (Phase 3 W3) — merge over SITE_TOKENS when
# platform env-size limits are a concern; env wins over the JSON.
# SITE_TOKEN_SITE_A=<tokenA>
# SITE_TOKEN_SITE_B=<tokenB>
# Rotation overlap: slug -> previous token (same semantics as
# WORKER_API_TOKEN_PREVIOUS). Remove once rotation is complete.
SITE_TOKENS_PREVIOUS={"site-a":"<oldTokenA>"}
# Per-site provider credentials (Phase 2, v2.5.0): JSON map of site slug ->
# { credential_name: value }. Keys are env var names lowercased, e.g.
# "openai_api_key", "gemini_api_key", "firefly_client_id",
# "twitter_access_token_secret". Resolution: per-site key -> shared pool
# env var -> 503 capability_unavailable. Values are secrets — mark the
# whole variable Sensitive in the hosting dashboard.
SITE_PROVIDER_KEYS={"site-a":{"openai_api_key":"sk-..."}}
# Alternative per-site form (Phase 3 W3) — one site's entries object
# per env var, merged over the JSON; env wins.
# SITE_PROVIDER_KEYS_SITE_A={"openai_api_key":"sk-..."}
# Hot-reload provider keys from a JSON file instead of env (Phase 3 W5).
# The file is watched; malformed updates are rejected and the previous
# map stays active.
# PROVIDER_KEYS_FILE=/path/to/provider-keys.json
# Fail closed: disable the shared-pool fallback in multi-tenant mode
# (per-site keys only).
PROVIDER_KEYS_STRICT=0
# Root directory for per-site scratch space (multi-tenant only;
# defaults to <os.tmpdir>/mw). Each group gets a subdirectory with its
# own TTL.
TEMP_ROOT=
# Per-group TTLs in milliseconds (defaults shown). TEMP_TTL is the
# fallback for the scratch group.
TEMP_TTL=86400000
# TEMP_TTL_UPLOAD=604800000   # user uploads (video/PDF inputs), 7d
# TEMP_TTL_VIDEO=3600000      # processed video outputs, 1h
# TEMP_TTL_BROWSER=3600000    # screenshots / PDFs, 1h
# TEMP_TTL_DOC=86400000       # excel / word / data outputs, 24h
# Enforce site-namespace path checks even in single-tenant mode.
STRICT_PATHS=0
# Per-site rate limit overrides (slug uppercased, hyphens -> underscores).
# RATE_LIMIT_IMAGE_SITE_A=60

# Comma-separated browser origins allowed to call the API (CORS).
# Leave unset for server-to-server traffic (recommended).
ALLOWED_ORIGINS=
# Set to 1 ONLY for local development: disables the SSRF blocklist.
# Never set this on a publicly reachable deployment.
SSRF_ALLOW_PRIVATE=0
# Set to 1 ONLY in constrained local environments: allows falling back
# to --no-sandbox when the Chromium sandbox cannot start.
# Never set this on a publicly reachable deployment.
ALLOW_NO_SANDBOX=0

# ── Rate limiting (requests per window) ──────────────────────
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_IMAGE=30
RATE_LIMIT_VIDEO=20
RATE_LIMIT_BROWSER=30
RATE_LIMIT_WORKFLOW=30
# Cluster-safe shared store (Phase 3 W4): use a Redis-backed rate-limit
# store when PM2 runs in cluster mode. Requires REDIS_URL and the optional
# rate-limit-redis dependency; falls back to in-memory on any failure.
# RATE_LIMIT_REDIS=1

# ── AI providers (any subset) ────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_KEY=
MIDJOURNEY_API_KEY=
LEONARDO_API_KEY=
IDEOGRAM_API_KEY=
GETIMG_API_KEY=
DEEPAI_API_KEY=
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
ANTHROPIC_API_KEY=

# ── Social publishing (optional) ─────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
LINKEDIN_TOKEN=

# ── Queue ────────────────────────────────────────────────────
# Redis URL for the workflow job queue. When unset, the queue is
# in-memory (fine for a single PM2 process; required for cluster mode).
# NOTE: PM2 cluster mode also multiplies in-memory rate-limit budgets
# per instance — set RATE_LIMIT_REDIS=1 (Phase 3 W4) alongside REDIS_URL
# when scaling out.
REDIS_URL=

# ── Browser / Puppeteer ──────────────────────────────────────
# Path to the Chromium binary (Docker sets this automatically).
PUPPETEER_EXECUTABLE_PATH=
# Extra Chromium args (--no-sandbox is stripped regardless).
PUPPETEER_ARGS=
# Maximum concurrent browser launches.
PUPPETEER_MAX_CONCURRENT=2

# ── Status monitoring module (opt-in; worker v3.3.0+) ───────
# Fleet monitoring: connected sites push signed heartbeats, the worker
# detects silence (dead man's switch), optionally probes public sites
# externally, and serves summary/history/metrics APIs. All off by default.
STATUS_ENABLED=0
# Expected heartbeat cadence (the plugin sends every 5 minutes).
STATUS_HEARTBEAT_INTERVAL_MS=300000
# Miss grace = interval x multiplier (covers WP-Cron drift).
STATUS_GRACE_MULTIPLIER=2
# Consecutive misses before a site flips to major_outage.
STATUS_CONFIRM_MISSES=2
# Heartbeats needed to recover (always fast).
STATUS_CONFIRM_RECOVERIES=1
# Retention for raw transition history.
STATUS_HISTORY_DAYS=90
# Uptime rollup bucket size.
STATUS_ROLLUP_BUCKET_MS=1800000
# Sweeper tick (checks for missed heartbeats).
STATUS_SWEEPER_INTERVAL_MS=60000
# Rate limit group (heartbeats + summary reads per site/IP).
RATE_LIMIT_STATUS=120
# Synthetic external checks (public sites only; SSRF guard applies).
STATUS_SYNTHETIC_ENABLED=0
STATUS_SYNTHETIC_INTERVAL_MS=60000
STATUS_SYNTHETIC_TIMEOUT_MS=10000
STATUS_SSL_EXPIRY_WARN_DAYS=14
# Public, allowlisted fleet page (JSON + ?format=html). Off by default.
STATUS_PUBLIC_PAGE=0
# OpenMetrics exposition at GET /api/status/metrics. Off by default.
STATUS_METRICS=0
# Alerting: HMAC-signed webhooks (JSON array) + optional email.
# STATUS_ALERT_WEBHOOKS=["https://hooks.example.com/status"]
# STATUS_ALERT_WEBHOOK_SECRET=
# STATUS_ALERT_EMAIL_TO=
# Minimum gap between repeated alerts for the same site (ms).
STATUS_ALERT_COOLDOWN_MS=900000
# Per-site overrides (slug uppercased, hyphens -> underscores):
# STATUS_SITE-A_HEARTBEAT_INTERVAL_MS=60000
# STATUS_SITE-A_SYNTHETIC=1
# STATUS_SITE-A_SYNTHETIC_URL=https://site-a.example.com/wp-json/mcp-ai/v1/status
# STATUS_SITE-A_MAINTENANCE_UNTIL=2026-12-31T23:59:59Z
