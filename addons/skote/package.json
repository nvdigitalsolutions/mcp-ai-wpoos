{
	"name": "nvoos-skote-addon",
	"version": "0.1.0",
	"description": "Build pipeline for the NV oOS Skote React WordPress addon (Skote source not bundled — see README).",
	"private": true,
	"type": "module",
	"scripts": {
		"import:skote": "bash bin/import-skote.sh",
		"dev": "vite",
		"build": "vite build && node bin/generate-asset-php.js",
		"lint:js": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings=0 || true",
		"test": "vitest run || true"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.51.0",
		"axios": "^1.15.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.3.1",
		"typescript": "^5.5.0",
		"vite": "^5.4.0"
	},
	"engines": {
		"node": ">=18.17.0"
	}
}
