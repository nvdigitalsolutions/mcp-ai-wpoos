# NV oOS Cloud Worker — local dev secrets
#
# Copy this file to `.dev.vars` and fill in the values:
#   cp .dev.vars.example .dev.vars
#
# `.dev.vars` is gitignored — never commit real secrets.
# Placeholder values below are enough for balance / ledger / connect-token
# endpoints. Real values are required for live inference and Stripe.

# Master OpenRouter key — used for the inference passthrough (never exposed to clients).
OPENROUTER_API_KEY=sk-or-local-dev-placeholder

# Stripe restricted key — powers /v1/account/topup (Checkout sessions).
STRIPE_SECRET_KEY=sk_test_local_placeholder

# `whsec_...` signing secret for /stripe/webhook signature verification.
STRIPE_WEBHOOK_SECRET=whsec_local_placeholder

# Cloudflare AI Gateway URL: https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_ID>/openrouter
CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/test-acct/test-gw/openrouter

# Shared secret between the Cloud Worker and the SaaS platform plugin (Schedule Anything).
# SAAS_API_KEY=local-dev-shared-secret
