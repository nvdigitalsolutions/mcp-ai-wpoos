  "description": "NV oOS Pro Admin SPA — modern TypeScript React admin panel replacing the legacy pro-spa",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.cjs --prod",
    "build:dev": "node esbuild.config.cjs",
    "watch": "node esbuild.config.cjs --watch",
