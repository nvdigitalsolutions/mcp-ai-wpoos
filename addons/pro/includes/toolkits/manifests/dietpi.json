{
  "slug": "dietpi",
  "name": "DietPi",
  "version": "1.0.0",
  "description": "SSH access and per-application API credentials for a DietPi device. Each managed app is flattened from its nested option group into <app>_<field> keys. The private key is a textarea rather than a secret because the WordPress screen re-displays inline PEMs for editing.",
  "icon": "🍓",
  "feature": "dietpi",
  "screens": ["settings"],
  "tab_labels": {
    "connection": "SSH connection",
    "transmission": "Transmission",
    "jackett": "Jackett",
    "sonarr": "Sonarr",
    "radarr": "Radarr",
    "plex": "Plex",
    "jellyfin": "Jellyfin"
  },
  "settings": [
    {
      "key": "host",
      "label": "Hostname or IP",
      "type": "text",
      "tab": "connection",
      "default": "",
      "description": "For example 192.168.1.100 or dietpi.local."
    },
    {
      "key": "ssh_port",
      "label": "SSH port",
      "type": "number",
      "tab": "connection",
      "default": 22
    },
    {
      "key": "ssh_user",
      "label": "SSH user",
      "type": "text",
      "tab": "connection",
      "default": "root"
    },
    {
      "key": "ssh_auth_method",
      "label": "Authentication method",
      "type": "select",
      "tab": "connection",
      "default": "key",
      "options": ["key", "password"]
    },
    {
      "key": "ssh_private_key",
      "label": "SSH private key (PEM)",
      "type": "textarea",
      "tab": "connection",
      "rows": 6,
      "default": "",
      "description": "Paste an Ed25519 or RSA private key, or a filesystem path to the key file."
    },
    {
      "key": "ssh_key_passphrase",
      "label": "Key passphrase",
      "type": "secret",
      "tab": "connection"
    },
    {
      "key": "ssh_password",
      "label": "SSH password",
      "type": "secret",
      "tab": "connection"
    },
    {
      "key": "apps_transmission_enabled",
      "label": "Enabled",
      "type": "boolean",
      "tab": "transmission",
      "default": false
    },
    {
      "key": "apps_transmission_url",
      "label": "Base URL",
      "type": "text",
      "tab": "transmission",
      "default": "",
      "description": "Defaults to port 9091 on the host above."
    },
    {
      "key": "apps_transmission_username",
      "label": "Username",
      "type": "text",
      "tab": "transmission",
      "default": ""
    },
    {
      "key": "apps_transmission_password",
      "label": "Password",
      "type": "secret",
      "tab": "transmission"
    },
    {
      "key": "apps_jackett_enabled",
      "label": "Enabled",
      "type": "boolean",
      "tab": "jackett",
      "default": false
    },
    {
      "key": "apps_jackett_url",
      "label": "Base URL",
      "type": "text",
      "tab": "jackett",
      "default": "",
      "description": "Defaults to port 9117 on the host above."
    },
    {
      "key": "apps_jackett_api_key",
      "label": "API key",
      "type": "secret",
      "tab": "jackett"
    },
    {
      "key": "apps_sonarr_enabled",
      "label": "Enabled",
      "type": "boolean",
      "tab": "sonarr",
