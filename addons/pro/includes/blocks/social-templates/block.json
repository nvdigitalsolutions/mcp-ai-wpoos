{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/social-templates",
	"title": "Social Media Templates",
	"category": "mcp-ai-toolkits",
	"description": "Display social media templates from the Social Media toolkit",
	"keywords": ["social", "media", "templates", "posts", "content", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"category": {
			"type": "string",
			"default": ""
		},
		"display": {
			"type": "string",
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"limit": {
			"type": "number",
			"default": 9
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
