{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/dj-packages",
	"title": "DJ Packages",
	"category": "mcp-ai-toolkits",
	"description": "Display packages from the DJ Management toolkit",
	"keywords": ["dj", "packages", "pricing", "services", "events", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"display": {
			"type": "string",
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"show_price": {
			"type": "boolean",
			"default": true
		},
		"show_features": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
