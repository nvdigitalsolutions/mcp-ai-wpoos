{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/financial-goals",
	"title": "Financial Goals",
	"category": "mcp-ai-toolkits",
	"description": "Display financial goals from the Financial toolkit",
	"keywords": ["financial", "goals", "savings", "targets", "planning", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"display": {
			"type": "string",
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"status": {
			"type": "string",
			"default": "all"
		},
		"show_progress": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
