{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/dj-equipment",
	"title": "DJ Equipment",
	"category": "mcp-ai-toolkits",
	"description": "Display equipment from the DJ Management toolkit",
	"keywords": ["dj", "equipment", "gear", "audio", "music", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"display": {
			"type": "string",
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"category": {
			"type": "string",
			"default": ""
		},
		"show_status": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
