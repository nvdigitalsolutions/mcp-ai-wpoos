{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/calendar-booking",
	"title": "Calendar Booking Form",
	"category": "mcp-ai-toolkits",
	"description": "Display booking form from the Calendar toolkit",
	"keywords": ["calendar", "booking", "appointment", "schedule", "form", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"service": {
			"type": "string",
			"default": ""
		},
		"staff": {
			"type": "string",
			"default": ""
		},
		"show_calendar": {
			"type": "boolean",
			"default": true
		},
		"show_time_slots": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
