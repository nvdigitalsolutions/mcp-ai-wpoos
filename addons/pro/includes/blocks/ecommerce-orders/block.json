{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/ecommerce-orders",
	"title": "E-commerce Orders",
	"category": "mcp-ai-toolkits",
	"description": "Display orders from the E-commerce toolkit",
	"keywords": ["ecommerce", "orders", "shop", "purchases", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"status": {
			"type": "string",
			"default": ""
		},
		"limit": {
			"type": "number",
			"default": 10
		},
		"show_customer": {
			"type": "boolean",
			"default": true
		},
		"show_total": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
