{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/multilingual-glossaries",
	"title": "Multilingual Glossaries",
	"category": "mcp-ai-toolkits",
	"description": "Display glossaries from the Multilingual toolkit",
	"keywords": ["multilingual", "glossary", "terms", "dictionary", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"display": {
			"type": "string",
			"default": "list"
		},
		"industry": {
			"type": "string",
			"default": ""
		},
		"limit": {
			"type": "number",
			"default": 50
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
