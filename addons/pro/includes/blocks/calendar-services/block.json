{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/calendar-services",
	"title": "Calendar Services",
	"category": "mcp-ai-toolkits",
	"description": "Display services from the Calendar toolkit",
	"keywords": ["calendar", "services", "appointments", "booking", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"display": {
			"type": "string",
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"show_price": {
			"type": "boolean",
			"default": true
		},
		"show_duration": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
