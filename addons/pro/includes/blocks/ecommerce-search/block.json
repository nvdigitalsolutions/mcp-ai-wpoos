{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/ecommerce-search",
	"title": "E-commerce Product Search",
	"category": "mcp-ai-toolkits",
	"description": "Display product search from the E-commerce toolkit",
	"keywords": ["ecommerce", "search", "products", "shop", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"placeholder": {
			"type": "string",
			"default": "Search products..."
		},
		"show_filters": {
			"type": "boolean",
			"default": true
		},
		"show_sorting": {
			"type": "boolean",
			"default": true
		},
		"results_per_page": {
			"type": "number",
			"default": 10
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
