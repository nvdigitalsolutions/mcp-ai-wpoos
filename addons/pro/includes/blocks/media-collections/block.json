{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/media-collections",
	"title": "Media Collections",
	"category": "mcp-ai-toolkits",
	"description": "Display media collections gallery",
	"keywords": ["media", "collections", "gallery", "images", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"display": {
			"type": "string",
			"default": "grid"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"limit": {
			"type": "number",
			"default": 9
		},
		"orderby": {
			"type": "string",
			"default": "date"
		},
		"order": {
			"type": "string",
			"default": "desc"
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
