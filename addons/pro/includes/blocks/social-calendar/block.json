{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-toolkits/social-calendar",
	"title": "Social Media Calendar",
	"category": "mcp-ai-toolkits",
	"description": "Display social media calendar from the Social Media toolkit",
	"keywords": ["social", "media", "calendar", "schedule", "posts", "mcp"],
	"textdomain": "mcp-ai-wpoos-pro",
	"attributes": {
		"view": {
			"type": "string",
			"default": "month"
		},
		"platform": {
			"type": "string",
			"default": ""
		},
		"show_status": {
			"type": "boolean",
			"default": true
		},
		"show_preview": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"align": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
