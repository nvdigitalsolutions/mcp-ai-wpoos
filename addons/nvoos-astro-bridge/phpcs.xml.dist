<?xml version="1.0"?>
<ruleset name="Funiq Bridge">
	<description>PHP_CodeSniffer ruleset for the Funiq Bridge addon</description>

	<arg value="p"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress">
		<!-- PSR-4: class files are named after the class (AdminPage.php),
		     not WPCS's class-admin-page.php convention. The autoloader
		     maps NvoosAstroBridge\{Sub}\{Class} to includes/{Sub}/{Class}.php. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
		<!-- Short ternaries are an intentional idiom across the REST
		     controllers and transformers (e.g. `$meta ?: ''`). The rule is
		     kept in the base plugin ruleset; this addon opts out. -->
		<exclude name="Universal.Operators.DisallowShortTernary.Found"/>
		<!-- Bug in PHPCS 3.13.x — same exclusion as the base ruleset. -->
		<exclude name="PSR12.Functions.ReturnTypeDeclaration"/>
		<!-- Deliberate: the bridge sorts products by meta (?sort=-price,
		     ?sort=-rating) and counts category products via tax_query.
		     These match the Payload frontend's query behaviour and run
		     against the small funiq CPT only, so the generic slow-query
		     warnings do not apply. -->
		<exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_key"/>
		<exclude name="WordPress.DB.SlowDBQuery.slow_db_query_tax_query"/>
	</rule>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
</ruleset>
