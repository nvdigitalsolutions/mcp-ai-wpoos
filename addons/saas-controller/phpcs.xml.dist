<?xml version="1.0"?>
<ruleset name="NV oOS SaaS Controller">
<description>PHP_CodeSniffer ruleset for the NV oOS SaaS Controller add-on</description>

<rule ref="WordPress">
	<exclude name="PSR12.Functions.ReturnTypeDeclaration"/>
</rule>

<arg value="p"/>
<arg name="extensions" value="php"/>

<exclude-pattern>*/vendor/*</exclude-pattern>
<exclude-pattern>*/tests/*</exclude-pattern>
<exclude-pattern>*/assets/build/*</exclude-pattern>

<rule ref="WordPress.WP.I18n">
	<properties>
		<property name="text_domain" type="array">
			<element value="nvoos-saas-controller"/>
		</property>
	</properties>
</rule>

<file>.</file>
</ruleset>
