# Gateway auth (>=32 random chars; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
MCP_GATEWAY_TOKEN=
# Rotation-window overlap token (optional):
MCP_GATEWAY_TOKEN_PREVIOUS=

# Public port (Velocity injects PORT; local default 3000):
PORT=3000

# Tool policy (comma-separated; trailing * wildcard; deny wins; applied at
# tool registration — restart the gateway after changes).
# Default: all tools exposed. See README "Tool selection".
MCP_TOOLS_ALLOW=*
MCP_TOOLS_DENY=

NODE_ENV=production
LOG_LEVEL=info

# Passed through to mcp-wordpress (see its configuration guide):
WORDPRESS_SITE_URL=https://target-site.example.com
WORDPRESS_USERNAME=mcp-bridge
WORDPRESS_APP_PASSWORD=
WORDPRESS_AUTH_METHOD=app-password
