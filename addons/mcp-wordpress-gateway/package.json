{
  "name": "mcp-wordpress-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Auth-gated Streamable HTTP gateway for docdyhr/mcp-wordpress, deployed on Cloudways Velocity and connected to NV oOS assistants via the Remote Sites MCP Server connection type.",
  "type": "module",
  "engines": {
    "node": ">=20.8.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "smoke": "node tests/smoke.mjs",
    "check:pins": "node tests/check-pins.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "express": "4.22.3",
    "mcp-wordpress": "3.3.36"
  },
  "overrides": {
    "hono": ">=4.13.11 <5"
  },
  "license": "GPL-3.0-or-later"
}
