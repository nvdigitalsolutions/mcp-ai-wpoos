{
  "name": "mcp-wordpress-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Auth-gated Streamable HTTP gateway for docdyhr/mcp-wordpress, deployed on Cloudways Velocity and connected to NV oOS assistants via the Remote Sites MCP Server connection type.",
  "type": "module",
  "engines": {
    "node": ">=20.8.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "smoke": "node tests/smoke.mjs",
    "check:pins": "node tests/check-pins.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "express": "4.22.3",
    "mcp-wordpress": "3.3.36"
  },
  	"overrides": {
  		"hono": ">=4.13.11 <5",
  	        "ip-address": ">=10.7.4",
  		"qs": ">=6.16.1 <7",
  		"body-parser@^1": ">=1.20.9 <2",
  		"body-parser@^2": ">=2.4.0 <3",
  		"@hono/node-server": ">=2.1.3 <3",
  		"fast-uri@^3": ">=3.1.9 <4",
  		"zod@^4": ">=4.6.6 <5"
  	},
  "license": "GPL-3.0-or-later"
}
