{
	"env": {
		"browser": true,
		"es2020": true,
		"jquery": true
	},
	"parserOptions": {
		"ecmaVersion": 2020,
		"sourceType": "script"
	},
	"globals": {
		"wp": "readonly",
		"wpMcpAiChat": "readonly",
		"wpMcpAiChatInstances": "readonly",
		"wpMcpAiChatStorage": "readonly",
		"wpMcpAiChatClipboard": "readonly",
		"wpMcpAiChatMarkdown": "readonly",
		"wpMcpAiChatDomBatcher": "readonly",
		"wpMcpAiChatUIUtils": "readonly",
		"wpMcpAiChatAudio": "readonly",
		"wpMcpAiUserChats": "readonly",
		"wpMcpAiAdmin": "readonly"
	},
	"rules": {
		"no-console": "warn",
		"camelcase": [
			"error",
			{
				"properties": "never",
				"ignoreDestructuring": true,
				"ignoreImports": true
			}
		],
		"no-var": "error",
		"prefer-const": "error",
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_"
			}
		]
	},
	"overrides": [
		{
			"files": ["**/chat-markdown-service.js", "**/chat-bundle.js"],
			"parserOptions": {
				"sourceType": "module"
			}
		}
	]
}
