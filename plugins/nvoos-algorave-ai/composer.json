{
    "name": "nvdigitalsolutions/nvoos-algorave-ai",
    "description": "Premium AI addon for NV oOS Algorave — 9 AI tools for the NV oOS chat interface (pattern generation, AI music generation, MIDI export, sample management and more).",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "NV Digital Solutions",
            "email": "developer@nvdigitalsolutions.com",
            "homepage": "https://nvdigitalsolutions.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/nvdigitalsolutions/nvoos-algorave-ai",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "composer/installers": "^2.0",
        "phpunit/phpunit": "^9.0",
        "wp-phpunit/wp-phpunit": "*",
        "yoast/phpunit-polyfills": "^3.0",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:wpcs": "phpcs --standard=WordPress",
        "format": "phpcbf",
        "format:wpcs": "phpcbf --standard=WordPress"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.0"
        }
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    }
}
