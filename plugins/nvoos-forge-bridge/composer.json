{
	"name": "nvoos/forge-bridge",
	"description": "Rebuild webhook + preview tokens for sites generated with the NV oOS Astro Forge.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "NV Digital Solutions",
			"email": "developer@nvdigitalsolutions.com",
			"homepage": "https://nvdigitalsolutions.com",
			"role": "Developer"
		}
	],
	"homepage": "https://github.com/nvdigitalsolutions/nvoos-forge-bridge",
	"support": {
		"issues": "https://github.com/nvdigitalsolutions/nvoos-forge-bridge/issues",
		"source": "https://github.com/nvdigitalsolutions/nvoos-forge-bridge"
	},
	"require": {
		"php": "^7.4"
	},
	"require-dev": {
		"composer/installers": "^2.0",
		"phpunit/phpunit": "^9.0",
		"wp-phpunit/wp-phpunit": "*",
		"yoast/phpunit-polyfills": "^3.0",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.4.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.0"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs --standard=phpcs.xml.dist .",
		"format": "phpcbf --standard=phpcs.xml.dist ."
	},
	"autoload": {
		"psr-4": {
			"NvoosForgeBridge\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"NvoosForgeBridge\\Tests\\": "tests/"
		}
	}
}
