msgid "NV oOS Forge Bridge"
msgstr ""

#. Plugin URI of the plugin
#: nvoos-forge-bridge.php
msgid "https://nvdigitalsolutions.com/wpoos"
msgstr ""

#. Description of the plugin
#: nvoos-forge-bridge.php
msgid "Rebuild webhook + preview tokens for sites generated with the NV oOS Astro Forge, plus a form submission bridge for forged JetFormBuilder / Elementor Pro forms. Fires a signed GitHub repository_dispatch when content changes (debounced), verifies inbound rebuild triggers with HMAC, mints single-use preview tokens, and dispatches static-site form submissions to the native form handlers (origin allowlist, rate limit, honeypot/timestamp, optional Turnstile)."
msgstr ""

#. Author of the plugin
#: nvoos-forge-bridge.php
msgid "NV Digital Solutions"
msgstr ""

#. Author URI of the plugin
#: nvoos-forge-bridge.php
msgid "https://nvdigitalsolutions.com"
msgstr ""

