{
    "name": "nvdigitalsolutions/nvoos-algorave",
    "description": "Live coding music studio for WordPress — Strudel and Tone.js audio engines, pattern library, MIDI export and audio visualizer. No API keys required.",
    "type": "wordpress-plugin",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "NV Digital Solutions",
            "email": "developer@nvdigitalsolutions.com",
            "homepage": "https://nvdigitalsolutions.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/nvdigitalsolutions/nvoos-algorave",
    "support": {
        "issues": "https://github.com/nvdigitalsolutions/nvoos-algorave/issues",
        "source": "https://github.com/nvdigitalsolutions/nvoos-algorave"
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "composer/installers": "^2.0",
        "phpunit/phpunit": "^9.0",
        "wp-phpunit/wp-phpunit": "*",
        "yoast/phpunit-polyfills": "^3.0",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:wpcs": "phpcs --standard=WordPress",
        "format": "phpcbf",
        "format:wpcs": "phpcbf --standard=WordPress"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.0"
        }
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    }
}
