<?xml version="1.0"?>
<ruleset name="NvoosContentGraphAi">
    <description>NV oOS Content Graph — AI WordPress Coding Standards</description>

    <!-- Use WordPress-Extra as the baseline. -->
    <rule ref="WordPress-Extra">
        <!-- PSR-4 autoloaded — file names match class names, not WP conventions. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- camelCase variables for modern PHP, consistent with class names. -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <!-- camelCase method names for modern PHP, consistent with PSR-4. -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
        <!-- Short ternaries are perfectly fine in modern PHP. -->
        <exclude name="Universal.Operators.DisallowShortTernary.Found"/>
    </rule>

    <!-- Require strict types. -->
    <rule ref="Generic.PHP.RequireStrictTypes"/>

    <!--
        Forward-slash hook names are intentional (matches the parent
        plugin's Schema constants, e.g. nvoos_content_graph/default_settings).
    -->
    <rule ref="WordPress.NamingConventions.ValidHookName">
        <severity>0</severity>
    </rule>

    <!--
        Reserved keyword parameter names ($default, $class) are idiomatic in PHP 8.1+.
    -->
    <rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
        <severity>0</severity>
    </rule>

    <!-- Scan only src/ and the bootstrap. -->
    <file>./nvoos-content-graph-ai.php</file>
    <file>./src/</file>
    <file>./tests/</file>

    <!-- Exclude vendor and build artifacts. -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>

    <!-- PHP 8.1+ floor (enforced by composer.json require.php). -->
</ruleset>
