<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="tests/bootstrap-ecosystem.php"
    colors="true"
    testdox="true"
    beStrictAboutOutputDuringTests="true"
>
    <testsuites>
        <testsuite name="NvoosContentGraphAiEcosystem">
            <directory suffix=".php">./tests/Ecosystem/</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">./src/Chat/</directory>
        </include>
    </coverage>
</phpunit>
