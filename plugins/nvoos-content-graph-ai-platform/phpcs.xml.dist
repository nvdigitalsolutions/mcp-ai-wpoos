<?xml version="1.0"?>
<ruleset name="NvoosContentGraphAiPlatform">
    <description>NV oOS Content Graph — AI Platform WordPress Coding Standards</description>

    <rule ref="WordPress-Extra">
        <!-- PSR-4 autoloaded — file names match class names, not WP conventions. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- camelCase variables for modern PHP, consistent with class names. -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <!-- camelCase method names for modern PHP, consistent with PSR-4. -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
        <!-- Short ternaries are perfectly fine in modern PHP. -->
        <exclude name="Universal.Operators.DisallowShortTernary.Found"/>
    </rule>

    <rule ref="Generic.PHP.RequireStrictTypes"/>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="NvoosContentGraphAiPlatform"/>
                <element value="nvoos_content_graph_ai_platform"/>
                <element value="NVOOS_CONTENT_GRAPH_AI_PLATFORM"/>
                <!--
                    Extraction transition: ported subsystems intentionally
                    keep firing the base plugin's public hook names
                    (wp_mcp_ai_*) so existing consumers keep working.
                    See docs/project/plans/content-graph-platform-extraction-plan.md
                    §3 principle 2. Remove once the base copies are deleted at
                    cutover (plan Phase 5).
                -->
                <element value="wp_mcp_ai"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="nvoos-content-graph-ai-platform"/>
            </property>
        </properties>
    </rule>

    <file>./nvoos-content-graph-ai-platform.php</file>
    <file>./src/</file>
    <file>./tests/</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>

    <config name="minimum_supported_wp_version" value="6.5"/>
    <config name="testVersion" value="8.1-"/>
</ruleset>
