msgid "Maximum number of nodes to return (1-20)."
msgstr ""

#: src/Tools/RetrieveContext.php:67
msgid "Use vector similarity search in addition to text search (requires embeddings to be indexed)."
msgstr ""

#: src/Tools/RetrieveContext.php:72
msgid "Include edges between the returned nodes."
msgstr ""

