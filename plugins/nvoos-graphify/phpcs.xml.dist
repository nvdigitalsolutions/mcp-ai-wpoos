<?xml version="1.0"?>
<ruleset name="NV oOS Graphify">
    <description>WordPress Coding Standards for NV oOS Graphify</description>

    <config name="text_domain" value="nvoos-graphify"/>
    <config name="minimum_wp_version" value="6.5"/>

    <file>src/</file>
    <file>tests/</file>
    <file>nvoos-graphify.php</file>
    <file>uninstall.php</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/assets/vendor/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>

    <!-- Base: WordPress-Extra -->
    <rule ref="WordPress-Extra"/>

    <!--
        PSR-4 architecture exemptions.
        This plugin uses PascalCase filenames, camelCase methods/variables,
        namespace-level docblocks instead of file-level @package,
        and namespaced classes without a global function prefix.
    -->
    <rule ref="WordPress.Files.FileName">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidFunctionName">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FileComment.Missing">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Commenting.DocComment.MissingShort">
        <severity>0</severity>
    </rule>

    <!--
        Interface implementations are documented in Contracts/; concrete
        tool and driver methods don't need redundant docblocks.
    -->
    <rule ref="Squiz.Commenting.FunctionComment.Missing">
        <exclude-pattern>*/src/Tools/*</exclude-pattern>
        <exclude-pattern>*/src/Remote/Drivers/*</exclude-pattern>
    </rule>

    <!--
        Graph engine exemptions.
        Direct database calls are intentional for custom table queries.
    -->
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <exclude-pattern>*/src/Graph/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>*/src/Graph/*</exclude-pattern>
        <exclude-pattern>*/src/Tools/ResolveExternal.php</exclude-pattern>
        <exclude-pattern>*/src/Admin/RemoteAdmin.php</exclude-pattern>
    </rule>

    <!--
        Forward-slash hook names are intentional (matches Schema constants).
    -->
    <rule ref="WordPress.NamingConventions.ValidHookName">
        <severity>0</severity>
    </rule>

    <!--
        Reserved keyword parameter names ($default, $class) are idiomatic in PHP 8.1+.
    -->
    <rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
        <severity>0</severity>
    </rule>

    <!--
        Short ternary (?:) is idiomatic PHP and used throughout the codebase.
    -->
    <rule ref="Universal.Operators.DisallowShortTernary">
        <severity>0</severity>
    </rule>

    <!--
        CSV driver uses native PHP fgetcsv for efficiency; WP_Filesystem is
        overly complex for local file parsing.
    -->
    <rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fopen">
        <exclude-pattern>*/src/Remote/Drivers/Csv.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fclose">
        <exclude-pattern>*/src/Remote/Drivers/Csv.php</exclude-pattern>
    </rule>

    <!--
        Test exemptions: global override and Yoda conditions are standard PHPUnit patterns.
    -->
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.YodaConditions">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <arg name="colors"/>
    <arg value="ps"/>
</ruleset>
