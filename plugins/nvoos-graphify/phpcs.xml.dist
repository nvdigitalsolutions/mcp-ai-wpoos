<?xml version="1.0"?>
<ruleset name="NV oOS Graphify">
    <description>WordPress Coding Standards for NV oOS Graphify</description>

    <file>src/</file>
    <file>tests/</file>
    <file>nvoos-graphify.php</file>
    <file>uninstall.php</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/assets/vendor/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>

    <!-- Base: WordPress-Extra -->
    <rule ref="WordPress-Extra"/>

    <!--
        PSR-4 architecture exemptions.
        This plugin uses PascalCase filenames, camelCase methods/variables,
        and namespaced classes without a global function prefix.
    -->
    <rule ref="WordPress.Files.FileName">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidFunctionName">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <severity>0</severity>
    </rule>

    <!--
        Graph engine exemptions.
        The Graph namespace contains the data access layer.
        Direct database calls are intentional for custom table queries.
    -->
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <exclude-pattern>*/src/Graph/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>*/src/Graph/*</exclude-pattern>
    </rule>

    <!--
        Forward-slash hook names are intentional (matches Schema constants).
    -->
    <rule ref="WordPress.NamingConventions.ValidHookName">
        <severity>0</severity>
    </rule>

    <!--
        Reserved keyword parameter names (e.g. $default, $class)
        are idiomatic in PHP 8.1+ code.
    -->
    <rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
        <severity>0</severity>
    </rule>

    <config name="minimum_wp_version" value="6.5"/>
    <arg name="colors"/>
    <arg value="ps"/>
</ruleset>
