# Files and directories to exclude from wp.org distribution.
# Only production PHP, assets, and documentation should ship.

# Development
/.git
/.gitignore
/.github
/node_modules
/composer.lock
/phpcs.xml.dist
/phpunit.xml.dist
/.phpunit.cache
/.phpunit.result.cache

# Tests
/tests

# Vendor (Composer dev dependencies)
/vendor/bin
/vendor/composer
/vendor/**/tests
/vendor/**/Tests
/vendor/**/test
/vendor/**/docs
/vendor/**/examples
/vendor/**/phpunit.xml*
/vendor/**/.gitignore
/vendor/**/.gitattributes

# Build artifacts
/bin
/build
/dist
/coverage

# IDE
/.idea
/.vscode
/*.sublime-*

# Docs (keep readme.txt only)
/docs
/README.md
/CONTRIBUTING.md
/CHANGELOG.md
/CREDITS.md

# Misc
*.log
.DS_Store
Thumbs.db
