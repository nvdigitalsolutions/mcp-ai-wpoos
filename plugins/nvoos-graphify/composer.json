{
    "name": "nvoos/graphify",
    "description": "Visual knowledge graph for WordPress — maps your content into an interactive, navigable graph. Zero API keys required.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "NV Digital Solutions",
            "email": "developer@nvdigitalsolutions.com",
            "homepage": "https://nvdigitalsolutions.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/nvdigitalsolutions/nvoos-graphify",
    "support": {
        "issues": "https://github.com/nvdigitalsolutions/nvoos-graphify/issues",
        "source": "https://github.com/nvdigitalsolutions/nvoos-graphify"
    },
    "require": {
        "php": "^8.1",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "wp-phpunit/wp-phpunit": "*",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "NvoosGraphify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NvoosGraphify\\Tests\\": "tests/"
        }
    }
}
