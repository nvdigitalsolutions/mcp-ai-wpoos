{
    "name": "nvoos/graphify",
    "description": "Visual knowledge graph for WordPress — maps your content into an interactive, navigable graph. Zero API keys required.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "NV Digital Solutions",
            "email": "developer@nvdigitalsolutions.com",
            "homepage": "https://nvdigitalsolutions.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/nvdigitalsolutions/nvoos-graphify",
    "support": {
        "issues": "https://github.com/nvdigitalsolutions/nvoos-graphify/issues",
        "source": "https://github.com/nvdigitalsolutions/nvoos-graphify"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "composer/installers": "^2.0",
        "phpunit/phpunit": "^9.0",
        "wp-phpunit/wp-phpunit": "*",
        "yoast/phpunit-polyfills": "^3.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "lint": "phpcs",
        "lint:wpcs": "phpcs --standard=WordPress",
        "format": "phpcbf",
        "format:wpcs": "phpcbf --standard=WordPress",
        "build:vendor": "npm install --production && node scripts/copy-vendor.js"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        }
    },
    "autoload": {
        "psr-4": {
            "NvoosGraphify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NvoosGraphify\\Tests\\": "tests/"
        }
    }
}
