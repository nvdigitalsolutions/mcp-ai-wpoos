<?xml version="1.0"?>
<ruleset name="NvoosContentGraphPro">
    <description>NV oOS Content Graph — Pro WordPress Coding Standards</description>

    <!-- Use WordPress-Extra as the baseline. -->
    <rule ref="WordPress-Extra">
        <!-- Short ternaries are perfectly fine in modern PHP. -->
        <exclude name="Universal.Operators.DisallowShortTernary.Found"/>
        <!--
            Mixed file conventions: the namespaced composition root and
            test seams use PSR-4-style file names (Plugin.php), while the
            ported Pro classes keep the base addon's WP_MCP_AI_* names
            inside class-wp-mcp-ai-*.php files (byte-identical surface).
            Same exclusion as the platform/AI addons.
        -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <!-- Require strict types. -->
    <rule ref="Generic.PHP.RequireStrictTypes"/>

    <!--
        Extraction transition: ported subsystems intentionally keep the
        base Pro addon's global WP_MCP_AI_* class and wp_mcp_ai_* hook
        names so the public surface stays byte-identical (see the plugin
        README §Porting rules). Remove once the base Pro copies are gone.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="NvoosContentGraphPro"/>
                <element value="nvoos_content_graph_pro"/>
                <element value="NVOOS_CONTENT_GRAPH_PRO"/>
                <element value="wp_mcp_ai"/>
                <element value="WP_MCP_AI"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="nvoos-content-graph-pro"/>
            </property>
        </properties>
    </rule>

    <!--
        Reserved keyword parameter names ($namespace, $default, $class) are
        idiomatic in PHP 8.1+ and byte-identical with the monolith copies.
    -->
    <rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
        <severity>0</severity>
    </rule>

    <!--
        Byte-identical base query shapes in the e-commerce analytics tools
        build the placeholder-less SQL strings inline (the base owns the
        same pattern monolith), so the prepare() replacement-count check
        is disabled for those copies.
    -->
    <rule ref="WordPress.DB.PreparedSQLPlaceholders.ReplacementsWrongNumber">
        <severity>0</severity>
    </rule>

    <!--
        Vault CPT custom capabilities: the item/folder CPT registrations
        map them via capability_type, so the Capabilities sniff must not
        flag them as unknown/typoed capabilities.
    -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            			<property name="custom_capabilities" type="array">
            				<element value="edit_own_vault_items"/>
            				<element value="edit_others_vault_items"/>
            				<element value="edit_own_vault_folders"/>
            				<element value="edit_others_vault_folders"/>
				<element value="edit_products"/>
				<element value="edit_shop_orders"/>
				<element value="view_order"/>
				<element value="manage_woocommerce"/>
				<element value="publish_products"/>
				<element value="delete_products"/>
				<element value="manage_product_terms"/>
				<element value="edit_product_terms"/>
				<element value="read_shop_order"/>
				<element value="edit_shop_order"/>
            			</property>
        </properties>
    </rule>

    <!--
        The ported vault encryption service encodes ciphertext/IV/auth-tag
        payloads with base64 — byte-identical with the monolith (the
        obfuscation sniff is a code-obfuscation heuristic, not a
        crypto-encoding ban).
    -->
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode"/>
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode"/>
    </rule>

    <!--
        Ported analytics tools query full CRM pipelines with high
        posts_per_page limits (500-1000) — byte-identical with the
        monolith copies.
    -->
    <rule ref="WordPress.WP.PostsPerPage">
        <severity>0</severity>
    </rule>

    <!--
        Byte-identical ported signatures keep unused handler parameters
        (ICP scorer dimension hooks, REST handler callbacks) — the
        monolith copies carry the same signatures.
    -->
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <severity>0</severity>
    </rule>

    <!--
        The byte-identical ICP admin page delegates its nonce checks to
        the action handlers (check_admin_referer inside handle_save/
        handle_delete/handle_set_default) — the dispatch reads in
        render_page() are guarded by those handlers.
    -->
    <rule ref="WordPress.Security.NonceVerification">
        <severity>0</severity>
    </rule>

    <!--
        The byte-identical ICP profile store omits translators comments
        on sprintf+__ error strings (same as the monolith copies).
    -->
    <rule ref="WordPress.WP.I18n.MissingTranslatorsComment">
        <severity>0</severity>
    </rule>

    <!--
        The byte-identical ICP admin page uses urlencode() for its
        redirect query strings (same as the monolith copy).
    -->
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.urlencode_urlencode"/>
    </rule>

    <file>./nvoos-content-graph-pro.php</file>
    <file>./src/</file>
    <file>./tests/</file>

    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>
    <!-- Byte-identical Node.js worker scripts copied from the base addon
         (generate-excel.js etc.) are not PHP/JS linted. -->
    <exclude-pattern>/scripts/*</exclude-pattern>

    <config name="minimum_supported_wp_version" value="6.5"/>
    <config name="testVersion" value="8.1-"/>
</ruleset>
