{
    "name": "nvoos/graphify-ai",
    "description": "AI chat assistant addon for NV oOS Graphify — chat, providers, AI tools, embeddings, and agent memory.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "NV Digital Solutions",
            "email": "developer@nvdigitalsolutions.com",
            "homepage": "https://nvdigitalsolutions.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/nvdigitalsolutions/nvoos-graphify-ai",
    "require": {
        "php": "^8.1",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "wp-phpunit/wp-phpunit": "*",
        "yoast/phpunit-polyfills": "^4.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "format": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "NvoosGraphifyAi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NvoosGraphifyAi\\Tests\\": "tests/"
        }
    }
}
