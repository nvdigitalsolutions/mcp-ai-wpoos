{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mcp-ai-wpoos/chat",
	"version": "1.0.0",
	"title": "AI Chat",
	"category": "mcp-ai-wpoos",
	"icon": "format-chat",
	"description": "Display an AI chat interface powered by NV oOS.",
	"keywords": [ "ai", "chat", "assistant", "conversation", "mcp" ],
	"textdomain": "wp-mcp-ai",
	"attributes": {
		"assistantId": {
			"type": "number",
			"default": 0
		},
		"allowGuests": {
			"type": "boolean",
			"default": false
		},
		"saveTranscript": {
			"type": "boolean",
			"default": true
		},
		"enableStreaming": {
			"type": "boolean",
			"default": true
		},
		"allowSensitiveTools": {
			"type": "boolean",
			"default": false
		},
		"showBuildButton": {
			"type": "boolean",
			"default": false
		},
		"placeholder": {
			"type": "string",
			"default": ""
		},
		"template": {
			"type": "string",
			"default": "classic",
			"enum": [ "classic", "speech-bubbles", "compact", "sidebar" ]
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"render": "file:./render.php"
}
