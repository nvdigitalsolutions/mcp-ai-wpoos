{
  "$schema": "https://nvoos.pro/schemas/media-model-catalog-1.json",
  "version": "1.1.0",
  "updated_at": "2026-11-11",
  "description": "Declarative capability registry for generative-media models exposed by NV oOS tools. Every value is transcribed from a constraint already declared in the corresponding tool (VIDEO_MODELS const, get_parameters_schema(), or IMAGE_MODELS const) and is kept in sync by tests/test-media-model-catalog.php. This file is authoritative for model SELECTION and PRE-FLIGHT VALIDATION only; each tool remains authoritative for the payload it submits.",
  "field_notes": {
    "empty_array": "An empty aspect_ratios / resolutions / batch_sizes array means the model exposes no such parameter. Validation drops the argument instead of forwarding it.",
    "duration.type": "Provider wire type for the duration field: 'number' (5) or 'string' (\"5\"). Some providers reject the wrong type with a 422.",
    "audio": "Describes the TOOL CASES control surface, not the model's output. 'none' = no audio argument exists; 'optional' = the tool can request audio / accept a reference track; 'fixed' = reserved for tools that always produce audio with no control.",
    "tier": "Advisory price/quality band used by the recommendation ranking. 'budget' candidates are excluded whenever a specific visual style is requested.",
    "max_reference_*": "Maximum number of reference assets the model accepts. 0 means the model takes none. A request exceeding this is excluded from recommendations rather than merely down-ranked.",
    "tools": "Optional list of every tool slug that can SELECT this model. Absent means 'just the owning tool'. Only set it when a model genuinely has more than one entry point — 'omni' is selectable through both generate_omni_video and generate_veo_video. The owning 'tool' field still decides which tool's capability unions the model contributes to."
  },
