{
    "name": "nvoos/laravel-adapter",
    "description": "Laravel adapter implementations for the oOS Core AI orchestration engine.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "nvoos/core": "^1.0",
        "illuminate/support": "^10.0 || ^11.0",
        "illuminate/cache": "^10.0 || ^11.0",
        "illuminate/config": "^10.0 || ^11.0",
        "illuminate/database": "^10.0 || ^11.0",
        "illuminate/events": "^10.0 || ^11.0",
        "illuminate/filesystem": "^10.0 || ^11.0",
        "illuminate/queue": "^10.0 || ^11.0",
        "illuminate/auth": "^10.0 || ^11.0",
        "illuminate/contracts": "^10.0 || ^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0 || ^9.0"
    },
    "autoload": {
        "psr-4": {
            "Nvoos\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvoos\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nvoos\\Laravel\\ServiceProvider\\NvoosServiceProvider"
            ]
        }
    },
    "repositories": [{
        "name": "oos-core",
        "type": "path",
        "url": "../core"
    }]
}
