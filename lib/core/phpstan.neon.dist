includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 8
    paths:
        - src/
    tmpDir: .phpstan-cache
    treatPhpDocTypesAsCertain: false

    # The scoped-database kernel (Proposal 167) ships in the Pro add-on, at
    # addons/pro/lib/database, because a base-only install has no addons/pro
    # and a base+pro install has no lib/ directory. `nvoos/core` must not take
    # a dependency on it, but src/Tool/Database type against its contracts, so
    # those symbols are indexed here without being autoloaded, analysed, or
    # required at runtime. Paths resolve relative to this file.
    scanDirectories:
        - ../../addons/pro/lib/database/src

    # Level 8 is the long-term target (ADR recommends it for the core package).
    # The historical blocker was ~251 "no value type specified in iterable type
    # array" errors from ToolInterface and provider contracts that used bare
    # `array` types because the WordPress adapter still supported PHP 7.4.
    #
    # That constraint is gone: the plugin floor is now PHP 8.1 (Proposal 133).
    # Retire the errors with `@phpstan-type` aliases (ToolContext, ToolArgs,
    # ProviderResponse) and `array<string, mixed>` on the remainder, then
    # promote to level 8 — see Proposal 134 (functional type signatures).
    #
    # State at 2026-11-27: **level 8 is configured and gated**, with 216 findings
    # carried by phpstan-baseline.neon. 91 are `missingType.iterableValue`, 62
    # `argument.type`, 19 `return.type`, 18 `method.nonObject`, 16
    # `offsetAccess.notFound`, and a tail of one-offs. The `.github/workflows/
    # phpstan-core.yml` job fails on any finding the baseline does not carry, so
    # the number can only go down: shrink the baseline as each file is touched,
    # and regenerate it deliberately rather than automatically.
    #
    # Proposal 164 section 164.112 records the triage that produced this state.
