includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: 8
    paths:
        - src/
    tmpDir: .phpstan-cache
    treatPhpDocTypesAsCertain: false

    # Level 8 is the long-term target (ADR recommends it for the core package).
    # The historical blocker was ~251 "no value type specified in iterable type
    # array" errors from ToolInterface and provider contracts that used bare
    # `array` types because the WordPress adapter still supported PHP 7.4.
    #
    # That constraint is gone: the plugin floor is now PHP 8.1 (Proposal 133).
    # Retire the errors with `@phpstan-type` aliases (ToolContext, ToolArgs,
    # ProviderResponse) and `array<string, mixed>` on the remainder, then
    # promote to level 8 — see Proposal 134 (functional type signatures).
    #
    # State at 2026-11-27: **level 8 is configured but not clean** — 216 findings
    # across 86 files. 91 are `missingType.iterableValue`, 62 `argument.type`,
    # 19 `return.type`, 18 `method.nonObject`, 16 `offsetAccess.notFound`, and a
    # tail of one-offs. No CI job enforces this file, so nothing prevents growth.
    # Proposal 164 section 164.112 records the triage and the recommended fix:
    # a committed baseline plus a CI job, not a hand cleanup of 216 annotations.
