{
    "name": "nvoos/craft-adapter",
    "description": "Craft CMS adapter implementations for the oOS Core AI orchestration engine.",
    "type": "craft-module",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "nvoos/core": "^1.0",
        "craftcms/cms": "^4.0 || ^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Nvoos\\Craft\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nvoos\\Craft\\Tests\\": "tests/"
        }
    },
    "extra": {
        "name": "oOS Core",
        "handle": "oos-core",
        "developer": "NV Digital Solutions",
        "documentationUrl": "https://github.com/nvdigitalsolutions/mcp-ai-wpoos"
    }
}
