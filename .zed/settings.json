        "context_servers": {}
      },

      // ─── Writers (with terminal) ─────────────────────────────────────────
      "tool-author": {
        "name": "NV oOS · Tool Author",
        "tools": {
          "read_file": true,
          "grep": true,
          "find_path": true,
          "list_directory": true,
          "edit_file": true,
          "create_directory": true,
          "move_path": true,
          "terminal": true,
          "thinking": true,
          "diagnostics": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      },
