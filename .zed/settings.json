  // ---------------------------------------------------------------------------
  // Recommended Zed extensions for NV oOS contributors.
  //
  // PHP / WordPress: phpactor language server, ESLint for the chat UI,
  // Prettier for JSON/Markdown. Mirrors .vscode/extensions.json intent.
  // ---------------------------------------------------------------------------
  "auto_install_extensions": {
    "php": true,
    "phpactor": true,
    "html": true,
    "scss": true
  }
}
