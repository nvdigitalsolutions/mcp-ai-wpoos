# ───────────────────────────────────────────────────────────
# NV oOS — Demo Video Pipeline: Environment Variables
# ───────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — your secrets will never be committed.
# ───────────────────────────────────────────────────────────

# ── WordPress Admin ──────────────────────────────────────
# Credentials for Playwright to log into wp-admin.
# These match the Docker Compose defaults.
WP_ADMIN_USER=admin
WP_ADMIN_PASS=password

# ── AI Provider (at least one required for chat videos) ──
# OpenAI — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Google Gemini — get from https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# Ollama — local server URL (default http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# ── TTS Narration (Phase 3, optional) ────────────────────
# ElevenLabs — get from https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=...

# TTS provider: openai (default) or elevenlabs
# TTS_PROVIDER=openai

# OpenAI voice: alloy, echo, fable, onyx, nova (default), shimmer
# TTS_VOICE=nova

# ElevenLabs voice ID (default: Rachel)
# TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Silence gap between narration segments (milliseconds)
# GAP_MS=500

# ── Docker ───────────────────────────────────────────────
BASE_URL=http://localhost:8000

# ── Pro Videos ───────────────────────────────────────────
# Set to "false" to skip Pro plugin videos
CAPTURE_PRO=true
