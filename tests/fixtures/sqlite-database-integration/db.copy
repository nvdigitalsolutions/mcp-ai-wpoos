<?php
/**
 * Drop-in to activate SQLite as the WordPress database layer.
 *
 * Copy this file to wp-content/db.php. No manual editing required.
 *
 * Resolution order for the SQLite implementation:
 *   1. Bundled fixture     – tests/fixtures/sqlite-database-integration/
 *   2. Studio mu-plugin     – wp-content/mu-plugins/sqlite-database-integration/
 *   3. Performance Lab plugin – wp-content/plugins/sqlite-database-integration/
 *
 * WordPress Studio sites use SQLite via an internal playground mu-plugin.
 * This drop-in defines SQLITE_MAIN_FILE to satisfy that plugin. For CLI
 * test runs, the drop-in activates the bundled fixture's driver so tests
 * get their own SQLite database without touching the production site's DB.
 *
 * @package wp-sqlite-integration
 */

define( 'SQLITE_DB_DROPIN_VERSION', '1.8.0' );

// Required by WordPress Studio's internal playground mu-plugin.
// Without this, the site fatals on wp_loaded.
if ( ! defined( 'SQLITE_MAIN_FILE' ) ) {
	define( 'SQLITE_MAIN_FILE', __FILE__ );
}

/**
 * Resolve the SQLite implementation path.
 *
 * Tries the bundled fixture first (best for test isolation), then falls
 * back to the Studio mu-plugin path, then the standard plugin directory.
 */
$sqlite_plugin_implementation_folder_path = '';

// 1. Bundled fixture (always available for test runs).
$fixture = __DIR__ . '/plugins/mcp-ai-wpoos/tests/fixtures/sqlite-database-integration';
if ( file_exists( $fixture . '/wp-includes/sqlite/db.php' ) ) {
	$sqlite_plugin_implementation_folder_path = $fixture;
}

// 2. WordPress Studio mu-plugin.
if ( ! $sqlite_plugin_implementation_folder_path ) {
	$studio = realpath( __DIR__ . '/mu-plugins/sqlite-database-integration' );
	if ( $studio && file_exists( $studio . '/wp-includes/sqlite/db.php' ) ) {
		$sqlite_plugin_implementation_folder_path = $studio;
	}
}

// 3. Standard Performance Lab plugin.
if ( ! $sqlite_plugin_implementation_folder_path ) {
	$plugin = realpath( __DIR__ . '/plugins/sqlite-database-integration' );
	if ( $plugin && file_exists( $plugin . '/wp-includes/sqlite/db.php' ) ) {
		$sqlite_plugin_implementation_folder_path = $plugin;
	}
}

// Bail early if no SQLite implementation was found.
if ( ! $sqlite_plugin_implementation_folder_path ) {
	return;
}

// Constant for backward compatibility.
if ( ! defined( 'DATABASE_TYPE' ) ) {
	define( 'DATABASE_TYPE', 'sqlite' );
}
if ( ! defined( 'DB_ENGINE' ) ) {
	define( 'DB_ENGINE', 'sqlite' );
}

// Load the SQLite database driver.
require_once $sqlite_plugin_implementation_folder_path . '/wp-includes/sqlite/db.php';
