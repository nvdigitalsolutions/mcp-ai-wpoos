    "cases": [
        {
            "name": "get-concept",
            "op": "get_concept",
            "args": {
                "concept_id": "tables/orders"
            },
            "expected": {
                "concept_id": "tables/orders",
                "frontmatter": {
                    "type": "Table",
                    "title": "Orders",
                    "description": "Order records",
                    "tags": [
                        "sales",
                        "core"
                    ]
                },
                "body": "# Orders\n\nOrder rows."
            }
        },
        {
            "name": "get-concept-strips-md-suffix",
            "op": "get_concept",
            "args": {
                "concept_id": "tables/orders.md"
            },
            "expected": {
                "concept_id": "tables/orders",
                "frontmatter": {
                    "type": "Table",
                    "title": "Orders",
                    "description": "Order records",
                    "tags": [
                        "sales",
                        "core"
                    ]
                },
                "body": "# Orders\n\nOrder rows."
            }
        },
        {
            "name": "get-concept-nested",
            "op": "get_concept",
            "args": {
                "concept_id": "guides/getting-started"
            },
            "expected": {
                "concept_id": "guides/getting-started",
                "frontmatter": {
                    "type": "Guide",
                    "title": "Getting Started",
                    "description": "First steps"
                },
                "body": "Start with [Orders](/tables/orders.md)."
            }
        },
        {
            "name": "get-concept-missing",
            "op": "get_concept",
            "args": {
                "concept_id": "does/not/exist"
            },
            "expected": {
                "error": "okf_not_found"
            }
        },
        {
            "name": "get-concept-dotdot-outside-root",
            "op": "get_concept",
            "args": {
                "concept_id": "../outside"
            },
            "expected": {
                "error": "okf_not_found"
            }
        },
        {
            "name": "get-concept-unclosed-frontmatter",
            "op": "get_concept",
            "args": {
                "concept_id": "broken"
            },
            "expected": {
                "error": "okf_unclosed_frontmatter"
            }
        },
        {
            "name": "get-concept-no-frontmatter",
            "op": "get_concept",
            "args": {
                "concept_id": "orphan"
            },
            "expected": {
                "error": "okf_no_frontmatter"
            }
        },
        {
            "name": "browse-root-uses-index",
            "op": "browse",
            "args": {
                "path": ""
            },
            "expected": [
                {
                    "title": "Tables",
                    "path": "tables/index.md",
                    "description": "Table concepts"
                },
                {
                    "title": "Guides",
                    "path": "guides/getting-started.md",
                    "description": "How to start"
                }
            ]
        },
        {
            "name": "browse-subdirectory-uses-index",
            "op": "browse",
            "args": {
                "path": "tables"
            },
            "expected": [
                {
                    "title": "Orders",
                    "path": "orders.md",
                    "description": "Order records"
                },
                {
                    "title": "Customers",
                    "path": "customers.md",
                    "description": "Customer records"
                }
            ]
        },
        {
            "name": "browse-falls-back-to-scan",
            "op": "browse",
            "args": {
                "path": "guides"
            },
            "expected": [
                {
                    "title": "Getting Started",
                    "path": "guides/getting-started.md",
                    "description": "First steps"
                }
            ]
        },
        {
            "name": "browse-missing-directory",
            "op": "browse",
            "args": {
                "path": "nope"
            },
