            "expected": [
                {
                    "concept_id": "hub",
                    "target": "missing.md",
                    "resolved": "missing"
                }
            ]
        },
        {
            "name": "broken-links-empty-when-all-resolve",
            "op": "find_broken_links",
            "args": {
                "concept_id": "alpha"
            },
            "expected": []
        },
        {
            "name": "broken-links-unknown-concept",
            "op": "find_broken_links",
            "args": {
                "concept_id": "ghost"
            },
            "expected": []
        },
        {
            "name": "traverse-follows-relative-and-absolute",
            "op": "traverse",
            "args": {
                "concept_id": "hub",
                "max_depth": 2
            },
            "expected": {
                "concept_id": "hub",
                "frontmatter": {
                    "type": "Index",
