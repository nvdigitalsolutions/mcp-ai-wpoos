                    },
                    {
                        "concept_id": "beta",
                        "frontmatter": {
                            "type": "Concept",
                            "title": "Beta"
                        },
                        "body": "No outgoing links.",
                        "links": []
                    },
                    {
                        "concept_id": "top",
