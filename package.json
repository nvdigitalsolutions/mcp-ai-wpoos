{
	"name": "mcp-ai-wpoos",
	"version": "1.1.23",
	"description": "NV Digital Open Operator System (oOS) - WordPress plugin integrating MCP tools with AI workflows",
	"private": true,
	"scripts": {
		"lint:js": "eslint 'assets/js/**/*.js' 'src/**/*.{js,jsx}'",
		"lint:js:fix": "eslint 'assets/js/**/*.js' 'src/**/*.{js,jsx}' --fix",
		"lint:ts": "eslint 'assets/js/src/**/*.{ts,tsx}'",
		"lint:ts:fix": "eslint 'assets/js/src/**/*.{ts,tsx}' --fix",
		"lint:all": "npm run lint:js && npm run lint:ts",
		"typecheck": "tsc --noEmit",
		"typecheck:watch": "tsc --noEmit --watch",
		"pretest": "node -e \"try { require.resolve('jest'); } catch(e) { console.log('\\n⚠️  Jest not found. Run \\\"npm install\\\" to install dev dependencies for testing.\\nℹ️  Tests are optional for production use - the plugin works without them.\\n'); process.exit(0); }\"",
		"test": "jest || exit 0",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:verbose": "jest --verbose",
		"build:css": "node cleancss.config.js",
		"build:js": "node esbuild.config.js",
		"build:js:ts": "node esbuild.config.js --ts-only",
		"build:js:legacy": "npm run minify:js:legacy",
		"build:js:pro": "node esbuild.config.pro.js",
		"env:start": "wp-env start",
		"env:start:xdebug": "wp-env start --xdebug",
		"env:start:playground": "wp-env start --runtime=playground",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:reset": "wp-env reset all && wp-env start",
		"env:status": "wp-env status",
		"env:logs": "wp-env logs",
		"env:cli": "wp-env run cli wp",
		"env:shell": "wp-env run cli bash",
		"env:composer": "wp-env run cli --env-cwd=wp-content/plugins/wp-mcp-ai composer",
		"env:phpunit": "wp-env run cli --env-cwd=wp-content/plugins/wp-mcp-ai phpunit",
		"env:test:start": "wp-env start --config=.wp-env.test.json",
		"env:test:phpunit": "wp-env start --config=.wp-env.test.json && wp-env run --config=.wp-env.test.json cli --env-cwd=wp-content/plugins/wp-mcp-ai phpunit",
		"build:workflow": "wp-scripts build --config webpack.config.workflow.js",
		"start:workflow": "wp-scripts start --config webpack.config.workflow.js",
		"build:tma": "wp-scripts build --config webpack.config.tma.js",
		"build:tma-builder": "ENTRY=tma-template-builder wp-scripts build --config webpack.config.tma.js",
		"start:tma-builder": "ENTRY=tma-template-builder wp-scripts start --config webpack.config.tma.js",
		"build:tma-woo-shop": "ENTRY=tma-woo-shop wp-scripts build --config webpack.config.tma.js",
		"start:tma-woo-shop": "ENTRY=tma-woo-shop wp-scripts start --config webpack.config.tma.js",
		"build:tma-shopify-jewelry": "ENTRY=tma-shopify-jewelry wp-scripts build --config webpack.config.tma.js",
		"start:tma-shopify-jewelry": "ENTRY=tma-shopify-jewelry wp-scripts start --config webpack.config.tma.js",
		"build:tma-shopify-shop": "ENTRY=tma-shopify-shop wp-scripts build --config webpack.config.tma.js",
		"start:tma-shopify-shop": "ENTRY=tma-shopify-shop wp-scripts start --config webpack.config.tma.js",
		"cosmos:tma": "cosmos --config cosmos.config.json",
		"cosmos:tma:export": "cosmos-export --config cosmos.config.json",
		"build:docs-hub": "cd addons/docs-hub && node esbuild.config.js --prod",
		"build": "npm run build:css && npm run build:js && npm run build:js:pro && npm run build:docs-hub || true",
		"build:full": "npm run build:css && npm run build:js && npm run build:js:pro && npm run build:workflow && npm run build:tma",
		"build:zip": "./bin/build-plugin-zip.sh",
		"build:zip:base": "./bin/build-plugin-zip.sh --base",
		"build:zip:pro": "./bin/build-plugin-zip.sh --pro",
		"build:zip:combined": "./bin/build-plugin-zip.sh --combined",
		"rebuild:all": "./bin/rebuild-all-zips.sh",
		"minify:css": "node cleancss.config.js --base",
		"minify:css:pro": "node cleancss.config.js --pro",
		"minify:js:legacy": "uglifyjs assets/js/admin-settings.js -o assets/js/admin-settings.min.js -c -m && uglifyjs assets/js/chat.js -o assets/js/chat.min.js -c -m && uglifyjs assets/js/settings-dashboard.js -o assets/js/settings-dashboard.min.js -c -m && uglifyjs assets/js/user-chats.js -o assets/js/user-chats.min.js -c -m && uglifyjs assets/js/auth0-setup.js -o assets/js/auth0-setup.min.js -c -m && uglifyjs assets/js/mcp-diagnostic.js -o assets/js/mcp-diagnostic.min.js -c -m && uglifyjs assets/js/performance-blocks.js -o assets/js/performance-blocks.min.js -c -m",
		"watch:css": "npm run minify:css -- --watch",
		"watch:js": "npm run minify:js -- --watch",
		"postinstall": "(cd addons/pro && npm install --legacy-peer-deps --omit=optional --no-optional) || echo 'Pro addon install failed, continuing...' && npm run install:chartjs && npm run install:vectorizer && npm run install:vectorizer:fix && npm run build:js:pro || true",
		"install:chartjs": "cp node_modules/chart.js/dist/chart.umd.min.js assets/js/vendor/chart.min.js",
		"install:vectorizer": "rm -rf assets/js/vendor/neplex-vectorizer && mkdir -p assets/js/vendor/neplex-vectorizer && cp -r node_modules/@neplex/vectorizer* assets/js/vendor/neplex-vectorizer/",
		"install:vectorizer:fix": "find assets/js/vendor/neplex-vectorizer -maxdepth 2 -name '*.node' -type f -exec sh -c 'cp \"$1\" assets/js/vendor/neplex-vectorizer/vectorizer/' _ {} \\;"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.1.0",
		"@dnd-kit/sortable": "^8.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@microsoft/fetch-event-source": "^2.0.1",
		"@mlc-ai/web-llm": "^0.2.80",
		"@neplex/vectorizer": "^0.0.5",
		"chart.js": "^4.4.7",
		"dompurify": "^3.4.0",
		"ky": "^1.14.0",
		"marked": "^9.1.6",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-error-boundary": "^6.0.0",
		"reactflow": "^11.10.4",
		"zustand": "^4.5.6"
	},
	"optionalDependencies": {
		"@langchain/community": "^1.1.0",
		"@langchain/core": "^1.1.8",
		"langchain": "^1.2.3"
	},
	"devDependencies": {
		"@babel/core": "^7.28.5",
		"@babel/preset-env": "^7.28.5",
		"@babel/preset-react": "^7.28.5",
		"@babel/preset-typescript": "^7.28.5",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@types/jest": "^30.0.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"@wordpress/components": "^27.0.0",
		"@wordpress/data": "^9.0.0",
		"@wordpress/element": "^5.0.0",
		"@wordpress/env": "^11.6.0",
		"@wordpress/eslint-plugin": "^23.0.0",
		"@wordpress/hooks": "^3.0.0",
		"@wordpress/i18n": "^4.0.0",
		"@wordpress/scripts": "^31.4.0",
		"@axe-core/react": "^4.10.2",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"ajv": "^8.17.1",
		"babel-jest": "^30.2.0",
		"babel-loader": "^9.2.1",
		"clean-css": "^5.3.3",
		"clean-css-cli": "^5.6.3",
		"css-loader": "^7.1.2",
		"esbuild": "^0.27.0",
		"eslint": "^8.57.1",
		"events": "^3.3.0",
		"jest": "^30.2.0",
		"jest-environment-jsdom": "^30.2.0",
		"react-cosmos": "^7.2.0",
		"react-cosmos-plugin-webpack": "^7.2.0",
		"style-loader": "^4.0.0",
		"ts-jest": "^29.3.0",
		"typescript": "^5.8.0",
		"uglify-js": "^3.17.4"
	},
	"overrides": {
		"qs": ">=6.15.2",
		"yauzl": ">=3.2.1",
		"path-to-regexp": ">=0.1.13",
		"tmp": ">=0.2.6",
		"webpack-dev-server": ">=5.2.4",
		"langsmith": ">=0.6.0",
		"basic-ftp": ">=6.0.1",
		"axios": ">=1.16.0",
		"ip-address": ">=10.2.0",
		"zustand": "^4.5.6",
		"minimatch@^3": "3.1.5",
		"minimatch@^5": "5.1.9",
		"minimatch@^9": "9.0.9",
		"serialize-javascript": ">=7.0.5",
		"undici": ">=7.24.0",
		"flatted": ">=3.4.2",
		"picomatch@^2": "2.3.2",
		"picomatch@^4": "4.0.4",
		"yaml@^1": "1.10.3",
		"handlebars": ">=4.7.9",
		"brace-expansion@^1": "1.1.13",
		"brace-expansion@^2": "2.0.3",
		"lodash": ">=4.18.1",
		"lodash-es": ">=4.18.1",
		"uuid": ">=14.0.0",
		"fast-uri": ">=3.1.2",
		"@babel/plugin-transform-modules-systemjs": ">=7.29.4"
	},
	"engines": {
		"node": ">=18.17.0",
		"npm": ">=9.0.0"
	},
	"keywords": [
