# Intuit app credentials — developer.intuit.com → your app → Keys & Credentials.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Company (realm) ID and the refresh token from a completed sign-in.
QBO_REFRESH_TOKEN=
QBO_REALM_ID=193514562011054

# sandbox | production — must match where the refresh token was issued.
QBO_ENVIRONMENT=production

# Bearer token this server accepts from callers.
# Generate with: openssl rand -hex 32
QBO_MCP_TOKEN=

# Where the rotated refresh token is persisted. Must be writable and durable.
QBO_STATE_FILE=.qbo-state.json

PORT=8787
