{
	"version": 1,
	"presets": [
		{
			"id": "blog",
			"bestFor": "Editorial sites: a blog with pages, search and feeds.",
			"detect": [
				"posts outnumber products",
				"no wc/v3 namespace advertised"
			],
			"render": "static",
			"kinds": [
				"hero",
				"feature-grid",
				"icon-list",
				"testimonial",
				"cta",
				"text",
				"form"
			],
			"surfaces": [
				"search",
				"feed",
				"sitemap"
			]
		},
		{
			"id": "storefront",
			"bestFor": "WooCommerce catalogues and product marketing.",
			"detect": [
				"wc/v3 advertised",
				"product post type present"
			],
			"render": "static",
			"kinds": [
				"hero",
				"pricing",
				"feature-grid",
				"gallery",
				"stats",
				"comparison",
				"testimonial",
				"cta",
				"model-3d"
			],
			"surfaces": [
				"search",
				"feed",
				"sitemap"
			]
		},
		{
			"id": "portfolio",
			"bestFor": "Creative work: a project/case-study catalogue with an optional journal.",
			"detect": [
				"a portfolio/projects/case-study CPT is advertised",
				"no wc/v3 namespace advertised"
			],
			"render": "static",
			"kinds": [
				"hero",
				"gallery",
				"feature-grid",
				"stats",
				"testimonial",
				"steps",
				"comparison",
				"cta"
			],
			"surfaces": [
				"search",
				"sitemap"
			]
		},
		{
			"id": "landing",
			"bestFor": "A single marketing page: hero, proof, and one call to action.",
			"detect": [
				"one-page source with no blog or catalogue",
				"a single conversion goal"
			],
			"render": "static",
			"kinds": [
				"hero",
				"feature-grid",
				"icon-list",
				"stats",
				"testimonial",
				"pricing",
				"accordion",
				"cta"
			],
			"surfaces": [
				"sitemap"
			]
		},
		{
			"id": "docs",
			"bestFor": "Documentation: a page hierarchy read in order, with search.",
			"detect": [
				"many nested pages",
				"no products",
				"no dated posts"
			],
			"render": "static",
			"kinds": [
				"hero",
				"text",
				"steps",
				"accordion",
				"comparison",
				"content"
			],
			"surfaces": [
				"search",
				"sitemap"
			]
		},
		{
			"id": "minimal",
			"bestFor": "The smallest useful site: posts and pages, no search surface.",
			"detect": [
				"few pages",
				"no products",
				"no search requirement"
			],
			"render": "static",
			"kinds": [
				"hero",
				"text",
				"feature-grid",
				"cta"
			],
			"surfaces": [
				"feed",
				"sitemap"
			]
		}
	]
}
