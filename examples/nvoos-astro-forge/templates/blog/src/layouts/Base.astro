---
import '../styles/global.css';
import manifest from '../../nvoos.json';
import { useCopy } from '../copy/index.ts';
import ThemeToggle from '../components/ThemeToggle.astro';
import { generatedPolicy } from '../lib/theme/policy.generated.ts';
import { chrome } from '../lib/chrome.generated.ts';
import { behaviors } from '../lib/behaviors.generated.ts';

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
}

const { title, description, canonical, ogImage } = Astro.props;
const copy = useCopy();
const siteTitle = manifest.name ?? 'Forge';
const fullTitle = title === 'Home' ? siteTitle : `${title} — ${siteTitle}`;
const pageUrl = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined);
const hasSearch = manifest.surfaces?.search !== false;
const hasFeed = manifest.surfaces?.feed !== false;
// The baked policy rides to the client as inert JSON (Proposal 105 §4) —
// the boot script and the theme toggle both read this node.
const policyJson = JSON.stringify(generatedPolicy).replace(/</g, '\\u003c');
// The chrome typography/shape facts (Proposal 123) ride as CSS custom
// properties on <body> — global.css reads them with template-default
// fallbacks, so sites without the facts keep the default chrome.
const chromeVars = [
	chrome?.chromeSize && `--forge-chrome-size:${chrome.chromeSize}`,
	chrome?.headerBg && `--forge-header-bg:${chrome.headerBg}`,
	chrome?.headerInk && `--forge-header-ink:${chrome.headerInk}`,
	chrome?.topbarBg && `--forge-topbar-bg:${chrome.topbarBg}`,
	chrome?.topbarInk && `--forge-topbar-ink:${chrome.topbarInk}`,
	chrome?.navStyle?.transform && `--forge-nav-transform:${chrome.navStyle.transform}`,
	chrome?.navStyle?.weight && `--forge-nav-weight:${chrome.navStyle.weight}`,
	chrome?.navStyle?.size && `--forge-nav-size:${chrome.navStyle.size}`,
	chrome?.navStyle?.letterSpacing && `--forge-nav-letter-spacing:${chrome.navStyle.letterSpacing}`,
	chrome?.call?.style?.padding && `--forge-call-pad:${chrome.call.style.padding}`,
	chrome?.call?.style?.radius && `--forge-call-radius:${chrome.call.style.radius}`,
	chrome?.call?.style?.weight && `--forge-call-weight:${chrome.call.style.weight}`,
	chrome?.call?.style?.transform && `--forge-call-transform:${chrome.call.style.transform}`,
	chrome?.call?.style?.size && `--forge-call-size:${chrome.call.style.size}`,
	chrome?.footerHeadingStyle?.weight && `--forge-footer-heading-weight:${chrome.footerHeadingStyle.weight}`,
	chrome?.footerHeadingStyle?.size && `--forge-footer-heading-size:${chrome.footerHeadingStyle.size}`,
	chrome?.footerHeadingStyle?.transform && `--forge-footer-heading-transform:${chrome.footerHeadingStyle.transform}`,
	chrome?.footerBarBg && `--forge-footer-bar-bg:${chrome.footerBarBg}`,
	chrome?.footerBarInk && `--forge-footer-bar-ink:${chrome.footerBarInk}`,
	chrome?.footerBg && `--forge-footer-bg:${chrome.footerBg}`,
]
	.filter(Boolean)
	.join(';');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content="NV oOS Astro Forge" />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		{pageUrl && <link rel="canonical" href={pageUrl} />}
		{hasFeed && <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/feed.xml" />}
		{chrome?.favicon && <link rel="icon" href={chrome.favicon} />}
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta name="robots" content="index, follow" />
		<script id="forge-theme-policy" type="application/json" data-theme-policy is:inline set:html={policyJson}></script>
		<script is:inline>
			// Proposal 105 §4 no-FOUC policy boot: policy first, storage second.
			// Forced light/dark/brand skip the stored preference entirely; the
			// auto ladder runs stored → media → defaultTheme. Mirrors
			// src/lib/theme/policy.ts (keep the two ladders in sync).
			(function () {
				var KEY = 'nvoos-theme';
				var CKEY = 'nvoos-contrast';
				// The forge registry: 'light' is implicit, 'dark' is the only
				// named theme today — brand slugs therefore fail open to auto.
				var REGISTRY = ['dark'];
				var node = document.getElementById('forge-theme-policy');
				var doc = null;
				try {
					doc = JSON.parse(node ? node.textContent : 'null');
				} catch (error) {
					doc = null;
				}
				if (!doc || typeof doc !== 'object') {
					doc = {};
				}
				var policy = typeof doc.policy === 'string' ? doc.policy : 'auto';
				var contrast = typeof doc.contrast === 'string' ? doc.contrast : 'auto';
				var defaultTheme = doc.defaultTheme === 'light' ? 'light' : 'dark';

				var stored = function (key) {
					try {
						return localStorage.getItem(key);
					} catch (error) {
						return null;
					}
				};

				var theme = null;
				var forced = false;
				if (policy.indexOf('brand:') === 0) {
					var slug = policy.slice(6);
					if (REGISTRY.indexOf(slug) !== -1) {
						theme = slug;
						forced = true;
					}
				}
				if (!forced && (policy === 'light' || policy === 'dark')) {
					theme = policy;
					forced = true;
				}
				if (!forced) {
					var saved = stored(KEY);
					if (saved && (saved === 'light' || REGISTRY.indexOf(saved) !== -1)) {
						theme = saved;
					} else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
						theme = 'light';
					} else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
						theme = 'dark';
					} else {
						theme = defaultTheme;
					}
				}

				var mode = 'standard';
				if (contrast === 'high' || contrast === 'standard') {
					mode = contrast;
				} else if (stored(CKEY) === 'high') {
					mode = 'high';
				}

				var apply = function () {
					var root = document.documentElement;
					if (theme === 'light') {
						root.removeAttribute('data-theme');
					} else if (theme) {
						root.setAttribute('data-theme', theme);
					}
					root.style.colorScheme = theme === 'dark' ? 'dark' : 'light';
					if (mode === 'high') {
						root.setAttribute('data-contrast', 'high');
					} else {
						root.removeAttribute('data-contrast');
					}
				};
				// Forced mode never writes storage — the policy owns the theme.
				apply();
				// The document survives the swap; the element does not.
				document.addEventListener('astro:after-swap', apply);
			})();
		</script>
	</head>
	<body style={chromeVars || undefined}>
		{chrome?.topbar && chrome.topbar.length > 0 && (
			<div class="site-topbar">
				{chrome.topbar.map((line) => (
					<p>{line}</p>
				))}
			</div>
		)}
		<header class:list={['site-header', behaviors.headerSticky && 'site-header--sticky', chrome?.headerBg && 'site-header--themed']}>
			<div class="brand-block">
				<a class="brand" href="/">
					{chrome?.logo?.src ? <img class="brand-logo" src={chrome.logo.src} alt={chrome.logo.alt ?? siteTitle} /> : siteTitle}
				</a>
				{chrome?.tagline && <p class="brand-tagline">{chrome.tagline}</p>}
			</div>
			<nav aria-label={copy.nav.primaryLabel}>
				{chrome?.nav && chrome.nav.length > 0 ? (
					chrome.nav.map((item) => (
						<a href={item.href}>{item.label}</a>
					))
				) : (
					<>
						<a href="/">{copy.nav.home}</a>
						{manifest.collections.some((collection) => collection.slug === 'products') && <a href="/products/">{copy.nav.products}</a>}
						<a href="/posts/">{copy.nav.posts}</a>
						{hasSearch && <a href="/search/">{copy.nav.search}</a>}
					</>
				)}
			</nav>
			<div class="header-actions">
				{chrome?.call && (
					<a class="call-button" href={chrome.call.href} style={chrome.call.bg ? `background:${chrome.call.bg};color:${chrome.call.ink ?? '#ffffff'};` : undefined}>
						{chrome.call.label}
					</a>
				)}
				<ThemeToggle />
			</div>
		</header>
		<main class="site-main">
			<slot />
		</main>
		<footer class:list={['site-footer', (chrome?.footerBg || chrome?.footerBarBg) && 'site-footer--themed']}>
			<div class="site-footer-sub">
				<div class="site-footer-sub-inner">
					{chrome?.footerLogo?.src && (
						<div class="site-footer-logo">
							<img src={chrome.footerLogo.src} alt={chrome.footerLogo.alt ?? siteTitle} />
						</div>
					)}
					{chrome?.footerBlocks && chrome.footerBlocks.length > 0 && (
						<div class="site-footer-blocks">
							{chrome.footerBlocks.map((block) => (
								<div class="site-footer-block">
									{block.title && <h3>{block.title}</h3>}
									{block.items.map((item) => (
										<p>{item}</p>
									))}
								</div>
							))}
						</div>
					)}
				</div>
			</div>
			<div class="site-footer-bar">
				<div class="site-footer-bar-inner">
					{chrome?.copyright ? (
						<>
							<p class="site-copyright">{chrome.copyright}</p>
							<p class="site-credit">{copy.footer.generatedBy}</p>
						</>
					) : (
						<p>{copy.footer.generatedBy}</p>
					)}
				</div>
			</div>
		</footer>
	</body>
</html>
