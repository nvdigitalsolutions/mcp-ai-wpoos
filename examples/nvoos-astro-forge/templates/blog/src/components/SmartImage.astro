---
// SmartImage — optimize WordPress media with Astro Image (responsive
// WebP/AVIF, lazy), and pass through anything else (CDN hosts, external
// domains) as a plain <img>. The authorization gate mirrors `image.domains`
// in astro.config.mjs (see src/lib/media.ts) and repairs a stale absolute
// media URL to the configured CMS origin first — a site that moved domains
// keeps its optimized images instead of falling back to a dead hotlink.
import { Image } from 'astro:assets';
import { isAuthorizedImageUrl, repairMediaUrl } from '../lib/media.ts';

interface Props {
	src?: string;
	alt?: string;
	class?: string;
	sizes?: string;
	/** Eager for above-the-fold media (the LCP image); everything else
	 *  stays lazy — the responsive-image default (web.dev). */
	eager?: boolean;
}

const { src, alt = '', class: className, sizes, eager = false } = Astro.props;

// Repair before the gate: a `/wp-content/…` URL on a stale host is still the
// CMS's media, and pointing it at the live origin lets Astro download it.
const resolvedSrc = repairMediaUrl(src);
// Narrowed through a local so the <Image> branch always sees a string.
const optimizedSrc = isAuthorizedImageUrl(resolvedSrc) ? resolvedSrc : undefined;
---

{optimizedSrc ? (
	<Image
		src={optimizedSrc}
		alt={alt}
		class={className}
		widths={[480, 768, 1200]}
		sizes={sizes ?? '100vw'}
		inferSize
		loading={eager ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : 'auto'}
		decoding="async"
	/>
) : (
	<img src={resolvedSrc} alt={alt} class={className} loading={eager ? 'eager' : 'lazy'} decoding="async" />
)}
