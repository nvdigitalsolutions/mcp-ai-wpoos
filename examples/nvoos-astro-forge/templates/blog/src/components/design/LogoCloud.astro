---
// LogoCloud — a wall of brand/logo images (image-carousel/brand sections).
// The source sections often carry a heading and a CTA next to the logos —
// they render too, never dropped.
import type { SemanticSection } from '../../forge/semantic.ts';

interface Props {
	section: SemanticSection;
}

const { section } = Astro.props;
const { title, media, links } = section.slots;
---

{(media && media.length > 0) && (
	<section class="ds-section ds-body">
		{title && <h2 class="ds-title">{title}</h2>}
		<div class="ds-logos" aria-label="Featured brands">
			{media.map((image) => (
				<img src={image.src} alt={image.alt ?? ''} width="240" height="120" loading="lazy" />
			))}
		</div>
		{links && links.length > 0 && (
			<div class="ds-links">
				{links.map((link) => (
					<a class="ds-button" href={link.href ?? '#'}>
						{link.text ?? 'Learn more'}
					</a>
				))}
			</div>
		)}
	</section>
)}
