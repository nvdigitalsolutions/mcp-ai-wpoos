---
// TextBlock — the fallback bucket for classified sections: plain text
// rebuilt as escaped paragraphs, plus any media/links the classifier
// captured. Nothing the semantic model found gets dropped here. The
// heading facts (125 §7) re-apply the source's modern-heading rhythm —
// typography vars, the underline divider, and the centered alignment
// (jayainc's "Other Featured Products" band).
import type { SemanticSection } from '../../forge/semantic.ts';
import type { SectionTheme } from '../../lib/sections.generated.ts';
import SmartImage from '../SmartImage.astro';
import SectionTitle from './SectionTitle.astro';

interface Props {
	section: SemanticSection;
	theme?: SectionTheme;
}

const { section, theme } = Astro.props;
const { title, body, media, links } = section.slots;

const titleVars = [
	theme?.titleStyle?.size && `--ds-title-size:${theme.titleStyle.size}`,
	theme?.titleStyle?.weight && `--ds-title-weight:${theme.titleStyle.weight}`,
	theme?.titleStyle?.lineHeight && `--ds-title-lh:${theme.titleStyle.lineHeight}`,
	theme?.titleStyle?.letterSpacing && `--ds-title-ls:${theme.titleStyle.letterSpacing}`,
]
	.filter(Boolean)
	.join(';');

const dividerStyle = theme?.titleDivider
	? [
			`width:${theme.titleDivider.width}`,
			`height:${theme.titleDivider.height}`,
			`background:${theme.titleDivider.background}`,
			theme.titleDivider.shadow && `box-shadow:${theme.titleDivider.shadow}`,
		]
			.filter(Boolean)
			.join(';')
	: undefined;
---

<section class:list={['ds-section', 'ds-body', theme?.titleAlign === 'center' && 'ds-body--center']}>
	{title && <SectionTitle title={title} theme={theme} style={titleVars || undefined} />}
	{theme?.titleDivider && <span class="ds-title-divider" aria-hidden="true" style={dividerStyle} />}
	{body?.map((paragraph) => <p class="ds-text">{paragraph}</p>)}
	{media?.map((image) => (
		<SmartImage class="ds-media" src={image.src} alt={image.alt ?? ''} />
	))}
	{links && links.length > 0 && (
		<div class="ds-links">
			{links.map((link) => (
				<a class="ds-button" href={link.href ?? '#'}>
					{link.text ?? 'Learn more'}
				</a>
			))}
		</div>
	)}
</section>
