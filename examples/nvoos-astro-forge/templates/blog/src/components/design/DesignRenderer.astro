---
// DesignRenderer — the semantic renderer (Proposal 114 §3.2/§3.4, themed by
// 117 §2).
//
// Takes the ALREADY-sanitized entry body (page.body) and renders it through
// the semantic content model: classified builder sections rebuild as ADS
// design components; unclassified content falls back to the .post-body
// treatment (the sanitized substring, verbatim). No classification happens
// here — the vendored src/forge/semantic.ts owns that; this component only
// dispatches sections to components. Text is interpolated (escaped); only
// sanitized substrings pass through set:html.
//
// Theming (117 §2): the classifier carries each section's source Elementor id;
// sections.generated.ts maps that id to the source band's background facts and
// resolved theme. Every section renders inside a themed wrapper that
// re-applies the source band — dark navy bands, gray bands, and the hero
// photo with its overlay — so the rebuilt page keeps the source's visual
// rhythm without copying any markup.
import type { SemanticSection } from '../../forge/semantic.ts';
import { classifyHtml } from '../../forge/semantic.ts';
import { sections as sectionThemes, type SectionTheme } from '../../lib/sections.generated.ts';
import Cta from './Cta.astro';
import FeatureGrid from './FeatureGrid.astro';
import Form from './Form.astro';
import Gallery from './Gallery.astro';
import Hero from './Hero.astro';
import IconList from './IconList.astro';
import LogoCloud from './LogoCloud.astro';
import Testimonial from './Testimonial.astro';
import TextBlock from './TextBlock.astro';
import manifestJson from '../../../nvoos.json';
import { vocabulary } from '../../lib/vocabulary.generated.ts';

/** A pre-classified wireframe section (Proposal 115) — the semantic section
 *  plus its per-breakpoint column behavior. */
interface WireframeSectionInput {
	section: SemanticSection;
	responsive?: { columns?: Record<string, number> };
}

interface Props {
	html?: string;
	/** Pre-classified wireframe sections — take precedence over `html` and
	 *  carry per-breakpoint column behavior (115 §4). */
	wireframeSections?: WireframeSectionInput[];
}

// The manifest's inferred JSON type has no `forms` key on profiles that
// omit the block — read it through an explicit shape.
const manifest = manifestJson as { forms?: { searchForms?: string[] } };
const { html = '', wireframeSections } = Astro.props;
const sections: SemanticSection[] = wireframeSections
	? wireframeSections.map( ( w ) => w.section )
	: html
		? classifyHtml( html, {
				searchForms: manifest.forms?.searchForms,
				// The learned vocabulary (Proposal 116) wins over the seeded
				// classifier defaults — per-site, baked at scaffold time.
				widgetRoles: vocabulary.widgetRoles,
				blockRoles: vocabulary.blockRoles,
		  } )
		: [];
const columnsFor = ( index: number ): Record<string, number> | undefined => wireframeSections?.[ index ]?.responsive?.columns;
const themeFor = ( section: SemanticSection ): SectionTheme | undefined =>
	section.id ? sectionThemes.find( ( theme ) => theme.id === section.id ) : undefined;
const wrapStyle = ( theme: SectionTheme | undefined ): string | undefined => {
	if ( ! theme ) {
		return undefined;
	}
	const parts: string[] = [];
	if ( theme.theme === 'hero' ) {
		if ( theme.bgImage ) {
			parts.push( `background-image:url('${ theme.bgImage }')` );
		}
		// A color alongside the photo is the source's UNDERLAY (invisible
		// beneath an opaque image) — never paint it over the photo.
		if ( theme.bg && ! theme.bgImage ) {
			parts.push( `background-color:${ theme.bg }` );
		}
		if ( theme.overlay ) {
			parts.push( `--ds-overlay:${ theme.overlay }` );
		}
		return parts.length > 0 ? parts.join( ';' ) : undefined;
	}
	if ( theme.bg ) {
		parts.push( `background:${ theme.bg }` );
	}
	return parts.length > 0 ? parts.join( ';' ) : undefined;
};
---

{sections.length > 0 && (
	<div class="design-sections">
		{sections.map((section, index) => {
			const theme = themeFor(section);
			return (
				<div id={theme?.anchor} class:list={['ds-section-wrap', theme && `ds-section-wrap--${theme.theme}`]} style={wrapStyle(theme)}>
					{section.kind === 'hero' && <Hero section={section} />}
					{section.kind === 'feature-grid' && <FeatureGrid section={section} columns={columnsFor(index)} />}
					{section.kind === 'icon-list' && <IconList section={section} columns={columnsFor(index)} />}
					{section.kind === 'testimonial' && <Testimonial section={section} />}
					{section.kind === 'logo-cloud' && <LogoCloud section={section} />}
					{section.kind === 'cta' && <Cta section={section} />}
					{section.kind === 'gallery' && <Gallery section={section} />}
					{section.kind === 'form' && <Form section={section} />}
					{section.kind === 'text' && (section.html ? <div class="post-body ds-section" set:html={section.html} /> : <TextBlock section={section} />)}
					{section.kind === 'raw' && <div class="post-body ds-section" set:html={section.html ?? ''} />}
				</div>
			);
		})}
	</div>
)}
