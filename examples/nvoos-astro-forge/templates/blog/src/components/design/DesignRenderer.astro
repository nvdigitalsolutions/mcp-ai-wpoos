---
// SPDX-License-Identifier: MIT
// DesignRenderer — the semantic renderer (Proposal 114 §3.2/§3.4, themed by
// 117 §2).
//
// Takes the ALREADY-sanitized entry body (page.body) and renders it through
// the semantic content model: classified builder sections rebuild as ADS
// design components; unclassified content falls back to the .post-body
// treatment (the sanitized substring, verbatim). No classification happens
// here — the vendored src/forge/semantic.ts owns that; this component only
// dispatches sections to components. Text is interpolated (escaped); only
// sanitized substrings pass through set:html.
//
// Theming (117 §2): the classifier carries each section's source Elementor id;
// sections.generated.ts maps that id to the source band's background facts and
// resolved theme. Every section renders inside a themed wrapper that
// re-applies the source band — dark navy bands, gray bands, and the hero
// photo with its overlay — so the rebuilt page keeps the source's visual
// rhythm without copying any markup.
import type { SemanticSection } from '../../forge/semantic.ts';
import { bandSpacing, bandSource, pageBackground, sections as sectionThemes, type SectionTheme } from '../../lib/sections.generated.ts';
import { behaviors, type ScrollBehaviorEntry } from '../../lib/behaviors.generated.ts';
import { animationCss } from '../../lib/animations.generated.ts';
import { classifyBody } from '../../lib/classify.ts';
import { hoverComponentVars } from '../../forge/hover-vars.ts';
import { wrapperAnchor } from '../../lib/anchor.ts';
import { titleEchoItems, mediaLane } from '../../lib/band-copy.ts';
import { parallaxBandCss } from '../../lib/motion.ts';
import { laneTracks } from '../../lib/lane-tracks.ts';
import Cta from './Cta.astro';
import BandBody from './BandBody.astro';
import Catalog from './Catalog.astro';
import Comparison from './Comparison.astro';
import FeatureGrid from './FeatureGrid.astro';
import Form from './Form.astro';
import Gallery from './Gallery.astro';
import Hero from './Hero.astro';
import Accordion from './Accordion.astro';
import IconList from './IconList.astro';
import LogoCloud from './LogoCloud.astro';
import Marquee from './Marquee.astro';
import Pricing from './Pricing.astro';
import Stats from './Stats.astro';
import Steps from './Steps.astro';
import Team from './Team.astro';
import Testimonial from './Testimonial.astro';
import TextBlock from './TextBlock.astro';

/** A pre-classified wireframe section (Proposal 115) — the semantic section
 *  plus its per-breakpoint column behavior. */
interface WireframeSectionInput {
	section: SemanticSection;
	responsive?: { columns?: Record<string, number> };
}

interface Props {
	html?: string;
	/** Pre-classified wireframe sections — take precedence over `html` and
	 *  carry per-breakpoint column behavior (115 §4). */
	wireframeSections?: WireframeSectionInput[];
	/**
	 * Apply the measured band GEOMETRY (box height, padding, typography). True
	 * only on the page the facts were measured from — the front page. A
	 * sub-page reuses `sections.generated.ts` POSITIONALLY for its SURFACES
	 * only: the homepage's 1800px band height there pinned a 7497px article
	 * (monicarajiv.com, 2026-11-11).
	 */
	bandGeometry?: boolean;
	/**
	 * The page's OWN measured band list (`pages.generated.ts`). When present it
	 * wins over the homepage list and implies `bandGeometry`: the facts were
	 * measured on this page, so its heights/padding/typography are its own.
	 */
	bandThemes?: SectionTheme[];
	/**
	 * This body IS the page's document outline (the front page) — no article
	 * heading sits above the bands. The FIRST band may then render the source's
	 * `h1` as an `h1`; everywhere else a band h1 maps down to `h2` so a post page
	 * cannot gain a second one (see lib/title-tag.ts).
	 */
	pageHeading?: boolean;
}

const { html = '', wireframeSections, bandGeometry = false, bandThemes, pageHeading = false } = Astro.props;
const rawSections: SemanticSection[] = wireframeSections
	? wireframeSections.map( ( w ) => w.section )
	: classifyBody( html );
const columnsFor = ( index: number, theme?: SectionTheme ): Record< string, number > | undefined => {
	const wireframe = wireframeSections?.[ index ]?.responsive?.columns;
	if ( wireframe ) {
		return wireframe;
	}
	// No wireframe inventory: the SOURCE band's own column count is still a
	// measured fact (design.sections[].columns). Without this fallback a
	// three-column services band rebuilt as a grid with the template's default
	// four tracks — the source's columns never reached the grid at all.
	const count = theme?.columns?.length ?? 0;
	if ( count < 2 ) {
		return undefined;
	}
	// A STACK of full-width lanes is not a row. `laneTracks` simulates the
	// source's flex wrap and answers 1 for [100, 100]; a grid of two would lay
	// the lanes beside themselves and move the copy 319px left (eca.directory's
	// about-us CTA, 2026-11-25).
	const measuredTracks = laneTracks( theme?.columns ?? [], 'desktop' );
	if ( measuredTracks !== undefined && measuredTracks < 2 ) {
		return undefined;
	}
	return { desktop: count, tablet: count >= 3 ? 2 : count, mobile: 1 };
};
/**
 * The source band theme for a rebuilt section. Elementor sites match by the
 * classifier-carried section id. Outline-only sources (WPBakery/Brando…) carry
 * no ids at all, so `bandSource === 'outline'` maps them POSITIONALLY — the
 * rebuilt sections and the source bands both follow the page flow. Without the
 * positional pass those bands never themed, so the rebuild rendered template
 * defaults instead of the source's own surfaces (virtuallyjamaica's red hero).
 */
const themeFor = ( section: SemanticSection, index: number ): SectionTheme | undefined => {
	const theme = themeAt( section, index );
	if ( ! pageHeading || index !== 0 ) {
		return theme;
	}
	// The classifier's level is the fallback: an outline profile has no measured
	// `titleLevel`, and the band is still the page's own headline.
	const level = theme?.type?.titleLevel ?? ( section.slots.titleLevel === 1 ? 'h1' : undefined );
	if ( level !== 'h1' ) {
		return theme;
	}
	return {
		...( theme ?? { theme: 'alt' as SectionTheme[ 'theme' ] } ),
		type: { ...( theme?.type ?? {} ), titleLevel: 'h1', allowH1: true },
	} as SectionTheme;
};
/** The measured source theme for a band, before the page-heading policy. */
const themeAt = ( section: SemanticSection, index: number ): SectionTheme | undefined => {
	// The page's OWN measured list wins: its bands were measured on this page,
	// so position is the identity and every fact applies as-is.
	if ( bandThemes ) {
		return ( section.id ? bandThemes.find( ( theme ) => theme.id === section.id ) : undefined ) ?? bandThemes[ index ];
	}
	const byId = section.id ? sectionThemes.find( ( theme ) => theme.id === section.id ) : undefined;
	if ( byId ) {
		return byId;
	}
	if ( bandSource !== 'outline' ) {
		return undefined;
	}
	const positional = sectionThemes[ index ];
	if ( ! positional || bandGeometry ) {
		return positional;
	}
	// Surfaces only — the geometry facts describe the page they were measured
	// on, so a sub-page keeps the source's palette and rhythm but not its
	// homepage box heights.
	return {
		id: positional.id,
		theme: positional.theme,
		anchor: positional.anchor,
		bg: positional.bg,
		bgImage: positional.bgImage,
		overlay: positional.overlay,
	};
};
// The measured EYEBROW must not also render as body copy. The classifier reads
// tag level alone, so a band with a label heading above its title demotes the
// label into `slots.body` (and the rebuild printed it UNDER the title at body
// size). The browser measurement knows which line is the label; drop that exact
// line here, once, so every component benefits without its own filter.
const sections: SemanticSection[] = rawSections.map( ( section, index ) => {
	const eyebrow = themeFor( section, index )?.eyebrow?.text?.trim();
	const body = section.slots.body;
	if ( ! eyebrow || ! body || body.length === 0 ) {
		return section;
	}
	const filtered = body.filter( ( line ) => line.trim() !== eyebrow );
	return filtered.length === body.length
		? section
		: { ...section, slots: { ...section.slots, body: filtered } };
} );
/** ALL source behaviors for a section. A band can be BOTH parallax and reveal
 * (jayainc's about band is); the old single `find` returned whichever entry came
 * first, so a reveal-first band silently lost its parallax class and range. */
const behaviorsFor = ( section: SemanticSection ): ScrollBehaviorEntry[] =>
	section.id ? behaviors.entries.filter( ( behavior ) => behavior.id === section.id ) : [];
const behaviorClasses = ( list: ScrollBehaviorEntry[] ): string[] => {
	const classes: string[] = [];
	if ( list.some( ( behavior ) => behavior.kind === 'parallax' ) ) {
		classes.push( 'ds-parallax' );
	}
	// One reveal per band: the first in source order wins (the generated list can
	// carry several — the outer heading and each inner widget).
	const reveal = list.find( ( behavior ) => behavior.kind === 'reveal' );
	if ( reveal ) {
		classes.push( 'ds-reveal', `ds-reveal--${ reveal.effect ?? 'fade' }` );
	}
	if ( list.some( ( behavior ) => behavior.kind === 'sticky' ) ) {
		classes.push( 'ds-sticky' );
	}
	return classes;
};
const parallaxFor = ( list: ScrollBehaviorEntry[] ): ScrollBehaviorEntry | undefined =>
	list.find( ( behavior ) => behavior.kind === 'parallax' );
/** The parallax travel range scales with the source's motion_fx speed. */
const parallaxStyle = ( behavior: ScrollBehaviorEntry | undefined ): string | undefined =>
	behavior?.speed !== undefined && behavior.speed > 1
		? `--ds-parallax-range:${ Math.min( behavior.speed, 4 ) * 24 }px`
		: undefined;
/** A band length (margin or padding) — one value, or a per-device map
 * (Elementor's scoped pulls and per-device band padding). */
type ResponsiveLength = string | { desktop?: string; tablet?: string; mobile?: string } | undefined;

/** The inline half of a band margin — only plain strings go inline. */
const marginInline = ( value: ResponsiveLength ): string | undefined =>
	typeof value === 'string' ? value : undefined;

/**
 * The stylesheet half of a band margin. Elementor scopes a pull to a device
 * range — jayainc's products band is 0px on desktop, 170px on tablet and 100px
 * on mobile — so a single inline value is unfaithful. A per-device map is
 * emitted entirely as CSS: an inline value would outrank the media queries.
 * Band padding uses the same contract (jayainc's 059421c: 125px desktop,
 * 100px tablet and mobile). Breakpoints match the template's (1025 desktop /
 * 768 tablet).
 */
const responsiveDeviceCss = ( id: string | undefined, property: string, value: ResponsiveLength ): string => {
	if ( ! id || typeof value !== 'object' || value === null ) {
		return '';
	}
	const scoped = `[data-section-id="${ id }"]`;
	return [
		value.desktop && `${ scoped }{${ property }:${ value.desktop }}`,
		value.tablet && `@media (max-width: 1024px){${ scoped }{${ property }:${ value.tablet }}}`,
		value.mobile && `@media (max-width: 767px){${ scoped }{${ property }:${ value.mobile }}}`,
	]
		.filter( Boolean )
		.join( '' );
};
// ---------------------------------------------------------------------------
// A band with no slots renders nothing (the templates only draw what the
// classifier found); `source` band spacing must not collapse those to 0px.
const sectionHasContent = ( section: SemanticSection ): boolean => {
	const { title, body, items, media } = section.slots ?? {};
	return Boolean(
		title ||
			( body && body.length > 0 ) ||
			( items && items.length > 0 ) ||
			( media && media.length > 0 ) ||
			// A RAW slice is content: the fidelity guard demotes a band whose
			// classified slots would drop its words (`kind: 'text'` + `html`
			// with empty slots), and treating that as empty skipped the band's
			// measured min-height and padding.
			section.html ||
			// Proposal 136 structured slots — a kind is content too.
			( section.pricing?.plans.length ?? 0 ) > 0 ||
			( section.stats?.items.length ?? 0 ) > 0 ||
			( section.steps?.items.length ?? 0 ) > 0 ||
			( section.team?.people.length ?? 0 ) > 0 ||
			( section.marquee?.items.length ?? 0 ) > 0 ||
			( section.comparison?.rows.length ?? 0 ) > 0
	);
};

/**
 * The page's DOMINANT measured body size (see `wrapStyle`'s fallback).
 * A band without a paragraph of its own still inherits the source's body size,
 * and `em`-sized children resolve against it.
 */
/** A CSS `font-family` value for one measured family name. A single-token
 * name may go in bare; anything with a space needs quoting (`Dancing Script`). */
const cssFamily = ( family: string ): string => {
	const name = family.trim();
	return /\s/.test( name ) ? `"${ name.replace( /"/g, '' ) }"` : name;
};

const pageBodySize = ( () => {
	const counts = new Map< string, number >();
	sections.forEach( ( section, index ) => {
		const size = themeFor( section, index )?.type?.body?.size;
		if ( size ) {
			counts.set( size, ( counts.get( size ) ?? 0 ) + 1 );
		}
	} );
	return [ ...counts.entries() ].sort( ( a, b ) => b[ 1 ] - a[ 1 ] )[ 0 ]?.[ 0 ];
} )();

/**
 * The larger of a `padding` shorthand's two SIDE values, in px.
 *
 * Only px is read: every band-padding fact is emitted in px, and a `rem`/`%`
 * value would otherwise be parsed as its bare number (1rem → 1).
 */
const bandSidePadding = ( shorthand: string | undefined ): number => {
	if ( ! shorthand ) {
		return 0;
	}
	const values = shorthand.trim().split( /\s+/ );
	if ( ! values.every( ( value ) => /^-?\d+(?:\.\d+)?px$/.test( value ) ) ) {
		return 0;
	}
	const numbers = values.map( ( value ) => Number.parseFloat( value ) );
	// 1 → all sides; 2 → vertical/horizontal; 3 → top/horizontal/bottom;
	// 4 → top/right/bottom/left.
	const horizontal = numbers.length === 1 ? numbers[ 0 ] : numbers[ 1 ];
	const left = numbers.length >= 4 ? numbers[ 3 ] : horizontal;
	return Math.max( 0, horizontal ?? 0, left ?? 0 );
};

/**
 * The band's measured PICTURE, taken from the element facts.
 *
 * `collectSlots` reads `<img src>`, and a builder paints a hero photo as a
 * `background-image` on a spacer div — so a split hero arrived with an EMPTY
 * media column and rendered only copy (eca.directory, 2026-11-24). The element
 * pass already recorded every painted element's URL and height; the tallest is
 * the picture, the shorter ones are its decorative blobs and shapes. One image
 * beats a pile of ornaments the rebuild cannot position (their absolute offsets
 * live in the vendor sheet that never ships).
 */
const mediaFromElementFacts = ( theme: SectionTheme | undefined ): Array< { src: string; alt: string } > | undefined => {
	const painted = ( theme?.elements ?? [] )
		.map( ( element ) => {
			const match = /background-image:\s*url\(\s*["']?([^"')]+)["']?\s*\)/i.exec( element.bg ?? '' );
			if ( ! match ) {
				return undefined;
			}
			const height = typeof element.height === 'number' ? element.height : element.height?.desktop ?? 0;
			return { src: match[ 1 ], height };
		} )
		.filter( ( entry ): entry is { src: string; height: number } => Boolean( entry?.src ) )
		.sort( ( a, b ) => b.height - a.height );
	return painted.length > 0 ? [ { src: painted[ 0 ].src, alt: '' } ] : undefined;
};

/** Any `property:` prefix — the shape that makes a value a DECLARATION. */
const CSS_DECLARATION_RE = /^[a-z-]+\s*:/i;

/**
 * A band's background fact, as a CSS declaration.
 *
 * `bg` is usually a VALUE (`#fff`, `linear-gradient(…)`). The per-page pass also
 * records some surfaces as a full DECLARATION, and prefixing those produced
 * `background:background-image:url(…)` — invalid CSS, silently dropped, so the
 * band rendered flat. eca.directory's about-us "Why choose" band lost its blob
 * photo this way.
 *
 * A `background-image`/`background` declaration is passed through verbatim. A
 * bare `background-color:` declaration is NOT trusted as a BAND surface: the
 * page pass also hoists a lane's slab, and painting the whole band with one
 * lane's colour is worse than leaving it — colours arrive via `bgColor`.
 */
/**
 * The band image's BOX, as declarations.
 *
 * Elementor always declares all three beside the URL; the extracted value wins.
 * When a band states none, `cover` / `no-repeat` / `center` is the sane band
 * default — the CSS initial values paint a pattern at NATIVE scale, which is
 * how eca.directory's dot pattern became a checkerboard over two bands
 * (2026-11-25).
 */
const backgroundBox = ( theme: SectionTheme ): string[] => [
	`background-size:${ theme.bgSize ?? 'cover' }`,
	`background-repeat:${ theme.bgRepeat ?? 'no-repeat' }`,
	`background-position:${ theme.bgPosition ?? 'center' }`,
];

/**
 * The band image's LAYER (`bgLayerOpacity`).
 *
 * Elementor paints a band image on a `::before` layer faded by
 * `--overlay-opacity` (0.05 on eca.directory's hero, 0.2 on its stats band,
 * blended `lighten`). Painting the image on the band itself shows it at full
 * strength over the copy. A layer band keeps the image OUT of `wrapStyle` and
 * gets a scoped `::before` here instead; the band's own colour stays on the
 * wrap, which is the order the source paints.
 */
const bandLayerCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		const id = section.id ?? theme?.id;
		if ( ! id || ! theme?.bgImage || theme.bgLayerOpacity === undefined ) {
			return '';
		}
		const scoped = `[data-section-id="${ id }"]`;
		const blend = theme.bgBlendMode ? `;mix-blend-mode:${ theme.bgBlendMode }` : '';
		return (
			`${ scoped }{position:relative;isolation:isolate}` +
			`${ scoped }::before{content:"";position:absolute;inset:0;background-color:transparent;background-image:url('${ theme.bgImage }');${ backgroundBox( theme ).join( ';' ) };opacity:${ theme.bgLayerOpacity }${ blend };pointer-events:none;z-index:0}` +
			`${ scoped }>*{position:relative;z-index:1}`
		);
	} )
	.join( '' );

function bandBackground( value: string ): string | undefined {
	const trimmed = value.trim();
	if ( trimmed === '' ) {
		return undefined;
	}
	if ( /^background(?:-image)?\s*:/i.test( trimmed ) ) {
		return trimmed;
	}
	if ( CSS_DECLARATION_RE.test( trimmed ) ) {
		return undefined;
	}
	return `background:${ trimmed }`;
}

/**
 * Is a background fact a LIGHT surface?
 *
 * Only used to decide whether a hero keeps the template's white ink (the photo
 * assumption) or takes its measured body ink. Unparseable values say no, so an
 * unknown surface keeps the old behaviour.
 */
const lightSurface = ( value?: string ): boolean => {
	if ( ! value ) {
		return false;
	}
	const text = value.trim();
	const hex = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec( text );
	const rgb = /rgba?\(\s*(\d+)[,\s]+(\d+)[,\s]+(\d+)/i.exec( text );
	let r: number;
	let g: number;
	let b: number;
	if ( hex ) {
		const digits = hex[ 1 ].length === 3 ? hex[ 1 ].replace( /(.)/g, '$1$1' ) : hex[ 1 ];
		r = parseInt( digits.slice( 0, 2 ), 16 );
		g = parseInt( digits.slice( 2, 4 ), 16 );
		b = parseInt( digits.slice( 4, 6 ), 16 );
	} else if ( rgb ) {
		r = Number( rgb[ 1 ] );
		g = Number( rgb[ 2 ] );
		b = Number( rgb[ 3 ] );
	} else {
		return false;
	}
	return 0.299 * r + 0.587 * g + 0.114 * b > 140;
};

/**
 * A LIGHT hero's measured ink.
 *
 * `.ds-section-wrap--hero > *` paints the whole band white because the template
 * assumes a PHOTO hero. On a measured LIGHT band with no overlay that is
 * unreadable (eca.directory about-us: #747474 body on #F7F7F7). A scoped rule on
 * the paragraphs beats inheritance without touching the shared template CSS
 * (which is drift-tracked). Hero-only on purpose: a card band manages its own
 * ink.
 */
const bandInkCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		const id = section.id ?? theme?.id;
		const ink = theme?.type?.body?.color;
		if ( ! id || ! ink || theme?.theme !== 'hero' || theme?.overlay || ! lightSurface( theme?.bg ) ) {
			return '';
		}
		const scoped = `[data-section-id="${ id }"]`;
		// `!important` on purpose: the hero template paints the subtree white through
		// a class rule, and this is the one measurement that must beat it. Scoped to
		// the band and only for a MEASURED light hero with no overlay.
		return `${ scoped } p,${ scoped } li,${ scoped } span{color:${ ink }!important}`;
	} )
	.join( '' );

/**
 * A two-lane band's measured RATIO as the grid token.
 *
 * `--ds-split-ratio` feeds `.ds-hero-split` AND `.ds-band-split`; a split hero
 * needs the same fact as any other split band. It used to be emitted only past
 * the hero branch's early return, so every split hero fell back to `1fr 1fr`:
 * eca.directory's about-us copy lane measured 624px against the source's 811 and
 * wrapped its lede one line longer (2026-11-25).
 */
const splitRatio = ( theme: SectionTheme | undefined ): string | undefined => {
	const lanes = theme?.columns ?? [];
	if ( lanes.length !== 2 || ! lanes[ 0 ].width || ! lanes[ 1 ].width ) {
		return undefined;
	}
	return `--ds-split-ratio:minmax(0,${ lanes[ 0 ].width / 100 }fr) minmax(0,${ lanes[ 1 ].width / 100 }fr)`;
};

const wrapStyle = ( theme: SectionTheme | undefined, hasContent = true, bodyFallback?: string, desktopCols?: number, collapsed = false ): string | undefined => {
	if ( ! theme ) {
		return undefined;
	}
	const parts: string[] = [];
	// The boxed container measure + side gutter (124 §3): the inner column
	// re-measures to the source's container width, never the site measure — the
	// band bg stays full-width. Theme-agnostic: hero bands are boxed too.
	//
	// A per-device map is emitted as scoped CSS below (see `responsiveBandCss`):
	// an inline value would outrank its own media queries.
	if ( typeof theme.measure === 'string' ) {
		parts.push( `--ds-measure:${ theme.measure }` );
	}
	if ( typeof theme.paddingX === 'string' ) {
		parts.push( `--ds-pad-x:${ theme.paddingX }` );
	}
	// The source band's declared padding (jayainc: the 100px bands vs the
	// flush content-tight bands) — inline wins over the wrap default. This runs
	// BEFORE the hero's early return: a hero band carries padding facts too.
	if ( theme.padding ) {
		// A per-device map is emitted as scoped CSS below (an inline padding
		// would outrank its media queries); only a plain shorthand goes inline.
		if ( typeof theme.padding === 'string' ) {
			parts.push( `padding:${ theme.padding }` );
		}
		// The band's own side padding, as a number of its own. The mobile floor
		// below tops the gutter up to `--forge-space` for a band whose source
		// gutter is ZERO, but a band that already carries 30px of its own must
		// not get a 46px gutter (eca.directory's day pages: build 298px of copy
		// against the source's 330, 2026-11-24). Subtracting this from the floor
		// keeps the phone fix and kills the double gutter.
		const shorthand = typeof theme.padding === 'string' ? theme.padding : theme.padding.desktop;
		const horizontal = bandSidePadding( shorthand );
		if ( horizontal > 0 ) {
			parts.push( `--ds-band-pad-x:${ horizontal }px` );
		}
		// The source declares the band's rhythm — suppress the template's
		// default section padding so the bands meet their neighbors flush
		// (124 §5, the continuous flow).
		parts.push( '--ds-pad-y:0' );
	} else if ( bandSpacing === 'source' ) {
		// No padding fact = the source band is flush. `source` mode honours that
		// instead of the template's own rhythm. The wrap's padding comes from a
		// rule (--forge-space-4), NOT --ds-pad-y, so zero it explicitly.
		//
		// An EMPTY band is a spacer (jayainc's dff3f1a is 70px with no padding
		// fact and no content): zeroing it would render 0px and shift every
		// band below it. Those keep the wrap's rhythm and lose only the inner
		// section's, which would otherwise double-count it.
		parts.push( '--ds-pad-y:0' );
		if ( hasContent ) {
			parts.push( 'padding-top:0' );
			parts.push( 'padding-bottom:0' );
		}
	}
	// The band's MEASURED source height (114 §3.6) — a floor, never a lock: a
	// band whose rebuilt content is already taller keeps its own height. Placed
	// BEFORE the hero's early return below, because the hero band is exactly the
	// one a source height pins (virtuallyjamaica's full-screen contact band).
	// A per-device map is emitted as scoped CSS; only a plain value goes inline.
	if ( theme.minHeight && typeof theme.minHeight === 'string' && ! collapsed ) {
		parts.push( `min-height:${ theme.minHeight }` );
		// The same floor on the SECTION, for the bands whose row IS the band
		// (see `.ds-section-wrap:has(.ds-card--surface)` in global.css). A floor on
		// the wrap cannot reach them: a column flex item does not grow into a
		// `min-height`-only parent, so the measured height showed as dead space
		// under the slabs.
		parts.push( `--ds-min-h:${ theme.minHeight }` );
	}
	// The band's measured typography (see bandTypeCss below): the components that
	// render a `ds-title` size from the source's own heading, not the token scale.
	// A source band whose title is 35px must not render at the template's h1.
	// The source's BODY size, for the containers that size their own children in
	// `em` (Flatsome's `.button` is .97em of the column, which inherits the body
	// size). Heading/paragraph rules cannot carry it: they set `p`/`hN`, not the
	// wrapper a button sits in.
	//
	// A band with no paragraph of its own (a button row, a photo band) still
	// inherits the source's body size, so fall back to the page's dominant
	// measured size — without it `.button` resolved .97 × 13px = 12.6px where
	// the source renders 17.23px.
	if ( theme.type?.body?.size || bodyFallback ) {
		parts.push( `--ds-body-size:${ theme.type?.body?.size ?? bodyFallback }` );
	}
	// The band's PANEL surface (a source slab the content sits on) — the item
	// group paints it; the CSS reads the vars so no inline background is needed.
	if ( theme.panel ) {
		parts.push( `--ds-panel-bg:${ theme.panel.bg }`, `--ds-panel-ink:${ theme.panel.ink }` );
		// A slab that fills only PART of the band carries its own box; the band's
		// heading is centred ON it, not on the viewport. The alignment rides a
		// modifier class (see the wrap's class list), not a var: CSS cannot branch
		// on a custom property's presence.
		if ( theme.panel.width ) {
			parts.push( `--ds-panel-width:${ theme.panel.width }` );
		}
	}
	// The band’s own DISPLAY face. A source can put a script accent beside a
	// sans heading in the same band (monicarajiv: Karma h1 + Dancing Script
	// `alt-font` h3), so the family rides the band’s title and the per-level
	// `bandTypeCss` rules carry the rest.
	if ( theme.type?.title?.family ) {
		parts.push( `--ds-title-font:${ cssFamily( theme.type.title.family ) }` );
	}
	if ( theme.type?.title ) {
		const title = theme.type.title;
		if ( title.size ) {
			parts.push( `--ds-title-size:${ title.size }` );
		}
		if ( title.weight ) {
			parts.push( `--ds-title-weight:${ title.weight }` );
		}
		if ( title.lineHeight && title.lineHeight !== 'normal' ) {
			parts.push( `--ds-title-lh:${ title.lineHeight }` );
		}
		if ( title.tablet?.lineHeight && title.tablet.lineHeight !== 'normal' ) {
			parts.push( `--ds-title-lh-md:${ title.tablet.lineHeight }` );
		}
		if ( title.mobile?.lineHeight && title.mobile.lineHeight !== 'normal' ) {
			parts.push( `--ds-title-lh-sm:${ title.mobile.lineHeight }` );
		}
		// The measured SIZE the source paints below the desktop range. The template
		// shrinks a headline with a hard-coded `clamp()` floor (1.5rem / 1.75rem),
		// which is a guess about the source: monicarajiv's band title is 22.2px on
		// desktop and 16px on a phone, so the floor painted 22.2px — a phone headline
		// 39% larger than the source's (2026-11-21). A measured size is not an anchor
		// for that clamp, it IS the value at that device, so global.css overrides the
		// clamp outright when these are present.
		if ( title.tablet?.size ) {
			parts.push( `--ds-title-size-md:${ title.tablet.size }` );
		}
		if ( title.mobile?.size ) {
			parts.push( `--ds-title-size-sm:${ title.mobile.size }` );
		}
		if ( title.letterSpacing && title.letterSpacing !== 'normal' ) {
			parts.push( `--ds-title-ls:${ title.letterSpacing }` );
		}
		if ( title.align && title.align !== 'start' && title.align !== 'left' ) {
			parts.push( `--ds-title-align:${ title.align }` );
		}
		// The source's own ink. A builder element's colour lives in an inline
		// `style` the sanitizer drops, so `.ds-title` otherwise inherited the
		// template's accent — virtuallyjamaica's accordion titles rendered
		// #fe6c61 where the source is #262626.
		if ( title.color ) {
			parts.push( `--ds-title-color:${ title.color }` );
		}
		// The source's deliberate heading width (jayainc's services title is
		// max-width 473px inside a 640px column; full-width it wrapped to two
		// lines and the band's pinned height showed the shortfall).
		if ( title.maxWidth && title.maxWidth !== 'none' ) {
			parts.push( `--ds-title-max:${ title.maxWidth }` );
		} else if ( title.align === 'center' ) {
			// A CENTRED title is not narrowed. The hero's own 66% cap is a
			// per-site heuristic; on a centred heading it shrank the box while
			// leaving it flush left, so the centred text sat 200px off-centre
			// (virtuallyjamaica's contact band). The source measured full width.
			parts.push( '--ds-title-max:none' );
		}
	}
	// The source's crop anchor for the band's cover photos (measured
	// `object-position`). The vendor writes it in a `<style>` block the
	// sanitizer drops, so without this every rebuilt photo crops to centre.
	if ( theme.mediaPosition ) {
		parts.push( `--ds-media-pos:${ theme.mediaPosition }` );
	}
	// The hero track's measured column split. The structural hero rule below
	// defaults to 1.15fr/0.95fr; a source whose copy column is 60% (691 of 1152
	// on virtuallyjamaica) otherwise wraps its H1 a line wider than the source.
	// The measured ratio already excludes the source's own gutter (it lives in
	// the children's padding, which the band box facts restate), so a measured
	// split also clears the heuristic gap.
	if ( theme.split && theme.split.length >= 2 ) {
		parts.push( `--ds-split:${ theme.split.map( ( fraction ) => `${ fraction }fr` ).join( ' ' ) }` );
		parts.push( '--ds-split-gap:0' );
	}
	// A MEASURED `false` clears the hero wrapper's default centring: a full-height
	// band the source top-aligns under its own padding must not be centred.
	if ( theme.centered === false ) {
		parts.push( '--ds-hero-justify:flex-start' );
	}
	// A CENTRED band is centred ACROSS the band, not down it. The wrap is a column
	// flex, so `.ds-section-wrap--centered{justify-content:center}` also centres
	// the block axis and pushed the copy down by half the leftover min-height
	// (eca.directory's FAQ band: 40px of dead space, 2026-11-25). The section's
	// own auto margins already centre it across; only a full-height band is
	// centred on the block axis.
	if ( theme.centered === true && ! theme.fullViewport ) {
		parts.push( 'justify-content:flex-start' );
	}
	if ( theme.theme === 'hero' ) {
		if ( theme.bgImage && theme.bgLayerOpacity === undefined ) {
			parts.push( `background-image:url('${ theme.bgImage }')` );
			parts.push( ...backgroundBox( theme ) );
		}
		// A hero's ink is only white because the template assumes a PHOTO band.
		// When the source band is LIGHT and carries no overlay, the measured body
		// ink wins (eca.directory about-us: #747474 on #F7F7F7).
		const measuredInk = theme.type?.body?.color;
		if ( ! theme.overlay && lightSurface( theme.bg ) ) {
			parts.push( '--ds-overlay:transparent' );
			if ( measuredInk ) {
				parts.push( `--ds-hero-ink:${ measuredInk }` );
			}
		}
		// A color alongside the photo is the source's UNDERLAY (invisible
		// beneath an opaque image) — never paint it over the photo. On a LAYER
		// band the image is a faded `::before`, so the colour IS the base and
		// must be painted.
		if (
			theme.bg &&
			! CSS_DECLARATION_RE.test( theme.bg ) &&
			( ! theme.bgImage || theme.bgLayerOpacity !== undefined )
		) {
			parts.push( `background-color:${ theme.bg }` );
		}
		if ( theme.overlay ) {
			parts.push( `--ds-overlay:${ theme.overlay }` );
		}
		// A split hero's lane ratio — the hero branch returns below, so the
		// shared emission further down never runs for exactly the bands that
		// need it most.
		const heroRatio = splitRatio( theme );
		if ( heroRatio ) {
			parts.push( heroRatio );
		}
		return parts.length > 0 ? parts.join( ';' ) : undefined;
	}
	if ( theme.bg ) {
		const declaration = bandBackground( theme.bg );
		const isImage = declaration ? /background(?:-image)?\s*:/i.test( declaration ) : false;
		// A LAYER image is emitted by `bandLayerCss` instead — painting it here
		// would put the full-strength image under the copy as well.
		if ( declaration && ! ( isImage && theme.bgLayerOpacity !== undefined ) ) {
			parts.push( declaration );
			if ( isImage ) {
				parts.push( ...backgroundBox( theme ) );
			}
		}
	}
	// Section-level pull facts (124 §4): negative margins overlap the
	// neighbor band; z-index stacks the overlap.
	if ( theme.marginTop ) {
		const marginTop = marginInline( theme.marginTop );
		if ( marginTop ) {
			parts.push( `margin-top:${ marginTop }` );
		}
	}
	if ( theme.marginBottom ) {
		const marginBottom = marginInline( theme.marginBottom );
		if ( marginBottom ) {
			parts.push( `margin-bottom:${ marginBottom }` );
		}
	}
	// The card box model (measured per band): Elementor cards are theme
	// components, so gap/padding come from measurement rather than any
	// band-scoped rule. Absent → the template's own card defaults.
	if ( theme.cardStyle ) {
		if ( theme.cardStyle.gap ) {
			parts.push( `--ds-card-gap:${ theme.cardStyle.gap }` );
		}
		if ( theme.cardStyle.padding ) {
			parts.push( `--ds-card-pad:${ theme.cardStyle.padding }` );
		}
		if ( theme.cardStyle.textPadding ) {
			parts.push( `--ds-card-text-pad:${ theme.cardStyle.textPadding }` );
		}
	}
	// The icon-row rhythm (measured per band): the source's list rows carry
	// their own inner padding, a large leading icon box and their own title
	// size. Absent → the template's own row defaults. padTop/padBottom/padX can
	// be per-device maps (75% of the source's desktop rhythm is lost at tablet),
	// so they go inline only as plain strings; `responsiveBandCss` emits the
	// media-query half.
	if ( theme.iconRowStyle ) {
		const row = theme.iconRowStyle;
		if ( typeof row.padTop === 'string' ) {
			parts.push( `--ds-icon-row-pad-top:${ row.padTop }` );
		}
		if ( typeof row.padBottom === 'string' ) {
			parts.push( `--ds-icon-row-pad-bottom:${ row.padBottom }` );
		}
		if ( typeof row.padX === 'string' ) {
			parts.push( `--ds-icon-row-pad-x:${ row.padX }` );
		}
		if ( row.rowGap ) {
			parts.push( `--ds-icon-row-gap:${ row.rowGap }` );
		}
		if ( row.titleSize ) {
			parts.push( `--ds-icon-title-size:${ row.titleSize }` );
		}
		if ( row.titleLineHeight ) {
			parts.push( `--ds-icon-title-lh:${ row.titleLineHeight }` );
		}
		if ( row.markerSize ) {
			parts.push( `--ds-icon-marker-size:${ row.markerSize }` );
		}
		if ( row.markerGlyph ) {
			parts.push( `--ds-icon-marker-glyph:${ row.markerGlyph }` );
		}
		if ( row.markerBackground ) {
			parts.push( `--ds-icon-marker-bg:${ row.markerBackground }` );
		}
		if ( row.markerInk ) {
			parts.push( `--ds-icon-marker-ink:${ row.markerInk }` );
		}
	}
	if ( theme.zIndex ) {
		parts.push( `z-index:${ theme.zIndex }` );
	}
	// The source's heading-block rhythm (measured `box` facts, mapped onto the
	// rebuilt title/lede): 30px under the title and 37px above the description on
	// jayainc's services band. Absent → the template's own spacing (0).
	const titleMarginBottom = boxEdge( theme.box?.[ 'aux-modern-heading-primary' ], 'margin', 'bottom' );
	if ( titleMarginBottom && titleMarginBottom !== '0px' ) {
		parts.push( `--ds-title-margin-bottom:${ titleMarginBottom }` );
		// The source's margin IS the rhythm — the template's grid gap would stack
		// on it and push a short band past its measured box.
		parts.push( '--ds-body-gap:0' );
	}
	const ledeMarginTop = boxEdge( theme.box?.[ 'aux-modern-heading-description' ], 'margin', 'top' );
	if ( ledeMarginTop && ledeMarginTop !== '0px' ) {
		parts.push( `--ds-lede-margin-top:${ ledeMarginTop }` );
	}
	// The column responsive facts (124 §6): the split components re-measure
	// from the source's per-device widths/order instead of the template's
	// fixed ratio (jayainc's services split is 50/50, not 5fr/7fr).
	const columns = theme.columns ?? [];
	// Exactly two: `--ds-split-ratio` feeds a two-lane grid (`.ds-hero-split`).
	// A three-lane band (services is 3/4/5) used to inherit a truncated
	// first-two-fr ratio here, which then applied 25/33 to a two-lane grid.
	const ratio = splitRatio( theme );
	if ( ratio ) {
		parts.push( ratio );
	}
	if ( columns.some( ( column ) => column.reverseMobile ) ) {
		parts.push( '--ds-icon-media-order:2' );
	}
	// The lane RATIOS, when the source's row is not an equal split. A services row
	// of 432 / 432 / 571 is not `repeat(3, 1fr)` — that renders 469 / 469 / 469
	// with a 16px seam, while the source's slabs butt together. The measured widths
	// become the track sizes and the source's flush gutter becomes gap 0. Guarded
	// on the grid actually rendering that many lanes: a two-lane fact must never
	// hand a three-card grid two tracks (the third card would wrap onto its own
	// row).
	if ( columns.length >= 2 && ( desktopCols === undefined || desktopCols === columns.length ) ) {
		const widths = columns.map( ( column ) => column.width ?? 0 );
		const total = widths.reduce( ( sum, width ) => sum + width, 0 );
		const spread = Math.max( ...widths ) - Math.min( ...widths );
		if ( total > 0 && widths.every( ( width ) => width > 0 ) && spread > 0.5 ) {
			parts.push(
				`--ds-cols-template-desktop:${ widths
					.map( ( width ) => `minmax(0,${ Math.round( width * 10 ) / 10 }fr)` )
					.join( ' ' ) }`
			);
			parts.push( '--ds-card-gap:0px' );
		}
	}
	return parts.length > 0 ? parts.join( ';' ) : undefined;
};

/**
 * One edge of a measured `padding`/`margin` shorthand (the `box` facts carry
 * the source’s computed declaration per class). Used to carry the source’s
 * HEADING rhythm onto the rebuilt title/lede: Phlox’s modern heading is
 * `primary { margin-bottom: 30px }` … `description { margin-top: 37px }`, and
 * both were missing from the rebuild — the band’s pinned height then showed
 * its shortfall as ~120px of dead space at the bottom.
 */
const boxEdge = (
	fact: { base?: string } | undefined,
	property: 'margin' | 'padding',
	side: 'top' | 'right' | 'bottom' | 'left'
): string | undefined => {
	const declaration = ( fact?.base ?? '' )
		.split( ';' )
		.map( ( part ) => part.trim() )
		.find( ( part ) => part.startsWith( `${ property }:` ) );
	if ( ! declaration ) {
		return undefined;
	}
	const values = declaration.slice( property.length + 1 ).trim().split( /\s+/ );
	const expanded =
		values.length === 1
			? [ values[ 0 ], values[ 0 ], values[ 0 ], values[ 0 ] ]
			: values.length === 2
				? [ values[ 0 ], values[ 1 ], values[ 0 ], values[ 1 ] ]
				: values.length === 3
					? [ values[ 0 ], values[ 1 ], values[ 2 ], values[ 1 ] ]
					: values;
	return expanded[ [ 'top', 'right', 'bottom', 'left' ].indexOf( side ) ];
};

// A feature-grid band whose EVERY card is the band's own sub-heading renders no
// grid at all (see `titleEchoItems`). The source's measured height then floors
// nothing: eca.directory's updates band held 478px for three lines of copy once
// its one placeholder post was dropped.
const foldsAway = ( section: SemanticSection, theme: SectionTheme | undefined ): boolean => {
	if ( section.kind !== 'feature-grid' || theme?.catalog ) {
		return false;
	}
	const items = section.slots?.items ?? [];
	if ( items.length === 0 ) {
		return false;
	}
	return titleEchoItems( items, section.slots?.title, theme, theme?.columns ).length === items.length;
};

// The per-device half of every band margin AND padding — emitted once, scoped
// by section id. A padding scoped to a device range needs the same CSS
// treatment as a scoped pull: an inline value would outrank the media queries.
// The container measure and side gutter join them for the same reason: both are
// measured per device (`analyze --geometry`), and a desktop value applied at
// 390px is what left a fluid band 30px wider than its source on a phone.
const responsiveBandCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		// The scoped selector must be the SAME id the wrap renders
		// (`section.id ?? theme.id`). Outline-band sources carry no section id of
		// their own, so keying off `section.id` alone emitted no rule at all and
		// every forged band silently fell back to the template's own padding.
		const id = section.id ?? theme?.id;
		return (
			responsiveDeviceCss( id, 'margin-top', theme?.marginTop ) +
			responsiveDeviceCss( id, 'margin-bottom', theme?.marginBottom ) +
			responsiveDeviceCss( id, 'padding', theme?.padding ) +
			// A band whose grid folded away sizes to its copy, not to the source's
			// height (see `foldsAway`).
			( foldsAway( section, theme ) ? '' : responsiveDeviceCss( id, 'min-height', theme?.minHeight ) ) +
			responsiveDeviceCss( id, '--ds-measure', theme?.measure ) +
			responsiveDeviceCss( id, '--ds-pad-x', theme?.paddingX ) +
			responsiveDeviceCss( id, '--ds-icon-row-pad-top', theme?.iconRowStyle?.padTop ) +
			responsiveDeviceCss( id, '--ds-icon-row-pad-bottom', theme?.iconRowStyle?.padBottom ) +
			responsiveDeviceCss( id, '--ds-icon-row-pad-x', theme?.iconRowStyle?.padX )
		);
	} )
	.join( '' );

/**
 * The band's measured typography (analyze --geometry).
 *
 * A band the classifier could not give a structural kind renders its sanitized
 * source HTML through the raw path, and that path carries NO heading scale — so
 * the browser's default `h3 { font-size: 1.17em }` scaled the 13px body to
 * 15.21px against the source's 40px. Every band's hierarchy collapsed while the
 * box-geometry gate passed. These are the source's COMPUTED styles, emitted per
 * band id, so a 40px eyebrow-to-title band reads like the source without the
 * template inventing a scale.
 *
 * Scoped to the wrap (`[data-section-id]`) and emitted after global.css, so it
 * outranks the template's own prose defaults.
 */
/**
 * A px `line-height` measured beside a px `font-size` is a RATIO in disguise, and
 * emitting it as px freezes the leading at the measured level. Flatsome's
 * `.section-title-main` sets `font-size:1.3em`, so the source's `h3` leading of
 * 1.6 painted 46.176px on the 28.86px span, while the rebuilt span inherited the
 * frozen 35.52px — a ratio of 1.23, and the section title rendered 15px short
 * (monicarajiv, 2026-11-20). The source's own leading is unitless, so the
 * inherited value must be too.
 *
 * A device override can carry `lineHeight` with no `size` (the diff emits only
 * what changed); that value is px on the element itself and passes through.
 */
const leadingRatio = ( size?: string, lineHeight?: string ): string | undefined => {
	if ( ! lineHeight ) {
		return undefined;
	}
	const sizePx = size ? /^(-?[\d.]+)px$/.exec( size.trim() ) : null;
	const linePx = /^(-?[\d.]+)px$/.exec( lineHeight.trim() );
	if ( ! sizePx || ! linePx ) {
		return lineHeight;
	}
	const ratio = Number( linePx[ 1 ] ) / Number( sizePx[ 1 ] );
	return Number.isFinite( ratio ) && ratio > 0 ? String( Math.round( ratio * 10000 ) / 10000 ) : lineHeight;
};

const typeDeclarations = ( fact: { size?: string; weight?: string; lineHeight?: string; letterSpacing?: string; transform?: string; align?: string; family?: string; color?: string; marginTop?: string; marginBottom?: string }, options: { weight?: boolean } = {} ): string =>
	[
		fact.size && `font-size:${ fact.size }`,
		// The FAMILY is deliberately NOT emitted per level: a band can hold a
		// Dancing Script `h3.alt-font` beside a Karma `h3`, and one fact cannot
		// describe both — the class carries the accent, the display role carries
		// the rest (see `.post-body :where(h1…h6)` in global.css).
		options.weight !== false && fact.weight && `font-weight:${ fact.weight }`,
		fact.lineHeight && fact.lineHeight !== 'normal' && `line-height:${ leadingRatio( fact.size, fact.lineHeight ) }`,
		fact.letterSpacing && fact.letterSpacing !== 'normal' && `letter-spacing:${ fact.letterSpacing }`,
		fact.transform && fact.transform !== 'none' && `text-transform:${ fact.transform }`,
		// The measured heading/paragraph RHYTHM. An unclassed heading has no class
		// for a box fact to hang on, so without this the template's prose defaults
		// (`h1: 0.67em 0`) replaced the builder's (`0.1em 0`) and every tile grew.
		fact.marginTop && `margin-top:${ fact.marginTop }`,
		fact.marginBottom && `margin-bottom:${ fact.marginBottom }`,
		// Only a POSITIVE alignment is emitted: the source centers a band's copy
		// from a wrapper class, which the sanitizer drops. `start`/`left` is the
		// template default and needs no rule.
		fact.align && fact.align !== 'start' && fact.align !== 'left' && `text-align:${ fact.align }`,
		// A CENTRED box with a width rule must also be centred in its parent: a
		// `max-width` alone leaves the box flush left, so the centred text sits
		// left of the band's centre (virtuallyjamaica's contact heading measured
		// 772px wide at the container's left edge against the source's full
		// width). No effect on a full-width box.
		fact.align === 'center' && 'margin-inline:auto',
		// The measured ink. Emitted LAST so a band's own colour wins over the
		// template accent it would otherwise inherit.
		fact.color && `color:${ fact.color }`,
	]
		.filter( Boolean )
		.join( ';' );

/** A device override, emitted verbatim — `diffTypeFact` already trimmed it to the
 * properties the source changes, so a reset back to `left` must survive. */
const overrideDeclarations = ( fact: { size?: string; weight?: string; lineHeight?: string; letterSpacing?: string; transform?: string; align?: string; family?: string; color?: string; marginTop?: string; marginBottom?: string } ): string =>
	[
		fact.size && `font-size:${ fact.size }`,
		fact.weight && `font-weight:${ fact.weight }`,
		fact.lineHeight && fact.lineHeight !== 'normal' && `line-height:${ leadingRatio( fact.size, fact.lineHeight ) }`,
		fact.letterSpacing && fact.letterSpacing !== 'normal' && `letter-spacing:${ fact.letterSpacing }`,
		fact.transform && fact.transform !== 'none' && `text-transform:${ fact.transform }`,
		fact.align && `text-align:${ fact.align }`,
		fact.marginTop && `margin-top:${ fact.marginTop }`,
		fact.marginBottom && `margin-bottom:${ fact.marginBottom }`,
		fact.color && `color:${ fact.color }`,
	]
		.filter( Boolean )
		.join( ';' );

const bandTypeCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		const id = section.id ?? theme?.id;
		const type = theme?.type;
		if ( ! id || ! type ) {
			return '';
		}
		const scoped = `[data-section-id="${ id }"]`;
		const rules: string[] = [];
		// The source scales its type per device (55px hero → 22px on a phone), so a
		// desktop-only rule made every band taller than its source at 390px. The
		// overrides ride the template's own breakpoints.
		const withDevices = ( selector: string, fact: { size?: string; weight?: string; lineHeight?: string; letterSpacing?: string; transform?: string; align?: string; tablet?: Record< string, string >; mobile?: Record< string, string > }, options: { weight?: boolean } = {} ): string[] => {
			const out: string[] = [];
			const declarations = typeDeclarations( fact, options );
			if ( declarations ) {
				out.push( `${ scoped } ${ selector }{${ declarations }}` );
			}
			for ( const [ device, query ] of [ [ 'tablet', 'max-width: 1024px' ], [ 'mobile', 'max-width: 767px' ] ] as const ) {
				const override = fact[ device ];
				if ( ! override ) {
					continue;
				}
				const overridden = overrideDeclarations( override );
				if ( overridden ) {
					out.push( `@media (${ query }){${ scoped } ${ selector }{${ overridden }}}` );
				}
			}
			return out;
		};
		for ( const [ tag, fact ] of Object.entries( type.headings ?? {} ) ) {
			rules.push( ...withDevices( tag, fact ) );
			// A MEASURED heading ink must outrank the template's PANEL rule
			// (`.ds-section-wrap--panel .ds-grid .ds-card :is(h3,h4,h5)`, 0,3,1),
			// which paints every card heading in the panel's derived ink. On a white
			// slab the source's own card titles are purple — eca.directory measured
			// `#27104a` on them and the panel repainted all of them `#111111`
			// (ΔE00 22.9, 2026-11-24). Scoping through the wrap raises this to 0,4,1
			// without `!important`, so a hover/focus state can still win.
			if ( fact.color ) {
				rules.push( `${ scoped }.ds-section-wrap .ds-grid .ds-card ${ tag }{color:${ fact.color }}` );
			}
		}
		if ( type.body ) {
			// Body copy keeps its size and rhythm; a weight on every paragraph would
			// also hit emphasized inline copy.
			rules.push( ...withDevices( 'p', type.body, { weight: false } ) );
		}
		if ( theme.cardInk ) {
			// The band's CARDS paint their copy in the ink measured ON the card
			// (`cardInkFor`). The template's blanket `.ds-section .ds-card p` rule is
			// (0,2,1) and outranks the band's `p` rule above, so without this the card
			// copy falls back to the `muted` token — a different grey from the source's.
			// A card that paints its OWN measured surface is excluded: it derives its
			// ink from that surface (`--ds-card-surface-ink`).
			rules.push( `${ scoped } .ds-card:not(.ds-card--surface) p{color:${ theme.cardInk }}` );
		}
		return rules.join( '' );
	} )
	.join( '' );

/**
 * The subtrees the SOURCE renders hidden at rest (analyze --geometry).
 *
 * Builders hide their accordion panels, tab panes, mega-menus and mobile
 * drawers with a class the sanitizer keeps but the rebuilt stylesheet never
 * reaches — so every panel rendered open and a band became a wall of text
 * (virtuallyjamaica's features band: 2352 characters against the source's 486).
 * The analyzer records the source's resting visibility as ready-made selectors
 * (already carrying the `:not(.in)` that separates a closed panel from the open
 * one); this emits them, scoped to the band.
 *
 * A hidden panel has no CSS-only way back open — the source toggled it with
 * JavaScript — so the closed state is the faithful resting state.
 */
const bandHiddenCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		const id = section.id ?? theme?.id;
		if ( ! id || ! theme?.hidden || theme.hidden.length === 0 ) {
			return '';
		}
		return theme.hidden.map( ( selector ) => `[data-section-id="${ id }"] ${ selector }{display:none}` ).join( '' );
	} )
	.join( '' );

/**
 * The builder's presentation utilities, scoped to the band that uses them
 * (`text-center`, `padding-four-all`, `font-weight-600`, …).
 *
 * The sanitizer keeps the source's class names and the vendor sheet never
 * ships, so these are inert unless restated: virtuallyjamaica's HOW IT WORKS
 * steps rendered lower-case and left-aligned, and its coloured panels put the
 * copy flush against the edge. The table lives on the builder adapter
 * (`lib/bands.ts`), trimmed to the classes the page measured — so a Divi site
 * gets Divi's conventions and nothing else.
 */
const bandUtilityCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		const id = section.id ?? theme?.id;
		const utilities = theme?.utilities;
		if ( ! id || ! utilities ) {
			return '';
		}
		const scoped = `[data-section-id="${ id }"]`;
		return Object.entries( utilities )
			.map( ( [ name, utility ] ) => {
				const rules: string[] = [];
				if ( utility.base ) {
					rules.push( `${ scoped } .${ name }{${ utility.base }}` );
				}
				// Brando scopes a variant in the class name (`md-text-center`,
				// `xs-padding-40px-tb`) — re-state it on the template's own breakpoints.
				if ( utility.tablet ) {
					rules.push( `@media (max-width: 1024px){${ scoped } .${ name }{${ utility.tablet }}}` );
				}
				if ( utility.mobile ) {
					rules.push( `@media (max-width: 767px){${ scoped } .${ name }{${ utility.mobile }}}` );
				}
				return rules.join( '' );
			} )
			.join( '' );
	} )
	.join( '' );

/**
 * The MEASURED box of the classes a band keeps (`analyze --geometry`), scoped to
 * that band.
 *
 * A builder's spacing scale cannot be transcribed from class names — Brando's
 * `margin-four-bottom` is 7.8px on an icon and 21.6px on a paragraph, and
 * `padding-four-all` is 3.4rem on desktop but `40px 15.5938px` at 390px. The
 * computed padding/margin of each class (recorded only when it agrees across
 * every instance in the band) is the only faithful source, and the per-column
 * hashes Brando emits appear once, so the column padding the rebuild otherwise
 * loses arrives exactly.
 *
 * Emitted AFTER the utility pack on purpose: a measured value must outrank a
 * hand-authored approximation of the same class.
 */
/**
 * Per-ELEMENT surfaces + pinned stage heights (see `ForgeBandElement`).
 *
 * Raw builder bands keep the source's markup verbatim, so the structural path
 * selects the SAME node here — which is the only way to restore what the
 * vendor stylesheet painted per element (Flatsome's white tile cards, its red
 * block) and the box a stage was pinned to. `min-height` rather than `height`
 * keeps the measured stage while still letting copy grow.
 *
 * The path's `:nth-child()` segments give these rules a high specificity, so a
 * deep path outranks the arrangement shim without `!important`.
 *
 * The path is measured relative to the SOURCE band root, and the rebuild nests
 * that root exactly one level inside `.post-body`, so the rule is ANCHORED to a
 * direct child of the post body. Without the anchor the leading
 * `div:nth-child(2)` is a DESCENDANT selector: it also matched a `.text-box`'s
 * own first `<div>` and the banner's link overlay, so the band's surface (and
 * its pinned height) was painted over the hero photo and the whole page
 * flattened to one solid colour.
 */
const bandElementCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		const id = section.id ?? theme?.id;
		if ( ! id || ! theme?.elements || theme.elements.length === 0 ) {
			return '';
		}
		const scoped = `[data-section-id="${ id }"]`;
		// The path starts at the SOURCE band root's children, and the raw band
		// nests that root exactly one level inside `.post-body`. Anchoring it to a
		// direct child keeps the leading `div:nth-child(2)` a CHILD selector; as a
		// bare descendant selector it also matched a `.text-box`'s own first `<div>`
		// and the banner's link overlay, so the band's surface (and its pinned
		// height) was painted over the hero photo.
		const anchored = `${ scoped } .post-body > * > `;
		return theme.elements
			.map( ( element ) => {
				const heights =
					typeof element.height === 'number' ? { desktop: element.height } : ( element.height ?? {} );
				const widths =
					typeof element.width === 'number' ? { desktop: element.width } : ( element.width ?? {} );
				const base: string[] = [];
				if ( element.bg ) {
					base.push( element.bg );
				}
				// A translucent VEIL (Flatsome's `.overlay`) is its own fact: it sits ON
				// the surface rather than replacing it, so it never hides the photo.
				if ( element.veil ) {
					base.push( element.veil );
				}
				if ( element.fg ) {
					base.push( `color:${ element.fg }` );
				}
				// The measured WIDTH first: it is what gives a builder image its box at
				// all (the markup carries `width="1"`, and the vendor rule that sized
				// the wrapper is keyed by an id the source re-issues). A path survives.
				if ( widths.desktop ) {
					base.push( `width:${ widths.desktop }px` );
				}
				if ( heights.desktop ) {
					// The `--ds-col-min-h` bridge rides with the floor. A centred band's
					// wrapper rule out-ranks this path on specificity and re-states
					// `min-height: var(--ds-col-min-h, 0)`, so a pinned stage landed at 0
					// (both banners of a two-column band collapsed and their photos
					// disappeared). Publishing the same value on the measured element makes
					// that rule resolve to it, and the subtree reset below stops the
					// property inheriting a floor onto nested wrappers.
					base.push( `--ds-col-min-h:${ heights.desktop }px` );
					base.push( `min-height:${ heights.desktop }px` );
					// A pinned stage must beat the generic in-column banner fallback:
					// `aspect-ratio` resolves the used height from the WIDTH, and a larger
					// resolved height outranks `min-height`, so the measured 86px banner
					// inside a `row-full-width` still rendered at the 5:3 default (560px).
					base.push( 'aspect-ratio:auto' );
				}
				const rules: string[] = [];
				// The Flatsome media convention rides WITH the measured width, never
				// globally: the markup carries `width="1"`, so `.img-inner img{width:100%}`
				// is what makes the image visible at all — but applied to an UNSIZED
				// wrapper it would blow a 1px image up to the band width.
				if ( widths.desktop ) {
					rules.push( `${ anchored }${ element.path } .img-inner > img{width:100%;height:auto}` );
				}
				if ( base.length > 0 ) {
					rules.push( `${ anchored }${ element.path }{${ base.join( ';' ) }}` );
					if ( heights.desktop ) {
						rules.push( `${ anchored }${ element.path } > *{--ds-col-min-h:initial}` );
					}
				}
				// The card's ink must reach its TEXT, not just the box: the band's
				// measured heading rule sets `color` on `h1…h6` directly, which
				// outranks inheritance and left white headings on a light card.
				//
				// `a` and `button` are deliberately NOT forced: this path selector is
				// (0,3,3), so it outranks a band's measured state rule
				// `[data-section-id] a:hover` at (0,2,1). Forcing white there made a
				// link's base `border-color` resolve to `currentColor` — also white —
				// so hover/active changed nothing and the state gate read them as
				// lost. Interactive controls take their colour from the measured
				// base/hover rules instead, inheriting the card ink they sit in.
				if ( element.fg ) {
					rules.push(
						`${ anchored }${ element.path } :is(h1, h2, h3, h4, h5, h6, p, li, span){color:${ element.fg }}`
					);
				}
				if ( heights.tablet ) {
					rules.push(
						`@media (min-width: 768px) and (max-width: 1024px){${ anchored }${ element.path }{--ds-col-min-h:${ heights.tablet }px;min-height:${ heights.tablet }px}}`
					);
				}
				if ( heights.mobile ) {
					rules.push(
						`@media (max-width: 767px){${ anchored }${ element.path }{--ds-col-min-h:${ heights.mobile }px;min-height:${ heights.mobile }px}}`
					);
				}
				if ( widths.tablet ) {
					rules.push(
						`@media (min-width: 768px) and (max-width: 1024px){${ anchored }${ element.path }{width:${ widths.tablet }px}}`
					);
				}
				if ( widths.mobile ) {
					rules.push(
						`@media (max-width: 767px){${ anchored }${ element.path }{width:${ widths.mobile }px}}`
					);
				}
				return rules.join( '' );
			} )
			.join( '' );
	} )
	.join( '' );

/**
 * A POSITIONAL column fact (`col:nth-child(2)`) names a lane by its INDEX, and
 * the emitted scope is a DESCENDANT selector: `[data-section-id] .col:nth-child(2)`
 * also matches the second column of every NESTED row — a card grid drawn inside
 * the band's own lane. The outer lane's measured floor and inner padding then
 * land on cards that never had them: monicarajiv's accommodation band has three
 * card lanes that each took the 900px-wide first lane's 572px `min-height` and
 * its 49px inner padding, and a 2298px band rendered 3418px (2026-11-20).
 *
 * A lane is never nested inside another lane, so `:not(.col .col)` excludes
 * exactly the nested grid. A CLASS-keyed fact needs no guard: it names itself.
 */
const columnLane = ( name: string ): string =>
	name.startsWith( 'col:nth-child(' ) ? `${ name }:not(.col .col)` : name;

const bandBoxCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		const id = section.id ?? theme?.id;
		if ( ! id || ( ! theme?.box && ! theme?.media ) ) {
			return '';
		}
		const scoped = `[data-section-id="${ id }"]`;
		// `media` is the cropped-image height map: an IMAGE-only scope, because a
		// class can sit on a paragraph too (`padding-six-lr` does both) and the
		// fixed image height must never reach the text. The `.post-body` variant
		// exists to outrank the Flatsome shim's `.banner-bg > img { height:100% }`
		// (3 classes + element): without it a builder banner's measured 420px crop
		// lost to the shim and the band grew (accommodations, 2026-11-11).
		const emit = ( facts: Record< string, { base?: string; tablet?: string; mobile?: string } > | undefined, selectorPrefix: string ): string =>
			Object.entries( facts ?? {} )
				.map( ( [ name, fact ] ) => {
					const selectors =
						selectorPrefix === 'img'
							? `${ scoped } img.${ name }, ${ scoped } .post-body img.${ name }`
							: // The `.post-body .section-content .col` form exists to outrank the
							  // Flatsome shim's arrangement rules (4 classes): a measured box is
							  // the source's computed truth, so it must win over a fallback the
							  // shim guessed. Without it `aspect-ratio:auto` never reached the
							  // banner and the slider kept the 5:3 default.
							  `${ scoped } ${ selectorPrefix }.${ name }, ${ scoped } .post-body .section-content .col ${ selectorPrefix }.${ name }`;
					// A TOP-ONLY `padding` is the builder's height placeholder (`padding:350px
					// 0 0 0`); the shim's in-column aspect fallback would still resolve a
					// height from the width and outrank it (doomsday's 350px testimonial
					// slider rendered 630px at the 5:3 default). A measured placeholder
					// therefore switches the fallback off for that class.
					const measuredStage = /(^|;)padding:(?!0px )\S+ 0px 0px 0px/.test( fact.base ?? '' );
					const withStage = ( value: string | undefined ): string | undefined =>
						value && measuredStage ? `${ value };aspect-ratio:auto` : value;
					const rules: string[] = [];
					if ( fact.base ) {
						rules.push( `${ selectors }{${ withStage( fact.base ) }}` );
					}
					if ( fact.tablet ) {
						rules.push( `@media (min-width: 768px) and (max-width: 1024px){${ selectors }{${ withStage( fact.tablet ) }}}` );
					}
					if ( fact.mobile ) {
						rules.push( `@media (max-width: 767px){${ selectors }{${ withStage( fact.mobile ) }}}` );
					}
					return rules.join( '' );
				} )
				.join( '' );
		// The column INNER padding: the same map, pointed one level in.
		const innerCss = Object.entries( theme.columnInner ?? {} )
			.map( ( [ name, fact ] ) => {
				const selectors = `${ scoped } .post-body .${ columnLane( name ) } > .col-inner, ${ scoped } .${ columnLane( name ) } > .col-inner`;
				const rules: string[] = [];
				if ( fact.base ) {
					rules.push( `${ selectors }{${ fact.base }}` );
				}
				if ( fact.tablet ) {
					rules.push( `@media (min-width: 768px) and (max-width: 1024px){${ selectors }{${ fact.tablet }}}` );
				}
				if ( fact.mobile ) {
					rules.push( `@media (max-width: 767px){${ selectors }{${ fact.mobile }}}` );
				}
				return rules.join( '' );
			} )
			.join( '' );
		return `${ emit( theme.box, '' ) }${ emit( theme.media, 'img' ) }${ innerCss }`;
	} )
	.join( '' );

/**
 * The band's measured COLUMN geometry (`bandFacts.columns` → `columnBox`),
 * scoped to the band and keyed by the column's own class.
 *
 * Two facts the sanitized markup cannot carry: the rendered `min-height` floor
 * (the sanitizer drops inline layout) and a fixed background photo's
 * `background-attachment`/`size` (declared by the vendor sheet, which never
 * ships). virtuallyjamaica's HOW IT WORKS band is a 700px fixed-photo column
 * beside 948px of copy — without this the image column collapsed to its empty
 * wrapper and the photo scrolled.
 */
const bandColumnCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		const id = section.id ?? theme?.id;
		const columnBox = theme?.columnBox;
		if ( ! id || ! columnBox ) {
			return '';
		}
		const scoped = `[data-section-id="${ id }"]`;
		return Object.entries( columnBox )
			.map( ( [ name, fact ] ) => {
				// The `.post-body` form outranks the builder shim's photo-panel
				// `min-height` clamp (equal specificity today, order-dependent); the
				// plain form keeps a non-passthrough band working.
				const selector = `${ scoped } .post-body .${ columnLane( name ) }, ${ scoped } .${ columnLane( name ) }`;
				const rules: string[] = [];
				if ( fact.base ) {
					rules.push( `${ selector }{${ fact.base }}` );
				}
				if ( fact.tablet ) {
					rules.push( `@media (min-width: 768px) and (max-width: 1024px){${ selector }{${ fact.tablet }}}` );
				}
				if ( fact.mobile ) {
					rules.push( `@media (max-width: 767px){${ selector }{${ fact.mobile }}}` );
				}
				return rules.join( '' );
			} )
			.join( '' );
	} )
	.join( '' );

// A measured structure the SOURCE hides on a device end. The vendor class that
// says so (`elementor-hidden-mobile`) survives sanitisation but the stylesheet
// that gave it meaning never ships, so the rebuild showed eca.directory's matrix
// as a squeezed table at 390px where the source shows nothing.
const bandStructureCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		const id = section.id ?? theme?.id;
		const entries = theme?.structure ?? [];
		if ( ! id || entries.length === 0 ) {
			return '';
		}
		const scoped = `[data-section-id="${ id }"]`;
		const rules: string[] = [];
		for ( const entry of entries ) {
			const hidden = entry.data?.hiddenAt ?? [];
			if ( entry.type !== 'comparison' || hidden.length === 0 ) {
				continue;
			}
			const selector = `${ scoped } [data-structure="comparison"]`;
			if ( hidden.includes( 'tablet' ) ) {
				rules.push( `@media (min-width: 768px) and (max-width: 1024px){${ selector }{display:none}}` );
			}
			if ( hidden.includes( 'mobile' ) ) {
				rules.push( `@media (max-width: 767px){${ selector }{display:none}}` );
			}
		}
		return rules.join( '' );
	} )
	.join( '' );

/**
 * The band's measured LANE visibility (`design.sections[].columns[].hidden*`).
 *
 * A builder hides a whole lane per device (`elementor-hidden-mobile`). The class
 * survives sanitisation but the vendor stylesheet that gave it meaning never
 * ships — so the rebuild showed a lane the source hides. Hide by POSITION: the
 * rebuilt cards follow the source's document order, so lane i is the grid's i-th
 * child. Never reorder — the hidden lane still occupies its slot in the source's
 * reading order (and in the DOM, for crawlers).
 *
 * The breakpoints match `bandStructureCss` (and the structure gate): tablet is
 * 768–1024, mobile is <= 767, desktop is >= 1025.
 */
const bandLaneCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		const id = section.id ?? theme?.id;
		const lanes = theme?.columns ?? [];
		if ( ! id || lanes.length < 2 ) {
			return '';
		}
		const scoped = `[data-section-id="${ id }"]`;
		const rules: string[] = [];
		lanes.forEach( ( lane, laneIndex ) => {
			const selector = `${ scoped } .ds-grid > :nth-child(${ laneIndex + 1 })`;
			if ( lane.hiddenDesktop ) {
				rules.push( `@media (min-width: 1025px){${ selector }{display:none}}` );
			}
			if ( lane.hiddenTablet ) {
				rules.push( `@media (min-width: 768px) and (max-width: 1024px){${ selector }{display:none}}` );
			}
			if ( lane.hiddenMobile ) {
				rules.push( `@media (max-width: 767px){${ selector }{display:none}}` );
			}
		} );
		// The same lanes also state a per-device WIDTH. Elementor wraps a row when
		// the running total passes 100%, so the faithful grid fact is the first
		// row's TRACK COUNT — not a per-lane width, which would fight the grid
		// (see `lib/lane-tracks.ts`). Emitted as a property rather than a custom
		// property because `columnsFor` writes its count INLINE, which no stylesheet
		// rule could outrank.
		(
			[
				[ 'desktop', '(min-width: 1025px)' ],
				[ 'tablet', '(min-width: 768px) and (max-width: 1024px)' ],
				[ 'mobile', '(max-width: 767px)' ],
			] as const
		).forEach( ( [ device, media ] ) => {
			const tracks = laneTracks( lanes, device );
			if ( tracks === undefined ) {
				return;
			}
			rules.push( `@media ${ media }{${ scoped } .ds-grid{grid-template-columns:repeat(${ tracks },minmax(0,1fr))}}` );
		} );
		return rules.join( '' );
	} )
	.join( '' );

/**
 * A component band beside its measured media lane (`mediaLane`).
 *
 * Elementor puts the picture in one column and the copy in the other; the
 * component kinds render the copy full-width and the photo column disappears
 * (eca.directory's "Get in touch" form and "Why … makes a difference" benefits
 * row, 2026-11-25). One rule set for every such band, emitted once.
 *
 * On a phone the two columns STACK with the copy FIRST — the industry rule for
 * split sections is "message first, picture second" — so the media keeps DOM
 * order (content, then media) and is only re-ordered on the wide layout.
 */
const anySplitLane = sections.some( ( section, index ) => Boolean( mediaLane( themeFor( section, index ) ) ) );
/**
 * A RAW band's headings take the band's measured alignment.
 *
 * A `text` band ships the source's own markup, so none of the component rules
 * apply — and the source's centred CTA rebuilt with its headings flush left
 * (eca.directory's blog band measured 488px of left inset against the rebuild's
 * 104, 2026-11-25). The measured alignment already rides `--ds-title-align`.
 */
const textBandCss = sections.some( ( section ) => section.kind === 'text' || section.kind === 'raw' )
	? '.ds-text-band{text-align:var(--ds-title-align,inherit)}'
	: '';

const bandSplitCss =
	( anySplitLane
		? '.ds-band-split{display:grid;width:100%;grid-template-columns:var(--ds-split-ratio,minmax(0,1fr) minmax(0,1fr));gap:var(--ds-split-gap,clamp(1.5rem,3vw,3rem));align-items:stretch;max-width:var(--ds-measure,100%);margin-inline:auto}' +
			  '.ds-band-split[data-media-side="left"]>.ds-band-split__media{order:-1}' +
			  '.ds-band-split>.ds-section{max-width:none;padding-block:0}' +
			  '.ds-band-split__media{margin:0;min-height:0;overflow:hidden}' +
			  '.ds-band-split__media img{display:block;width:100%;height:100%;object-fit:cover}' +
			  // Stacked, the picture needs a box of its own: `height:100%` against an
			  // indefinite grid row resolves to auto, which collapsed the photo to its
			  // line box (invisible) on a phone (2026-11-25).
			  '@media (max-width:767px){.ds-band-split{grid-template-columns:minmax(0,1fr)}.ds-band-split[data-media-side="left"]>.ds-band-split__media{order:0}.ds-band-split__media{aspect-ratio:4/3}}'
			: '' );

/**
 * The MEASURED geometry of a two-lane band: the row's GAP and the copy lane's
 * inner MEASURE.
 *
 * The source states both in its own stylesheet — Elementor's `e-con` gap and a
 * widget's `__width-initial` — and neither ships. Without the gap the hero's
 * ratio was applied to the wrong track space (830/418 against the source's
 * 811/409); without the measure the lede ran the full 811px lane and wrapped a
 * line longer (eca.directory's about-us hero, 2026-11-25).
 *
 * Band-scoped on purpose: `global.css` cannot carry a per-band number, and the
 * template's `.ds-hero-split` gap would otherwise stay its own 2rem guess.
 */
const splitBandCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
