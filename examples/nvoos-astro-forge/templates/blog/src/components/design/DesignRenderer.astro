						<div class="ds-band-split" data-media-side={bandLane.side}>
							<BandBody
								section={section}
								kind={kind}
								theme={theme}
								columns={columnsFor(index, theme)}
								media={splitMedia}
								uid={section.id ?? String(index)}
							/>
							<figure class="ds-band-split__media">
								{/* Decorative by construction: the source paints it as a CSS background
								 * behind no text, so a null alt is the accessible choice (WAI). */}
								<img src={bandLane.src} alt="" loading="lazy" decoding="async" />
							</figure>
						</div>
					) : (
						<BandBody
							section={section}
							kind={kind}
							theme={theme}
							columns={columnsFor(index, theme)}
							media={splitMedia}
							uid={section.id ?? String(index)}
						/>
					)}
					{/* The band's MARK STRIP. A builder carousel publishes each logo as a
					 * `background-image` DIV, so no classifier (<img> only, and on
					 * sanitised HTML) can see it — the band rendered as its heading alone.
					 * Analyzer-measured, so it renders even though the classifier found
					 * no media; the band's own copy still renders above it, so nothing
					 * the source said is dropped. */}
					{theme?.logos && theme.logos.length > 0 && (() => {
						// A logo wall the source PAGED renders as a carousel: more marks than
						// fit at once, on a snapping track carrying the measured
						// slides-per-view and gutter. A static row stays a static row.
						const perView = theme.carousel?.perView ?? 0;
						const paged = perView > 1 && theme.logos.length > perView;
						return (
							<section class="ds-section ds-body">
								<div
									class:list={[ 'ds-logos', paged && 'ds-logos--carousel' ]}
									aria-label="Featured brands"
									style={paged ? `--ds-carousel-per:${ perView };--ds-carousel-gap:${ theme.carousel?.gap ?? 0 }px` : undefined}
								>
									{theme.logos.map((mark) => (
										<img src={mark.src} alt={mark.alt ?? ''} width="240" height="120" loading="lazy" />
									))}
								</div>
							</section>
						);
					})()}
					{/* MEASURED STRUCTURE (see `SectionTheme.structure`). A builder
					 * publishes each check and cross as an `<svg>`, and sanitisation strips
					 * every one — so the classifier can never see the table and this fact is
					 * measured at analyze time (eca.directory's "Compare User Roles": 52
					 * SVGs raw, 0 sanitised, classified as a 3-card feature grid).
					 *
					 * Rendered IN ADDITION to the band's own component, never instead of it:
					 * that band also carries three phase cards, and swapping the kind would
					 * delete them. The heading and links are the band's own — they already
					 * rendered above, so the structure renders without them. */}
					{( theme?.structure ?? [] ).map((entry) => {
						if ( entry.type !== 'comparison' || ! entry.data || section.kind === 'comparison' ) {
							return null;
						}
						return (
							<Comparison
								section={{
									...section,
									slots: { ...section.slots, title: undefined, links: undefined },
									comparison: entry.data,
								}}
								theme={theme}
							/>
						);
					})}
					{/* The typed fast path for a profile recorded before the channel
					 * existed (`SectionTheme.comparison`); the scaffold emits `structure`
					 * for both shapes, so this only fires on an un-regenerated project. */}
					{theme?.comparison && ! theme.structure && section.kind !== 'comparison' && (
						<Comparison
							section={{
								...section,
								slots: { ...section.slots, title: undefined, links: undefined },
								comparison: theme.comparison,
							}}
							theme={theme}
						/>
					)}
				</div>
			);
		})}
	</div>
)}
