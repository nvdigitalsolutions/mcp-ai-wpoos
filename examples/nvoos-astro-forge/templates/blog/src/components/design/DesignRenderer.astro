---
// DesignRenderer — the semantic renderer (Proposal 114 §3.2/§3.4, themed by
// 117 §2).
//
// Takes the ALREADY-sanitized entry body (page.body) and renders it through
// the semantic content model: classified builder sections rebuild as ADS
// design components; unclassified content falls back to the .post-body
// treatment (the sanitized substring, verbatim). No classification happens
// here — the vendored src/forge/semantic.ts owns that; this component only
// dispatches sections to components. Text is interpolated (escaped); only
// sanitized substrings pass through set:html.
//
// Theming (117 §2): the classifier carries each section's source Elementor id;
// sections.generated.ts maps that id to the source band's background facts and
// resolved theme. Every section renders inside a themed wrapper that
// re-applies the source band — dark navy bands, gray bands, and the hero
// photo with its overlay — so the rebuilt page keeps the source's visual
// rhythm without copying any markup.
import type { SemanticSection } from '../../forge/semantic.ts';
import { bandSpacing, bandSource, sections as sectionThemes, type SectionTheme } from '../../lib/sections.generated.ts';
import { behaviors } from '../../lib/behaviors.generated.ts';
import { classifyBody } from '../../lib/classify.ts';
import Cta from './Cta.astro';
import Catalog from './Catalog.astro';
import Comparison from './Comparison.astro';
import FeatureGrid from './FeatureGrid.astro';
import Form from './Form.astro';
import Gallery from './Gallery.astro';
import Hero from './Hero.astro';
import IconList from './IconList.astro';
import LogoCloud from './LogoCloud.astro';
import Marquee from './Marquee.astro';
import Pricing from './Pricing.astro';
import Stats from './Stats.astro';
import Steps from './Steps.astro';
import Team from './Team.astro';
import Testimonial from './Testimonial.astro';
import TextBlock from './TextBlock.astro';

/** A pre-classified wireframe section (Proposal 115) — the semantic section
 *  plus its per-breakpoint column behavior. */
interface WireframeSectionInput {
	section: SemanticSection;
	responsive?: { columns?: Record<string, number> };
}

interface Props {
	html?: string;
	/** Pre-classified wireframe sections — take precedence over `html` and
	 *  carry per-breakpoint column behavior (115 §4). */
	wireframeSections?: WireframeSectionInput[];
}

const { html = '', wireframeSections } = Astro.props;
const sections: SemanticSection[] = wireframeSections
	? wireframeSections.map( ( w ) => w.section )
	: classifyBody( html );
const columnsFor = ( index: number ): Record<string, number> | undefined => wireframeSections?.[ index ]?.responsive?.columns;
/**
 * The source band theme for a rebuilt section. Elementor sites match by the
 * classifier-carried section id. Outline-only sources (WPBakery/Brando…) carry
 * no ids at all, so `bandSource === 'outline'` maps them POSITIONALLY — the
 * rebuilt sections and the source bands both follow the page flow. Without the
 * positional pass those bands never themed, so the rebuild rendered template
 * defaults instead of the source's own surfaces (virtuallyjamaica's red hero).
 */
const themeFor = ( section: SemanticSection, index: number ): SectionTheme | undefined => {
	const byId = section.id ? sectionThemes.find( ( theme ) => theme.id === section.id ) : undefined;
	if ( byId ) {
		return byId;
	}
	return bandSource === 'outline' ? sectionThemes[ index ] : undefined;
};
/** The source scroll behavior for a section (Proposal 121) — sticky /
 * reveal / parallax, keyed by the same element id. */
const behaviorFor = ( section: SemanticSection ) =>
	section.id ? behaviors.entries.find( ( behavior ) => behavior.id === section.id ) : undefined;
const behaviorClasses = ( behavior: ReturnType<typeof behaviorFor> ): string[] => {
	if ( ! behavior ) {
		return [];
	}
	if ( behavior.kind === 'reveal' ) {
		return [ 'ds-reveal', `ds-reveal--${ behavior.effect ?? 'fade' }` ];
	}
	if ( behavior.kind === 'parallax' ) {
		return [ 'ds-parallax' ];
	}
	return [ 'ds-sticky' ];
};
/** The parallax travel range scales with the source's motion_fx speed. */
const parallaxStyle = ( behavior: ReturnType<typeof behaviorFor> ): string | undefined =>
	behavior?.kind === 'parallax' && behavior.speed !== undefined && behavior.speed > 1
		? `--ds-parallax-range:${ Math.min( behavior.speed, 4 ) * 24 }px`
		: undefined;
/** A band length (margin or padding) — one value, or a per-device map
 * (Elementor's scoped pulls and per-device band padding). */
type ResponsiveLength = string | { desktop?: string; tablet?: string; mobile?: string } | undefined;

/** The inline half of a band margin — only plain strings go inline. */
const marginInline = ( value: ResponsiveLength ): string | undefined =>
	typeof value === 'string' ? value : undefined;

/**
 * The stylesheet half of a band margin. Elementor scopes a pull to a device
 * range — jayainc's products band is 0px on desktop, 170px on tablet and 100px
 * on mobile — so a single inline value is unfaithful. A per-device map is
 * emitted entirely as CSS: an inline value would outrank the media queries.
 * Band padding uses the same contract (jayainc's 059421c: 125px desktop,
 * 100px tablet and mobile). Breakpoints match the template's (1025 desktop /
 * 768 tablet).
 */
const responsiveDeviceCss = ( id: string | undefined, property: string, value: ResponsiveLength ): string => {
	if ( ! id || typeof value !== 'object' || value === null ) {
		return '';
	}
	const scoped = `[data-section-id="${ id }"]`;
	return [
		value.desktop && `${ scoped }{${ property }:${ value.desktop }}`,
		value.tablet && `@media (max-width: 1024px){${ scoped }{${ property }:${ value.tablet }}}`,
		value.mobile && `@media (max-width: 767px){${ scoped }{${ property }:${ value.mobile }}}`,
	]
		.filter( Boolean )
		.join( '' );
};
// ---------------------------------------------------------------------------
// A band with no slots renders nothing (the templates only draw what the
// classifier found); `source` band spacing must not collapse those to 0px.
const sectionHasContent = ( section: SemanticSection ): boolean => {
	const { title, body, items, media } = section.slots ?? {};
	return Boolean(
		title ||
			( body && body.length > 0 ) ||
			( items && items.length > 0 ) ||
			( media && media.length > 0 ) ||
			// Proposal 136 structured slots — a kind is content too.
			( section.pricing?.plans.length ?? 0 ) > 0 ||
			( section.stats?.items.length ?? 0 ) > 0 ||
			( section.steps?.items.length ?? 0 ) > 0 ||
			( section.team?.people.length ?? 0 ) > 0 ||
			( section.marquee?.items.length ?? 0 ) > 0 ||
			( section.comparison?.rows.length ?? 0 ) > 0
	);
};

const wrapStyle = ( theme: SectionTheme | undefined, hasContent = true ): string | undefined => {
	if ( ! theme ) {
		return undefined;
	}
	const parts: string[] = [];
	// The boxed container measure + column gap (124 §3): the inner column
	// re-measures to the source's container width (jayainc's 1140px +
	// gap gutter), never the site measure — the band bg stays full-width.
	// Theme-agnostic: hero bands are boxed too.
	if ( theme.measure ) {
		parts.push( `--ds-measure:${ theme.measure }` );
	}
	if ( theme.paddingX ) {
		parts.push( `--ds-pad-x:${ theme.paddingX }` );
	}
	// The source band's declared padding (jayainc: the 100px bands vs the
	// flush content-tight bands) — inline wins over the wrap default. This runs
	// BEFORE the hero's early return: a hero band carries padding facts too.
	if ( theme.padding ) {
		// A per-device map is emitted as scoped CSS below (an inline padding
		// would outrank its media queries); only a plain shorthand goes inline.
		if ( typeof theme.padding === 'string' ) {
			parts.push( `padding:${ theme.padding }` );
		}
		// The source declares the band's rhythm — suppress the template's
		// default section padding so the bands meet their neighbors flush
		// (124 §5, the continuous flow).
		parts.push( '--ds-pad-y:0' );
	} else if ( bandSpacing === 'source' ) {
		// No padding fact = the source band is flush. `source` mode honours that
		// instead of the template's own rhythm. The wrap's padding comes from a
		// rule (--forge-space-4), NOT --ds-pad-y, so zero it explicitly.
		//
		// An EMPTY band is a spacer (jayainc's dff3f1a is 70px with no padding
		// fact and no content): zeroing it would render 0px and shift every
		// band below it. Those keep the wrap's rhythm and lose only the inner
		// section's, which would otherwise double-count it.
		parts.push( '--ds-pad-y:0' );
		if ( hasContent ) {
			parts.push( 'padding-top:0' );
			parts.push( 'padding-bottom:0' );
		}
	}
	// The band's MEASURED source height (114 §3.6) — a floor, never a lock: a
	// band whose rebuilt content is already taller keeps its own height. Placed
	// BEFORE the hero's early return below, because the hero band is exactly the
	// one a source height pins (virtuallyjamaica's full-screen contact band).
	// A per-device map is emitted as scoped CSS; only a plain value goes inline.
	if ( theme.minHeight && typeof theme.minHeight === 'string' ) {
		parts.push( `min-height:${ theme.minHeight }` );
	}
	if ( theme.theme === 'hero' ) {
		if ( theme.bgImage ) {
			parts.push( `background-image:url('${ theme.bgImage }')` );
		}
		// A color alongside the photo is the source's UNDERLAY (invisible
		// beneath an opaque image) — never paint it over the photo.
		if ( theme.bg && ! theme.bgImage ) {
			parts.push( `background-color:${ theme.bg }` );
		}
		if ( theme.overlay ) {
			parts.push( `--ds-overlay:${ theme.overlay }` );
		}
		return parts.length > 0 ? parts.join( ';' ) : undefined;
	}
	if ( theme.bg ) {
		parts.push( `background:${ theme.bg }` );
	}
	// Section-level pull facts (124 §4): negative margins overlap the
	// neighbor band; z-index stacks the overlap.
	if ( theme.marginTop ) {
		const marginTop = marginInline( theme.marginTop );
		if ( marginTop ) {
			parts.push( `margin-top:${ marginTop }` );
		}
	}
	if ( theme.marginBottom ) {
		const marginBottom = marginInline( theme.marginBottom );
		if ( marginBottom ) {
			parts.push( `margin-bottom:${ marginBottom }` );
		}
	}
	// The card box model (measured per band): Elementor cards are theme
	// components, so gap/padding come from measurement rather than any
	// band-scoped rule. Absent → the template's own card defaults.
	if ( theme.cardStyle ) {
		if ( theme.cardStyle.gap ) {
			parts.push( `--ds-card-gap:${ theme.cardStyle.gap }` );
		}
		if ( theme.cardStyle.padding ) {
			parts.push( `--ds-card-pad:${ theme.cardStyle.padding }` );
		}
		if ( theme.cardStyle.textPadding ) {
			parts.push( `--ds-card-text-pad:${ theme.cardStyle.textPadding }` );
		}
	}
	// The icon-row rhythm (measured per band): the source's list rows carry
	// their own inner padding, a large leading icon box and their own title
	// size. Absent → the template's own row defaults.
	if ( theme.iconRowStyle ) {
		const row = theme.iconRowStyle;
		if ( row.padTop ) {
			parts.push( `--ds-icon-row-pad-top:${ row.padTop }` );
		}
		if ( row.padBottom ) {
			parts.push( `--ds-icon-row-pad-bottom:${ row.padBottom }` );
		}
		if ( row.titleSize ) {
			parts.push( `--ds-icon-title-size:${ row.titleSize }` );
		}
		if ( row.titleLineHeight ) {
			parts.push( `--ds-icon-title-lh:${ row.titleLineHeight }` );
		}
		if ( row.markerSize ) {
			parts.push( `--ds-icon-marker-size:${ row.markerSize }` );
		}
		if ( row.markerGlyph ) {
			parts.push( `--ds-icon-marker-glyph:${ row.markerGlyph }` );
		}
		if ( row.markerBackground ) {
			parts.push( `--ds-icon-marker-bg:${ row.markerBackground }` );
		}
		if ( row.markerInk ) {
			parts.push( `--ds-icon-marker-ink:${ row.markerInk }` );
		}
	}
	if ( theme.zIndex ) {
		parts.push( `z-index:${ theme.zIndex }` );
	}
	// The column responsive facts (124 §6): the split components re-measure
	// from the source's per-device widths/order instead of the template's
	// fixed ratio (jayainc's services split is 50/50, not 5fr/7fr).
	const columns = theme.columns ?? [];
	// Exactly two: `--ds-split-ratio` feeds a two-lane grid (`.ds-hero-split`).
	// A three-lane band (services is 3/4/5) used to inherit a truncated
	// first-two-fr ratio here, which then applied 25/33 to a two-lane grid.
	if ( columns.length === 2 && columns[ 0 ].width && columns[ 1 ].width ) {
		parts.push( `--ds-split-ratio:minmax(0,${ columns[ 0 ].width / 100 }fr) minmax(0,${ columns[ 1 ].width / 100 }fr)` );
	}
	if ( columns.some( ( column ) => column.reverseMobile ) ) {
		parts.push( '--ds-icon-media-order:2' );
	}
	return parts.length > 0 ? parts.join( ';' ) : undefined;
};

// The per-device half of every band margin AND padding — emitted once, scoped
// by section id. A padding scoped to a device range needs the same CSS
// treatment as a scoped pull: an inline value would outrank the media queries.
const responsiveBandCss = sections
	.map( ( section, index ) => {
		const theme = themeFor( section, index );
		// The scoped selector must be the SAME id the wrap renders
		// (`section.id ?? theme.id`). Outline-band sources carry no section id of
		// their own, so keying off `section.id` alone emitted no rule at all and
		// every forged band silently fell back to the template's own padding.
		const id = section.id ?? theme?.id;
		return (
			responsiveDeviceCss( id, 'margin-top', theme?.marginTop ) +
			responsiveDeviceCss( id, 'margin-bottom', theme?.marginBottom ) +
			responsiveDeviceCss( id, 'padding', theme?.padding ) +
			responsiveDeviceCss( id, 'min-height', theme?.minHeight )
		);
	} )
	.join( '' );
---

{sections.length > 0 && (
	<div class="design-sections">
		{responsiveBandCss && <Fragment set:html={ `<style>${ responsiveBandCss }</style>` } />}
		{sections.map((section, index) => {
			const theme = themeFor(section, index);
			const behavior = behaviorFor(section);
			return (
				<div data-section={section.kind} data-section-id={section.id ?? theme?.id} id={theme?.anchor ?? section.anchor} class:list={['ds-section-wrap', theme && `ds-section-wrap--${theme.theme}`, ...behaviorClasses(behavior)]} style={[wrapStyle(theme, sectionHasContent(section) || Boolean(theme?.catalog)), parallaxStyle(behavior)].filter(Boolean).join(';')}>
					{theme?.catalog ? (
						<Catalog theme={theme} />
					) : (
						<>
							{section.kind === 'hero' && <Hero section={section} theme={theme} />}
							{section.kind === 'feature-grid' && <FeatureGrid section={section} columns={columnsFor(index)} theme={theme} />}
							{section.kind === 'icon-list' && <IconList section={section} columns={columnsFor(index)} theme={theme} />}
							{section.kind === 'testimonial' && <Testimonial section={section} />}
							{section.kind === 'logo-cloud' && <LogoCloud section={section} />}
							{section.kind === 'cta' && <Cta section={section} />}
							{section.kind === 'gallery' && <Gallery section={section} />}
							{section.kind === 'form' && <Form section={section} />}
							{section.kind === 'pricing' && <Pricing section={section} theme={theme} />}
							{section.kind === 'stats' && <Stats section={section} theme={theme} />}
							{section.kind === 'steps' && <Steps section={section} theme={theme} />}
							{section.kind === 'team' && <Team section={section} theme={theme} />}
							{section.kind === 'marquee' && <Marquee section={section} uid={section.id ?? index} />}
							{section.kind === 'comparison' && <Comparison section={section} theme={theme} />}
							{section.kind === 'text' && (section.html ? <div class="post-body ds-section" set:html={section.html} /> : <TextBlock section={section} theme={theme} />)}
							{section.kind === 'raw' && <div class="post-body ds-section" set:html={section.html ?? ''} />}
						</>
					)}
				</div>
			);
		})}
	</div>
)}
