---
// IconList — icon-list sections rebuilt as a card list.
// `columns` (Proposal 115 §4) drives the grid via per-breakpoint CSS custom
// properties — the wireframe's captured/inferred collapse behavior.
//
// Source-shaped rows: when every item's source layout fact is an icon-LEFT
// row (aux-ico-pos-left), the list rebuilds as stacked icon rows — the
// source's rhythm — instead of the icon-above card grid (the default for
// unclassified/stack-layout lists). Icon markers carry the source glyph
// classes (auxicon-*, fa fa-*, …); with the source's own icon stylesheet
// (chrome.iconCss) linked in the layout they draw the real glyphs.
import type { SemanticSection } from '../../forge/semantic.ts';
import IconMarker from './IconMarker.astro';

interface Props {
	section: SemanticSection;
	columns?: Record<string, number>;
}

const { section, columns } = Astro.props;
const { title, body, items, media } = section.slots;
const list = items ?? [];
const rows = list.length > 0 && list.every((item) => item.layout === 'row');
const gridStyle = !rows && columns
	? `--ds-cols-desktop: ${columns.desktop ?? 4}; --ds-cols-tablet: ${columns.tablet ?? 2}; --ds-cols-mobile: ${columns.mobile ?? 1};`
	: undefined;
---

<section class="ds-section">
	{media && media.length > 0 ? (
		<div class="ds-icon-split">
			<div class="ds-icon-media">
				{media.map((entry) => entry.src && <img src={entry.src} alt={entry.alt ?? title ?? ''} loading="lazy" width="400" height="600" />)}
			</div>
			<div class="ds-icon-content">
				{title && <h2 class="ds-title">{title}</h2>}
				{body && body.length > 0 && (
					<div class="ds-lede">
						{body.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
				)}
				{rows ? (
					<ul class="ds-icon-rows">
						{list.map((item) => (
							<li class="ds-icon-row">
								<IconMarker item={item} />
								<div class="ds-icon-row-text">
									{item.title && <h4>{item.title}</h4>}
									{item.body && <p>{item.body}</p>}
								</div>
							</li>
						))}
					</ul>
				) : (
					list.length > 0 && (
						<ul class="ds-grid post-list" style={gridStyle}>
							{list.map((item) => (
								<li class="ds-card">
									<IconMarker item={item} />
									{item.media?.src && <img src={item.media.src} alt={item.media.alt ?? item.title ?? ''} width="400" height="400" loading="lazy" />}
									{item.title && <h4>{item.title}</h4>}
									{item.body && <p>{item.body}</p>}
								</li>
							))}
						</ul>
					)
				)}
			</div>
		</div>
	) : (
		<>
			{title && <h2 class="ds-title">{title}</h2>}
			{body && body.length > 0 && (
				<div class="ds-lede">
					{body.map((paragraph) => (
						<p>{paragraph}</p>
					))}
				</div>
			)}
			{rows ? (
				<ul class="ds-icon-rows">
					{list.map((item) => (
						<li class="ds-icon-row">
							<IconMarker item={item} />
							<div class="ds-icon-row-text">
								{item.title && <h4>{item.title}</h4>}
								{item.body && <p>{item.body}</p>}
							</div>
						</li>
					))}
				</ul>
			) : (
				list.length > 0 && (
					<ul class="ds-grid post-list" style={gridStyle}>
						{list.map((item) => (
							<li class="ds-card">
								<IconMarker item={item} />
								{item.media?.src && <img src={item.media.src} alt={item.media.alt ?? item.title ?? ''} width="400" height="400" loading="lazy" />}
								{item.title && <h4>{item.title}</h4>}
								{item.body && <p>{item.body}</p>}
							</li>
						))}
					</ul>
				)
			)}
		</>
	)}
</section>
