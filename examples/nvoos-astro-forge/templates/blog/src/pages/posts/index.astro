---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
	.filter((post) => post.data.date)
	.sort((a, b) => b.data.date.localeCompare(a.data.date));
const truncated = posts.some((post) => post.data.truncated);
const pageUrl = Astro.site ? new URL('/posts/', Astro.site).href : undefined;
---

<Base title="Posts" description="All posts from the source site." canonical={pageUrl}>
	<h1>Posts</h1>
	{truncated && (
		<p class="notice">
			This build is incomplete: the source collection exceeded its page cap. Raise
			<code>maxPages</code> in the site profile and rebuild.
		</p>
	)}
	<ul class="post-list">
		{posts.map((post) => (
			<li>
				<a href={`/posts/${post.id}/${post.data.slug}/`}>{post.data.title}</a>
				{post.data.excerpt && <div set:html={post.data.excerpt} />}
				<time datetime={post.data.date}>{post.data.date.slice(0, 10)}</time>
			</li>
		))}
	</ul>
</Base>
