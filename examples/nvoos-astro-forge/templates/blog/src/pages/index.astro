---
import Base from '../layouts/Base.astro';
import manifest from '../../nvoos.json';
import { getCollection, render } from 'astro:content';
import DesignRenderer from '../components/design/DesignRenderer.astro';
import { jsonLdFor, renderJsonLd } from '../lib/seo.ts';
import { buildGraph } from '../lib/seo-graph.ts';

// A WordPress static front page (page_on_front) renders at `/`; otherwise
// the template falls back to the blog-style home.
const frontPageSlug = manifest.frontPage;
const pages = await getCollection('pages');
const frontPage = frontPageSlug ? pages.find((page) => page.data.slug === frontPageSlug) : undefined;
const frontContent = frontPage ? await render(frontPage) : undefined;
// The loader's rendered.html — the sanitized body the semantic renderer
// classifies (entry.body is not populated by the content store).
const frontBody = frontPage?.rendered?.html;

const posts = (await getCollection('posts'))
	.filter((post) => post.data.date)
	.sort((a, b) => b.data.date.localeCompare(a.data.date));
const truncated = posts.some((post) => post.data.truncated);
const latest = posts.slice(0, 3);
// 131 §2.3 — the homepage carries the site graph (Organization + WebSite +
// SearchAction) with a WebPage node. SEO meta from the front page when it has
// any (an absent SEO plugin leaves the fallbacks in place).
const homeUrl = Astro.site ? new URL('/', Astro.site).href : undefined;
const jsonLd = buildGraph(
	Astro.site,
	jsonLdFor('WebPage', {
		url: homeUrl,
		title: frontPage?.data.seoTitle ?? manifest.name,
		description: frontPage?.data.seoDescription ?? frontPage?.data.excerpt,
	})
);
// The front page's description: the page's own SEO description, then the
// source's captured head description (131 §2.5 — wp/v2 does not expose Rank
// Math's on every install), then the WordPress excerpt. Without this the front
// page emitted no <meta name="description"> at all, while [slug].astro did.
const frontDescription =
	frontPage?.data.seoDescription || manifest.seoDescription || frontPage?.data.excerpt;
---

<Base
	title="Home"
	description={frontDescription}
	seo={frontPage?.data.seo}
>
	{frontPage && frontBody ? (
		<DesignRenderer html={frontBody} />
	) : frontPage && frontContent ? (
		<div class="post-body">
			<frontContent.Content />
		</div>
	) : (
		<>
			<section class="hero">
				<h1>Welcome</h1>
				<p>This frontend is generated from WordPress content with the NV oOS Astro Forge.</p>
			</section>
			{truncated && (
				<p class="notice">
					This build is incomplete: the source collection exceeded its page cap. Raise
					<code>maxPages</code> in the site profile and rebuild.
				</p>
			)}
			<section>
				<h2>Latest posts</h2>
				<ul class="post-list">
					{latest.map((post) => (
						<li>
							<a href={`/posts/${post.id}/${post.data.slug}/`}>{post.data.title}</a>
							<time datetime={post.data.date}>{post.data.date.slice(0, 10)}</time>
						</li>
					))}
				</ul>
				<p><a href="/posts/">All posts</a></p>
			</section>
		</>
	)}
	<script type="application/ld+json" set:html={renderJsonLd(jsonLd)} />
</Base>
