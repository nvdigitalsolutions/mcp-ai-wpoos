---
import Base from '../layouts/Base.astro';
import manifest from '../../nvoos.json';
import { getCollection, render } from 'astro:content';
import DesignRenderer from '../components/design/DesignRenderer.astro';

// A WordPress static front page (page_on_front) renders at `/`; otherwise
// the template falls back to the blog-style home.
const frontPageSlug = manifest.frontPage;
const pages = await getCollection('pages');
const frontPage = frontPageSlug ? pages.find((page) => page.data.slug === frontPageSlug) : undefined;
const frontContent = frontPage ? await render(frontPage) : undefined;
// The loader's rendered.html — the sanitized body the semantic renderer
// classifies (entry.body is not populated by the content store).
const frontBody = frontPage?.rendered?.html;

const posts = (await getCollection('posts'))
	.filter((post) => post.data.date)
	.sort((a, b) => b.data.date.localeCompare(a.data.date));
const truncated = posts.some((post) => post.data.truncated);
const latest = posts.slice(0, 3);
---

<Base title="Home">
	{frontPage && frontBody ? (
		<DesignRenderer html={frontBody} />
	) : frontPage && frontContent ? (
		<div class="post-body">
			<frontContent.Content />
		</div>
	) : (
		<>
			<section class="hero">
				<h1>Welcome</h1>
				<p>This frontend is generated from WordPress content with the NV oOS Astro Forge.</p>
			</section>
			{truncated && (
				<p class="notice">
					This build is incomplete: the source collection exceeded its page cap. Raise
					<code>maxPages</code> in the site profile and rebuild.
				</p>
			)}
			<section>
				<h2>Latest posts</h2>
				<ul class="post-list">
					{latest.map((post) => (
						<li>
							<a href={`/posts/${post.id}/${post.data.slug}/`}>{post.data.title}</a>
							<time datetime={post.data.date}>{post.data.date.slice(0, 10)}</time>
						</li>
					))}
				</ul>
				<p><a href="/posts/">All posts</a></p>
			</section>
		</>
	)}
</Base>
