---
// /{slug}/ — one WordPress page. The static front page (manifest.frontPage)
// renders at `/` instead, so it is skipped here to keep one canonical URL.
import Base from '../layouts/Base.astro';
import manifest from '../../nvoos.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const pages = await getCollection('pages');
	return pages
		.filter((page) => page.data.slug !== manifest.frontPage)
		.map((page) => ({
			params: { slug: page.data.slug },
			props: { page },
		}));
}

const { page } = Astro.props;
const { Content } = await render(page);
const pageUrl = Astro.site ? new URL(`/${page.data.slug}/`, Astro.site).href : undefined;
---

<Base title={page.data.title} canonical={pageUrl}>
	<article class="post">
		<h1>{page.data.title}</h1>
		<div class="post-body">
			<Content />
		</div>
	</article>
</Base>
