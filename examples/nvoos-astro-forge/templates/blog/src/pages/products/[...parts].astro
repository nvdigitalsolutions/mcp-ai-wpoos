---
// /products/{id}/{slug}/ — one product, with commerce data when the source
// exposes it (wc/v3). Sanitized description HTML; Product JSON-LD.
import Base from '../../layouts/Base.astro';
import SmartImage from '../../components/SmartImage.astro';
import { getCollection, render } from 'astro:content';
import { jsonLdFor, renderJsonLd } from '../../lib/seo.ts';
import { buildGraph, homeCrumb } from '../../lib/seo-graph.ts';

export async function getStaticPaths() {
	const products = await getCollection('products');
	// Astro 7 spread params are flat slash-joined strings, not arrays.
	return products.map((product) => ({
		params: { parts: `${product.id}/${product.data.slug}` },
		props: { product },
	}));
}

const { product } = Astro.props;
const { Content } = await render(product);
const pageUrl = Astro.site ? new URL(`/products/${product.id}/${product.data.slug}/`, Astro.site).href : undefined;
// SEO meta from the source (the 131 sidecar merges the product CPT's
// Rank Math/Yoast fields into the wc/v3 document).
const seoTitle = product.data.seoTitle ?? product.data.title;
const seoDescription = product.data.seoDescription ?? product.data.excerpt;
// Woo sets `price` to the sale price when on sale — sale state is
// salePrice vs regularPrice, not vs price.
const onSale = product.data.salePrice && product.data.regularPrice
	? product.data.salePrice !== product.data.regularPrice
	: false;
const offers = product.data.price
	? {
			price: onSale ? product.data.salePrice : product.data.price,
			priceCurrency: 'USD',
			availability:
				product.data.stockStatus === 'instock'
					? ('https://schema.org/InStock' as const)
					: ('https://schema.org/OutOfStock' as const),
			url: pageUrl,
		}
	: undefined;
const jsonLd = buildGraph(
	Astro.site,
	jsonLdFor('Product', {
		// The schema node keeps the PRODUCT name/description — the SEO title is
		// for <title>/social only, not structured data.
		name: product.data.title,
		image: product.data.featuredImage,
		description: product.data.excerpt,
		sku: product.data.sku,
		...(offers ? { offers } : {}),
	}),
	[
		...homeCrumb(Astro.site),
		...(Astro.site ? [ { name: 'Products', url: new URL('/products/', Astro.site).href } ] : []),
		...(pageUrl ? [ { name: seoTitle, url: pageUrl } ] : []),
	]
);
---

<Base title={seoTitle} description={seoDescription} canonical={pageUrl} seo={product.data.seo}>
	<article class="post product">
		<header>
			<h1>{product.data.title}</h1>
			{product.data.sku && <span>SKU {product.data.sku}</span>}
		</header>
		{product.data.featuredImage && (
			<SmartImage class="featured" src={product.data.featuredImage} sizes="(min-width: 48rem) 72ch, 100vw" />
		)}
		{product.data.price && (
			<p class="product-price product-price-large">
				{onSale ? (
					<>
						<s>{product.data.regularPrice}</s> {product.data.salePrice}
					</>
				) : (
					product.data.price
				)}
				{product.data.stockStatus === 'instock' && <span class="product-stock">In stock</span>}
				{product.data.stockStatus && product.data.stockStatus !== 'instock' && (
					<span class="product-stock product-stock-muted">{product.data.stockStatus}</span>
				)}
			</p>
		)}
		<div class="post-body">
			<Content />
		</div>
	</article>
	<script type="application/ld+json" set:html={renderJsonLd(jsonLd)} />
</Base>
