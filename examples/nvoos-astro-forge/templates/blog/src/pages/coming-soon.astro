---
// SPDX-License-Identifier: MIT
/**
 * @fileoverview The pre-launch holding page served while the CMS is in coming-soon mode.
 *
 * Invariant: self-contained and script-free — no site stylesheet, no analytics,
 * no meta refresh — so it renders even when the real site cannot. Props: none.
 */
// ---------------------------------------------------------------------------
// /coming-soon/ — the pre-launch holding page (Proposal 165).
//
// PRERENDERED on purpose: the managed front controller (forge-gate/runtime.mjs)
// answers BEFORE Astro runs, so it serves dist/client/coming-soon/index.html
// directly. A page that rendered per request would never be seen.
//
// No site chrome, no nav, no analytics: this is what a visitor sees when the
// CMS says "coming soon". `noindex` unless the profile sets
// `gatePublish.comingSoon.indexable`.
// ---------------------------------------------------------------------------
export const prerender = true;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Coming soon</title>
		<style>
			:root {
				color-scheme: light dark;
				--g-surface: #ffffff;
				--g-ink: #1d2327;
				--g-muted: #50575e;
				--g-line: #dcdcde;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--g-surface: #14181d;
					--g-ink: #f2f3f4;
					--g-muted: #b6bcc4;
					--g-line: #333a42;
				}
			}
			* { box-sizing: border-box; }
			html, body { margin: 0; padding: 0; }
			body {
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 32px 20px;
				background: var(--g-surface);
				color: var(--g-ink);
				font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
				line-height: 1.6;
			}
			main { width: 100%; max-width: 34rem; text-align: center; }
			.eyebrow {
				margin: 0 0 12px;
				font-size: 12px;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--g-muted);
			}
			h1 { margin: 0 0 12px; font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.15; }
			p { margin: 0; color: var(--g-muted); }
			.rule {
				width: 3rem;
				height: 2px;
				margin: 24px auto 0;
				background: var(--g-line);
			}
		</style>
	</head>
	<body>
		<main>
			<p class="eyebrow">Coming soon</p>
			<h1>We are putting the finishing touches on this site</h1>
			<p>Please check back shortly.</p>
			<div class="rule" aria-hidden="true"></div>
		</main>
	</body>
</html>
