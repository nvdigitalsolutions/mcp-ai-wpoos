{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@nvoos/pro-spa-v2/*": ["../../addons/pro/assets/spa-v2/src/*"],
      "@wordpress/i18n": ["src/shims/wp-i18n.ts"],
      "react": ["node_modules/@types/react"],
      "react-dom": ["node_modules/@types/react-dom"],
      "react-router-dom": ["node_modules/react-router-dom"],
      "react-router-dom/*": ["node_modules/react-router-dom/*"],
      "zustand": ["node_modules/zustand"],
      "zustand/*": ["node_modules/zustand/*"],
      "@ai-sdk/react": ["node_modules/@ai-sdk/react"],
      "@ai-sdk/react/*": ["node_modules/@ai-sdk/react/*"],
      "marked": ["node_modules/marked"],
      "dompurify": ["node_modules/dompurify"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
