# Standalone Pro SPA — build-time environment.
# Copy to .env (gitignored) and uncomment what you need. All NVOOS_* values
# below are baked into the client bundle at build time — rebuild after
# changing them.

# --- Login preset (HOME) -----------------------------------------------------
# Unset -> the full connection screen (all auth modes + media worker fields).
# 1     -> Cookie (dev proxy) only: full admin surface, log in through the app.
# 2     -> WordPress application password only (cross-origin).
# 3     -> Assistant credential only (cross-origin, no cookies).
# 4     -> Preconfigured: the whole connection comes from env vars, Connect only.
#HOME=1

# --- Connection (used by the preset pages) ------------------------------------
#NVOOS_SITE_URL=https://nvoos.pro
#NVOOS_ASSISTANT_CREDENTIAL=cred_xxxxx.SECRET       # presets 3 and 4
#NVOOS_WP_USERNAME=admin                            # preset 2 (and preset 4 fallback)
#NVOOS_WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Design Stack media worker -------------------------------------------------
# Preset pages hide the worker fields and attach the worker from env instead.
#NVOOS_WORKER_URL=https://media-worker.example.com
#NVOOS_WORKER_TOKEN=replace-me

# --- Auto-connect (kiosk deployments) -----------------------------------------
# 1 = HOME=4 connects automatically on load (no click). Pair with edge access
# control (Cloudflare Access / IP allowlist) when publicly reachable.
#NVOOS_AUTO_CONNECT=1

# --- Existing settings ----------------------------------------------------------
#VITE_DEFAULT_SITE_URL=https://nvoos.pro            # pre-fills the default screen
#NVOOS_TARGET_SITE=http://localhost:8000            # dev/production proxy target (cookie mode)

# NOTE: when the app runs under scripts/serve.mjs (production/Velocity), the
# NVOOS_* values above can ALSO be set in the RUNTIME environment — they are
# injected into the served HTML and override the baked build-time values
# without a redeploy. The build-time .env values stay the fallback.
