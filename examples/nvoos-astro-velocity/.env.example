# ---------------------------------------------------------------------------
# Build-time env (used by `astro build` getStaticPaths + fixture recording).
# Runtime SSR binds to the same-origin /api proxy and needs none of these.
# ---------------------------------------------------------------------------

# Full base URL of the NV commerce contract (build/CI fixture target).
NVOOS_API_BASE=http://localhost:8123/wp-json/nvoos-commerce/v1

# Backend origin the BFF proxies (serve.mjs).
NVOOS_TARGET_SITE=http://localhost:8123

# Public API base for client-side islands (default: same-origin /api proxy).
# Set this only for `astro dev` (no BFF in dev):
# PUBLIC_API_BASE=http://localhost:8123/wp-json/nvoos-commerce/v1

# Canonical host for sitemap/robots/canonical tags.
ASTRO_SITE=https://store.nvoos.cloud

# Currency for price formatting + JSON-LD (Q7: USD default).
NVOOS_CURRENCY=USD

# BFF listen port (Velocity injects PORT).
PORT=4321

# ---------------------------------------------------------------------------
# Public form delivery — /forms/submit (Proposal 138).
#
# Provider HTTP API, not SMTP: see
# .agents/skills/mcp-ai-wpoos-astro-forge/reference/email-delivery.md
# Leave these unset to disable sending; the endpoint then returns 502 and logs
# instead of silently dropping enquiries.
#
# MAIL_FROM must be an address on the PROVIDER-AUTHENTICATED domain (SPF + DKIM
# + DMARC aligned), never a site-only mailbox — authentication decides inbox vs
# spam, not the API call.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=brevo
MAIL_FROM=forms@mail.example.com
MAIL_FROM_NAME=NV Store
MAIL_TO=hello@example.com
MAIL_SUBJECT=New website enquiry
# BREVO_API_KEY=
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=

# Public fallback address shown on /contact.
PUBLIC_CONTACT_EMAIL=hello@example.com
