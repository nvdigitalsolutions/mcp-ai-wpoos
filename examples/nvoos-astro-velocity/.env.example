# ---------------------------------------------------------------------------
# Build-time env (used by `astro build` getStaticPaths + fixture recording).
# Runtime SSR binds to the same-origin /api proxy and needs none of these.
# ---------------------------------------------------------------------------

# Full base URL of the NV commerce contract (build/CI fixture target).
NVOOS_API_BASE=http://localhost:8123/wp-json/nvoos-commerce/v1

# Backend origin the BFF proxies (serve.mjs).
NVOOS_TARGET_SITE=http://localhost:8123

# Public API base for client-side islands (default: same-origin /api proxy).
# Set this only for `astro dev` (no BFF in dev):
# PUBLIC_API_BASE=http://localhost:8123/wp-json/nvoos-commerce/v1

# Canonical host for sitemap/robots/canonical tags.
ASTRO_SITE=https://store.nvoos.cloud

# Currency for price formatting + JSON-LD (Q7: USD default).
NVOOS_CURRENCY=USD

# BFF listen port (Velocity injects PORT).
PORT=4321
