{
	"$comment": "Proposal 095 — NV oOS Astro Design System (ADS) core layer. Primitives only: palette, radii, spacing scale, typography. Keep in sync with src/lib/tokens/dtcg.ts validation rules.",
	"palette": {
		"ink": { "$type": "color", "$value": "#1a1a1a", "$description": "Near-black ink (matches the legacy --nv-ink)" },
		"muted": { "$type": "color", "$value": "#6b6b6b", "$description": "Muted text (matches the legacy --nv-muted)" },
		"surface": { "$type": "color", "$value": "#ffffff", "$description": "Primary surface (matches the legacy --nv-surface)" },
		"surface-alt": { "$type": "color", "$value": "#f5f5f4", "$description": "Alternate surface (matches the legacy --nv-surface-alt)" },
		"line": { "$type": "color", "$value": "#e4e4e2", "$description": "Hairline/border (matches the legacy --nv-line)" },
		"line-strong": { "$type": "color", "$value": "#767676", "$description": "Strong border for form fields (SC 1.4.11 3:1). Additive — not referenced by legacy aliases, so the 092 look is preserved." },
		"accent": { "$type": "color", "$value": "#0f6b4f", "$description": "Brand accent (matches the legacy --nv-accent)" },
		"accent-ink": { "$type": "color", "$value": "#ffffff", "$description": "Text on accent (matches the legacy --nv-accent-ink)" },
		"danger": { "$type": "color", "$value": "#b3261e", "$description": "Danger/promo (matches the legacy --nv-danger)" }
	},
	"radius": {
		"sm": { "$type": "dimension", "$value": "4px" },
		"md": { "$type": "dimension", "$value": "8px", "$description": "Matches the legacy --nv-radius" }
	},
	"space": {
		"xs": { "$type": "dimension", "$value": "0.25rem" },
		"sm": { "$type": "dimension", "$value": "0.5rem" },
		"md": { "$type": "dimension", "$value": "1rem", "$description": "Matches the legacy --nv-space" },
		"lg": { "$type": "dimension", "$value": "1.5rem" },
		"xl": { "$type": "dimension", "$value": "2rem" },
		"xxl": { "$type": "dimension", "$value": "3rem" },
		"gutter-fluid": {
			"$type": "dimension",
			"$value": "clamp(1rem, 0.5rem + 2vw, 2rem)",
			"$description": "Fluid page gutter (Utopia-style clamp). Additive — not referenced by legacy aliases, so the 092 look is preserved."
		}
	},
	"type": {
		"family-body": {
			"$type": "fontFamily",
			"$value": ["system-ui", "-apple-system", "'Segoe UI'", "Roboto", "sans-serif"],
			"$description": "Matches the legacy --nv-font"
		},
		"size-xs": { "$type": "dimension", "$value": "0.75rem" },
		"size-sm": { "$type": "dimension", "$value": "0.9rem" },
		"size-md": { "$type": "dimension", "$value": "1rem" },
		"size-lg": { "$type": "dimension", "$value": "1.15rem" },
		"size-xl": { "$type": "dimension", "$value": "1.6rem" },
		"size-fluid-display": {
			"$type": "dimension",
			"$value": "clamp(1.75rem, 1.2rem + 2.5vw, 2.75rem)",
			"$description": "Fluid display size. Additive — not referenced by legacy aliases."
		},
		"leading-body": { "$type": "dimension", "$value": "1.6", "$description": "Unitless line-height (matches the legacy body line-height)" }
	}
}
