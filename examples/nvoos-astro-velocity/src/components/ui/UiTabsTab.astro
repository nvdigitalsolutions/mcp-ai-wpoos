---
// UiTabsTab.astro — one tab button. Adapted from
// `accessible-astro-components` (Incluud), MIT; styling re-tokenized onto ADS.
interface Props {
	class?: string;
	/** Unique identifier for the tab. */
	id: string;
	/** ID of the panel this tab controls. */
	controls: string;
	/** Whether this tab is currently selected. @default false */
	selected?: boolean;
	[key: string]: unknown;
}

const { class: className, id, controls, selected = false, ...rest } = Astro.props;
---

<button
	id={id}
	role="tab"
	class:list={['ui-tabs-tab', className]}
	aria-controls={controls}
	aria-selected={selected}
	tabindex={selected ? 0 : -1}
	{...rest}
>
	<slot />
</button>

<style>
	:where(.ui-tabs-tab) {
		--transition-duration: 0.2s;
		--transition-easing: cubic-bezier(0.165, 0.84, 0.44, 1);

		flex-grow: 1;
		cursor: pointer;
		border: 2px solid var(--nv-line);
		border-radius: var(--nv-radius);
		background-color: transparent;
		padding-inline: 1rem;
		padding-block: 0.85rem;
		color: var(--nv-ink);
		font-weight: 700;
		font-size: 1.125rem;
		text-align: center;
	}

	@media (prefers-reduced-motion: no-preference) {
		:where(.ui-tabs-tab) {
			transition: all var(--transition-duration) var(--transition-easing);
		}
	}

	:where(.ui-tabs-tab:hover) {
		box-shadow: 0 0 0 0.25rem var(--nv-surface-alt);
	}

	:where(.ui-tabs-tab:focus-visible) {
		outline: none;
		box-shadow: var(--ads-semantic-focus-ring);
	}

	:where(.ui-tabs-tab[aria-selected='true']) {
		background-color: var(--nv-accent);
		color: var(--nv-accent-ink);
	}

	@media (min-width: 31.25rem) {
		:where(.ui-tabs-tab) {
			border-block-end: 0;
			border-end-start-radius: 0;
			border-end-end-radius: 0;
		}
	}
</style>
