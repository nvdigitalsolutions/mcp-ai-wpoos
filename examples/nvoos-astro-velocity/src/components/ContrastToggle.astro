---
// ---------------------------------------------------------------------------
// ContrastToggle — high-contrast axis (Proposal 104, Accessible Starter
// pattern). Independent of the theme: sets data-contrast="high" on <html>,
// which overrides muted text → full ink and line → line-strong (the WCAG
// 2.2 contrast axes already in the ADS semantic layer).
//
// Proposal 105 §3: when the policy forces the contrast axis, the toggle
// disables (aria-disabled), the label shows the forced mode and a visible
// note explains the override — the guard lives inside the EXISTING
// document-delegated handler (no new bindings, the 104 Defect A lesson).
// ---------------------------------------------------------------------------
---
<div class="contrast-toggle-root">
	<button
		class="contrast-toggle"
		type="button"
		data-contrast-toggle
		aria-label="Toggle high contrast"
		aria-pressed="false"
	>
		<span data-contrast-label>Contrast</span>
	</button>
	<span class="contrast-toggle__note" data-contrast-forced-note hidden>Contrast is set by the store</span>
</div>

<style>
	.contrast-toggle-root {
		position: relative;
	}

	.contrast-toggle {
		border: 1px solid var(--nv-line);
		background: transparent;
		color: var(--nv-ink);
		font: inherit;
		font-size: 0.85rem;
		padding: 0.25rem 0.6rem;
		border-radius: var(--nv-radius);
		cursor: pointer;
	}

	.contrast-toggle:disabled {
		cursor: not-allowed;
		opacity: 0.65;
	}

	.contrast-toggle__note {
		position: absolute;
		top: calc(100% + 0.35rem);
		right: 0;
		font-size: 0.75rem;
		color: var(--nv-muted);
		white-space: nowrap;
	}

	.contrast-toggle__note[hidden] {
		display: none;
	}
</style>

<script>
	import { applyContrast, persistContrast } from '../lib/theme/theme';

	function current(): 'standard' | 'high' {
		try {
			return localStorage.getItem('nvoos-contrast') === 'high' ? 'high' : 'standard';
		} catch {
			return 'standard';
		}
	}

	/** The policy payload inlined by the layout (Proposal 105 §3). */
	function readPolicy(): { resolved?: { contrastForced?: boolean; contrast?: string } } | null {
		try {
			const node = document.querySelector('script[data-theme-policy]');
			if (!node) {
				return null;
			}
			return JSON.parse(node.textContent || 'null');
		} catch {
			/* malformed policy payload */
		}
		return null;
	}

	/** The forced contrast mode, or null when the policy leaves it open. */
	function forcedContrast(): 'standard' | 'high' | null {
		const resolved = readPolicy()?.resolved;
		if (!resolved || !resolved.contrastForced) {
			return null;
		}
		return resolved.contrast === 'high' ? 'high' : 'standard';
	}

	function sync(): void {
		const forced = forcedContrast();
		const high = forced ? forced === 'high' : current() === 'high';
		applyContrast(high ? 'high' : 'standard');
		const toggle = document.querySelector<HTMLButtonElement>('[data-contrast-toggle]');
		if (toggle) {
			if (forced) {
				toggle.disabled = true;
				toggle.setAttribute('aria-disabled', 'true');
			} else {
				toggle.disabled = false;
				toggle.removeAttribute('aria-disabled');
			}
			toggle.setAttribute('aria-pressed', String(high));
		}
		const label = document.querySelector('[data-contrast-label]');
		if (label) {
			label.textContent = high ? 'High contrast' : 'Contrast';
		}
		const note = document.querySelector<HTMLElement>('[data-contrast-forced-note]');
		if (note) {
			note.hidden = !forced;
		}
	}

	// Bundled scripts run once per FULL load — delegate the click on document
	// (survives the ClientRouter swap) and re-sync on every swap, mirroring
	// the ThemeToggle pattern (Proposal 104 Defect A).
	document.addEventListener('click', (event) => {
		const target = event.target as Element | null;
		if (target?.closest('[data-contrast-toggle]')) {
			// Forced policy guard (105 §3): the store owns the contrast axis.
			if (forcedContrast()) {
				return;
			}
			persistContrast(current() === 'high' ? 'standard' : 'high', localStorage);
			sync();
		}
	});

	document.addEventListener('astro:after-swap', sync);
	sync();
</script>
