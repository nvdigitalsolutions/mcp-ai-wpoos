---
// ---------------------------------------------------------------------------
// Model3D custom block — poster-first 3D product viewer, ZERO hydration.
//
// The poster <img> is the entire contract for a no-JS / reduced-data visitor:
// it is what the HTML ships, what paints first, and what stays on screen if
// the runtime never arrives. <model-viewer> is a CUSTOM ELEMENT, so it needs
// no `client:` directive — putting an island here would ship a framework
// runtime for a viewer that has none.
//
// `loading="lazy"` is right for a below-the-fold band (the normal case on a
// PDP). For an above-the-fold hero, flip the poster to eager — a lazy LCP
// image is a measured regression.
//
// Assets stay self-hosted: a third-party CDN origin would fail check:policy
// and break the prod-sim. Budgets live in tests/e2e/model-3d.spec.ts; prepare
// models with scripts/optimize-glb.mjs (textures → draw calls → triangles).
//
// Runtime (one-off, self-hosted — never a CDN):
//   npm i model-viewer
//   cp node_modules/@google/model-viewer/dist/model-viewer.min.js public/vendor/
// ---------------------------------------------------------------------------
interface Props {
	node: {
		_type: 'model3d';
		/** Self-hosted .glb/.gltf — never a third-party CDN origin. */
		src: string;
		/** Still image: the LCP element and the no-JS fallback. */
		poster: string;
		/** Required — the viewer's accessible name (model-viewer's `alt`). */
		alt: string;
		caption?: string;
		/** Opt in to AR (quick-look / scene-viewer / webxr). */
		ar?: boolean;
	};
}

const { node } = Astro.props;
---

<figure class="block-model3d" data-section="model-3d">
	<div class="block-model3d__frame">
		<img
			class="block-model3d__poster"
			src={node.poster}
			alt={node.alt}
			loading="lazy"
			decoding="async"
		/>
		<model-viewer
			src={node.src}
			poster={node.poster}
			alt={node.alt}
			class="block-model3d__viewer"
			camera-controls
			touch-action="pan-y"
			shadow-intensity="1"
			reveal="auto"
			loading="lazy"
			data-auto-rotate="true"
			ar={node.ar ? '' : undefined}
			ar-modes={node.ar ? 'webxr scene-viewer quick-look' : undefined}></model-viewer>
	</div>
	{node.caption ? <figcaption class="block-model3d__caption">{node.caption}</figcaption> : null}
</figure>

<script is:inline>
	(function () {
		// 1. Load the self-hosted runtime exactly once per document. Deferred:
		//    the poster has already painted, so this costs nothing above the fold.
		if (!window.__nvoosModelViewerRuntime) {
			window.__nvoosModelViewerRuntime = true;
			const runtime = document.createElement('script');
			runtime.type = 'module';
			runtime.src = '/vendor/model-viewer.min.js';
			runtime.dataset.nvoosModelViewer = '1';
			document.head.appendChild(runtime);
		}
		// 2. Auto-rotation IS motion — only for visitors who did not ask for less.
		if (window.matchMedia && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			document.querySelectorAll('model-viewer[data-auto-rotate="true"]').forEach(function (viewer) {
				viewer.setAttribute('auto-rotate', '');
				viewer.setAttribute('auto-rotate-delay', '2000');
			});
		}
	})();
</script>

<style>
	.block-model3d {
		margin: 1.5rem 0;
	}

	/* A fixed box reserves the space, so the viewer can never move the LCP. */
	.block-model3d__frame {
		position: relative;
		aspect-ratio: 4 / 3;
		border-radius: var(--nv-radius);
		overflow: hidden;
		background: var(--nv-surface, #f4f2ef);
	}

	.block-model3d__poster {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.block-model3d__viewer {
		display: none;
		width: 100%;
		height: 100%;
		background: transparent;
	}

	/* Upgrade only once the custom element is DEFINED — before that the poster
	   is the viewer, which is also the no-runtime fallback. */
	.block-model3d__viewer:defined {
		display: block;
	}

	.block-model3d:has(.block-model3d__viewer:defined) .block-model3d__poster {
		display: none;
	}

	.block-model3d__caption {
		margin: 0.5rem 0 0;
		font-size: 0.875rem;
		opacity: 0.75;
	}
</style>
