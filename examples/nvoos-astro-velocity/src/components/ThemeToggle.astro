---
// ---------------------------------------------------------------------------
// ThemeToggle — ADS theme switcher (Proposal 095, hardened by 104 + 105).
//
// State source is localStorage (via the theme module), NEVER the DOM
// attribute — the attribute is wiped on every ClientRouter swap while the
// storage value survives. Behaviour:
//   - ≤ 3 themes (light + dark + ≤ 1 brand): single-button cycle
//   - > 3 themes: button opens a role=menu list (bento/Starlight pattern)
// The theme list derives from the ADS bundle (lib/theme/registry), not a
// hardcoded array — brand themes created via /mcp show up on the next build.
//
// Proposal 105 §3: when the theme POLICY is forced (light/dark/brand), the
// toggle disables (aria-disabled), the menu stays hidden, the label shows
// the forced theme name and a visible note explains the override. The guard
// lives inside the EXISTING document-delegated handler (no new bindings —
// the 104 Defect A lesson); the policy payload is read from the inline
// [data-theme-policy] JSON rendered by the layout.
// ---------------------------------------------------------------------------

import { ALL_THEMES } from '../lib/theme/registry';

const cycleOnly = ALL_THEMES.length <= 3;
---
<div class="theme-toggle" data-theme-toggle-root>
	<button
		type="button"
		data-theme-toggle
		aria-pressed="false"
		aria-haspopup={cycleOnly ? undefined : 'menu'}
	>
		<span data-theme-label>Theme</span>
	</button>
	{!cycleOnly && (
		<ul class="theme-toggle__menu" role="menu" aria-label="Colour theme" hidden data-theme-menu>
			{ALL_THEMES.map((theme) => (
				<li role="none">
					<button
						type="button"
						role="menuitemradio"
						aria-checked="false"
						data-theme-choice={theme}
					>
						{theme}
					</button>
				</li>
			))}
		</ul>
	)}
	<span class="theme-toggle__note" data-theme-forced-note hidden>Theme is set by the store</span>
</div>

<style>
	.theme-toggle {
		position: relative;
	}

	.theme-toggle button {
		border: 1px solid var(--nv-line);
		background: transparent;
		color: var(--nv-ink);
		font: inherit;
		font-size: 0.85rem;
		padding: 0.25rem 0.6rem;
		border-radius: var(--nv-radius);
		cursor: pointer;
	}

	.theme-toggle button:disabled {
		cursor: not-allowed;
		opacity: 0.65;
	}

	.theme-toggle__menu {
		position: absolute;
		top: calc(100% + 0.35rem);
		right: 0;
		margin: 0;
		padding: 0.35rem;
		list-style: none;
		background: var(--nv-surface);
		border: 1px solid var(--nv-line);
		border-radius: var(--nv-radius);
		box-shadow: 0 6px 18px rgb(0 0 0 / 0.15);
		z-index: 50;
		min-width: 10rem;
	}

	.theme-toggle__menu[hidden] {
		display: none;
	}

	.theme-toggle__menu li + li {
		margin-top: 0.15rem;
	}

	.theme-toggle__menu button {
		display: block;
		width: 100%;
		text-align: left;
		border: none;
		border-radius: calc(var(--nv-radius) / 2);
		padding: 0.35rem 0.6rem;
	}

	.theme-toggle__menu button[aria-checked='true'] {
		background: var(--nv-surface-alt);
		font-weight: 600;
	}

	.theme-toggle__note {
		position: absolute;
		top: calc(100% + 0.35rem);
		right: 0;
		font-size: 0.75rem;
		color: var(--nv-muted);
		white-space: nowrap;
	}

	.theme-toggle__note[hidden] {
		display: none;
	}
</style>

<script>
	import { ALL_THEMES, nextTheme } from '../lib/theme/registry';
	import { applyTheme, persistTheme, resolveStoredTheme } from '../lib/theme/theme';

	const cycleOnly = ALL_THEMES.length <= 3;

	function mediaQuery(): MediaQueryList | null {
		return typeof window !== 'undefined' && window.matchMedia
			? window.matchMedia('(prefers-color-scheme: light)')
			: null;
	}

	function currentTheme(): string {
		return resolveStoredTheme(localStorage, mediaQuery(), ALL_THEMES);
	}

	/** The policy payload inlined by the layout (Proposal 105 §3). */
	function readPolicy(): { resolved?: { forced?: boolean; theme?: string } } | null {
		try {
			const node = document.querySelector('script[data-theme-policy]');
			if (!node) {
				return null;
			}
			return JSON.parse(node.textContent || 'null');
		} catch {
			/* malformed policy payload */
		}
		return null;
	}

	/** The forced theme, or null when the policy leaves the choice open. */
	function forcedTheme(): string | null {
		const resolved = readPolicy()?.resolved;
		if (!resolved || !resolved.forced) {
			return null;
		}
		return resolved.theme ?? null;
	}

	function syncAll(): void {
		const forced = forcedTheme();
		const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
		const note = document.querySelector<HTMLElement>('[data-theme-forced-note]');
		const menu = document.querySelector<HTMLElement>('[data-theme-menu]');
		const theme = forced ?? currentTheme();
		const label = document.querySelector('[data-theme-label]');
		if (label) {
			label.textContent = theme;
		}
		if (toggle) {
			toggle.setAttribute('aria-pressed', String(theme !== 'light'));
			if (forced) {
				toggle.disabled = true;
				toggle.setAttribute('aria-disabled', 'true');
				toggle.removeAttribute('aria-haspopup');
			} else {
				toggle.disabled = false;
				toggle.removeAttribute('aria-disabled');
				if (!cycleOnly) {
					toggle.setAttribute('aria-haspopup', 'menu');
				}
			}
		}
		if (menu && forced) {
			menu.hidden = true;
		}
		if (note) {
			note.hidden = !forced;
		}
		document.querySelectorAll<HTMLElement>('[data-theme-choice]').forEach((item) => {
			item.setAttribute('aria-checked', String(item.dataset.themeChoice === theme));
		});
	}

	function choose(theme: string): void {
		applyTheme(theme);
		persistTheme(theme, localStorage);
		syncAll();
		const menu = document.querySelector<HTMLElement>('[data-theme-menu]');
		if (menu) {
			menu.hidden = true;
		}
	}

	// Bundled scripts run once per FULL load and are NOT re-executed on
	// client-side navigation (the ClientRouter replaces the body) — so clicks
	// are delegated on document (which survives the swap) and state is
	// re-synced on every swap. The layout boot re-applies the attribute;
	// reading storage here keeps ordering irrelevant.
	document.addEventListener('click', (event) => {
		// Forced policy guard (105 §3): the store owns the theme.
		if (forcedTheme()) {
			return;
		}
		const target = event.target as Element | null;
		if (target?.closest<HTMLButtonElement>('[data-theme-toggle]')) {
			if (cycleOnly) {
				choose(nextTheme(currentTheme(), ALL_THEMES));
				return;
			}
			const menu = document.querySelector<HTMLElement>('[data-theme-menu]');
			if (menu) {
				menu.hidden = !menu.hidden;
			}
			return;
		}
		const choice = target?.closest<HTMLButtonElement>('[data-theme-choice]');
		if (choice) {
			choose(choice.dataset.themeChoice ?? 'light');
		}
	});

	document.addEventListener('astro:after-swap', syncAll);
	syncAll();
</script>
