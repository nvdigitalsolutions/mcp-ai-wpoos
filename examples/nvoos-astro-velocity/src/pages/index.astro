---
// ---------------------------------------------------------------------------
// Home — the explainer landing page + commerce pockets (D4).
//
// The hero and the "What is this app?" / "Explore the stack" / "Take the
// tour" sections describe the storefront itself; the stats and stack-explorer
// islands make it live (real contract totals, active theme, live contract
// read). The featured/bestsellers grids are filtered from the newest +
// top-rated pages and only render once the catalog actually has products.
// JSON-LD: Organization + WebSite (industry baseline).
// ---------------------------------------------------------------------------

import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Carousel from '../components/Carousel.astro';
import ProductGrid from '../components/ProductGrid.astro';
import HomeStats from '../islands/HomeStats';
import StackExplorer from '../islands/StackExplorer';
import {
	getCollectionOrNull,
	getGlobal,
	getProducts,
} from '../lib/commerce/client';
import { normalizeProductMedia } from '../lib/commerce/normalize';
import { organizationJsonLd, webSiteJsonLd } from '../lib/seo/jsonld';
import { pageTitle } from '../lib/seo/meta';
import { absoluteUrl } from '../lib/url';
import type { Brand, Category, ContentDoc } from '../lib/commerce/types';
import type { Banner as BannerData } from '../lib/commerce/types';
import '../styles/home.css';

// Home is dynamic (globals/promotions change) — cacheable, not prerendered.
Astro.response.headers.set(
	'Cache-Control',
	'public, s-maxage=300, stale-while-revalidate=60'
);

const [banner, newest, topRated, categoryMeta, brandMeta, postMeta] =
	await Promise.all([
		getGlobal('banner', Astro.url),
		getProducts(Astro.url, { page: 1, limit: 50, sort: 'date' }),
		getProducts(Astro.url, { page: 1, limit: 50, sort: '-rating' }),
		// The auxiliary stat counts degrade to null on a 404 so a backend
		// that predates one of these collections (deployment version skew)
		// shows "—" instead of 500ing the landing page.
		getCollectionOrNull<Category>('categories', Astro.url, { page: 1, limit: 1 }),
		getCollectionOrNull<Brand>('brands', Astro.url, { page: 1, limit: 1 }),
		getCollectionOrNull<ContentDoc>('content/posts', Astro.url, {
			page: 1,
			limit: 1,
		}),
	]);

const normalizeList = (list: typeof newest.docs) =>
	list.map(normalizeProductMedia);

const featured = normalizeList(
	newest.docs.filter((p) => p.isFeatured).slice(0, 8)
);
const bestsellers = normalizeList(
	topRated.docs.filter((p) => p.isBestseller).slice(0, 8)
);
const fallback = normalizeList(newest.docs.slice(0, 8));

const liveCounts = {
	products: newest.totalDocs,
	categories: categoryMeta?.totalDocs ?? null,
	brands: brandMeta?.totalDocs ?? null,
	posts: postMeta?.totalDocs ?? null,
};

const site = Astro.site ?? new URL('https://store.nvoos.cloud');
const bannerData = banner as BannerData | null;
const hasCatalog = newest.totalDocs > 0;
---

<BaseLayout
	title={pageTitle()}
	description="NV Store — the NV-authored, MIT-licensed headless storefront: server-rendered Astro, one stable commerce contract, and live design themes."
	canonical={absoluteUrl(site, '/')}
	jsonld={[organizationJsonLd('NV Store', site), webSiteJsonLd('NV Store', site)]}
>
	<section class="hero">
		<h1 class="hero__title">NV Store</h1>
		<p class="hero__lede">
			An open-source, headless storefront demo: Astro renders the pages,
			WordPress and WooCommerce feed one stable contract, and a live design
			system re-themes the whole store — even from an AI assistant over MCP.
		</p>
		<div class="hero__cta">
			<a class="btn" href="/products/">Browse products</a>
			<a class="btn btn--ghost" href="#what-is-this-app">How it works</a>
			<a class="btn btn--ghost" href="#tour">Take the tour</a>
		</div>
	</section>

	<Banner banner={bannerData} />
	<Carousel />

	<section class="about" id="what-is-this-app" aria-labelledby="about-heading">
		<h2 id="about-heading">What is this app?</h2>
		<div class="about-grid">
			<article class="about-card">
				<h3>Headless &amp; server-rendered</h3>
				<p>
					Astro renders every page on the server and ships minimal
					JavaScript: complete HTML for crawlers and slow connections,
					tiny interactive islands for everyone else.
				</p>
			</article>
			<article class="about-card">
				<h3>One contract, two backends</h3>
				<p>
					A Payload-shaped REST envelope (<code>nvoos-commerce/v1</code>)
					feeds the whole storefront through the same-origin{' '}
					<code>/api/*</code> proxy — WordPress and WooCommerce catalogs
					today, any backend tomorrow.
				</p>
			</article>
			<article class="about-card">
				<h3>Themed by design tokens</h3>
				<p>
					A DTCG token layer drives every color and type decision, with
					light, dark, high-contrast, and runtime brand themes — plus an
					optional server-side theme policy for fleet-wide control.
				</p>
			</article>
			<article class="about-card">
				<h3>A component library</h3>
				<p>
					An accessibility-first UI kit — accordion, dialog, combobox,
					tabs — styled from the same tokens, with a living gallery at{' '}
					<a href="/components/">/components/</a>.
				</p>
			</article>
			<article class="about-card">
				<h3>Content, posts &amp; pages</h3>
				<p>
					A governed content engine: blog posts and pages with Portable
					Text blocks, SEO fields, scheduled publishing, and signed
					preview links for drafts.
				</p>
			</article>
			<article class="about-card">
				<h3>Controllable by AI</h3>
				<p>
					The built-in <code>/mcp</code> surface (35 tools) lets an AI
					assistant manage the catalog, publish content, re-theme the
					store, and configure checkout — audited and fail-closed.
				</p>
			</article>
		</div>
	</section>

	<section aria-labelledby="stats-heading">
		<h2 id="stats-heading" class="sr-only">Live store stats</h2>
		<HomeStats counts={liveCounts} client:visible />
	</section>

	<section class="explore" aria-labelledby="explore-heading">
		<h2 id="explore-heading">Explore the stack</h2>
		<StackExplorer client:visible />
	</section>

	<section class="tour" id="tour" aria-labelledby="tour-heading">
		<h2 id="tour-heading">Take the tour</h2>
		<ul class="tour-grid">
			<li class="tour-card">
				<a href="/components/">
					<h3>Component library</h3>
					<p>The accessibility-first UI kit in a living gallery.</p>
				</a>
			</li>
			<li class="tour-card">
				<a href="/tokens/">
					<h3>Design tokens</h3>
					<p>The full DTCG token reference — colors, type, spacing.</p>
				</a>
			</li>
			<li class="tour-card">
				<a href="/blog/">
					<h3>Blog &amp; content</h3>
					<p>Posts and pages served by the content engine.</p>
				</a>
			</li>
			<li class="tour-card">
				<a href="/manage/">
					<h3>Astro CMS</h3>
					<p>The standalone admin — catalog, content, and design.</p>
				</a>
			</li>
		</ul>
	</section>

	{
		hasCatalog && (
			<>
				<section>
					<h2>Featured</h2>
					<ProductGrid products={featured.length > 0 ? featured : fallback} />
				</section>
				<section>
					<h2>Bestsellers</h2>
					<ProductGrid
						products={bestsellers.length > 0 ? bestsellers : fallback}
					/>
				</section>
			</>
		)
	}
</BaseLayout>
