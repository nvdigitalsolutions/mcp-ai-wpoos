---
// ---------------------------------------------------------------------------
// CMS page detail — Proposal 106 §2 (content/pages + hybrid local) +
// Proposal 107 (DECISION-2): agent-authored docs render their Portable Text
// `blocks` through the allowlisted component set; legacy docs keep the
// trusted `contentRendered` HTML path.
//
// Preview sessions (107 §3.2) bypass the publication gate: the route-cache
// entry and public Cache-Control are skipped (the cache is URL-keyed — a
// draft render must never poison the public entry) and the backend read
// forwards the visitor's cookies with status=any. Non-manager preview
// links to drafts fail closed to 404.
// ---------------------------------------------------------------------------

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPage, getThemePolicy } from '../../../lib/commerce/client';
import { isPublished } from '../../../lib/commerce/publish';
import { getCollection } from 'astro:content';
import { localBySlug } from '../../../lib/content/merge';
import { contentBody } from '../../../lib/content/render';
import { hasPreviewSession } from '../../../lib/content/preview';
import Blocks from '../../../components/blocks/Blocks.astro';
import { webPageJsonLd } from '../../../lib/seo/jsonld';
import { pageTitle, plainExcerpt } from '../../../lib/seo/meta';
import { absoluteUrl } from '../../../lib/url';

const id = Number(Astro.params.id ?? 0);
const requestedSlug = String(Astro.params.slug ?? '').replace(/\/+$/, '');

const previewActive = hasPreviewSession(Astro.request.headers.get('cookie'));
const visitorCookie = Astro.request.headers.get('cookie');

const site = Astro.site ?? new URL('https://store.nvoos.cloud');
const home = { name: 'Home', url: absoluteUrl(site, '/') };
const NOT_FOUND = (body: string) =>
	new Response(body, {
		status: 404,
		headers: { 'cache-control': 'private, no-store' },
	});

// Envelope first (L2): a matching published doc renders; a draft never
// falls through to local content (publication discipline, 104 §2.1).
const envelope =
	Number.isInteger(id) && id > 0
		? await getPage(id, Astro.url, previewActive ? { status: 'any', cookie: visitorCookie } : {})
		: null;
if (envelope && !previewActive && !isPublished(envelope)) {
	return NOT_FOUND('Page not found');
}
if (envelope && requestedSlug !== envelope.slug) {
	return Astro.redirect(`/pages/${id}/${envelope.slug}/`, 301);
}
// Previews are envelope-only — a preview link that cannot resolve its doc
// (deleted, or a non-manager viewing a draft) 404s, never falls back to
// local content.
if (previewActive && !envelope) {
	return NOT_FOUND('Page not found');
}

// Hybrid-local fallback (O-4): no envelope doc with this id — render the
// local page whose slug matches the URL tail.
const localPages = await getCollection('pages', (entry) => !entry.data.draft);
const local = envelope ? null : localBySlug(localPages, requestedSlug);
if (!envelope && !local) {
	return NOT_FOUND('Page not found');
}

// Cache treatment applies to RENDERED responses only — a 404 (above) must
// never enter the route cache, or a preview render would be served the
// cached public 404 (the provider serves fresh hits before the route runs).
if (previewActive) {
	// Preview renders must reflect the backend NOW: drop any public cache
	// entry for this exact path, and never advertise the render to crawlers
	// or shared caches.
	await Astro.cache.invalidate({ path: Astro.url.pathname });
	Astro.response.headers.set('Cache-Control', 'private, no-store');
	Astro.response.headers.set('X-Robots-Tag', 'noindex');
} else {
	Astro.response.headers.set(
		'Cache-Control',
		'public, s-maxage=300, stale-while-revalidate=600'
	);
	const policy = await getThemePolicy(Astro.url);
	if (Astro.cache.enabled) {
		Astro.cache.set({
			maxAge: 300,
			swr: 600,
			tags: ['content', 'pages'],
			etag: policy.updatedAt,
		});
	}
}

// One view shape for both sources — the template below branches on nothing.
const title = envelope
	? envelope.seoTitle || pageTitle(envelope.title)
	: pageTitle(local?.data.title ?? requestedSlug);
const description = envelope
	? envelope.seoDescription || plainExcerpt(envelope.excerpt || envelope.contentRendered)
	: (local?.data.description ?? '');
const canonical = envelope
	? absoluteUrl(site, `/pages/${id}/${envelope.slug}/`)
	: absoluteUrl(site, `/pages/0/${local?.id ?? requestedSlug}/`);
const body = envelope
	? contentBody(envelope)
	: { blocks: null, html: local?.rendered?.html ?? '' };
const draftPreview = previewActive && envelope !== null && envelope.status !== undefined && envelope.status !== 'publish';
const jsonld = [
	webPageJsonLd({
		name: envelope ? envelope.title : (local?.data.title ?? ''),
		url: canonical,
		description: plainExcerpt(
			envelope ? envelope.excerpt || envelope.contentRendered : description,
			300
		),
		breadcrumb: [home, { name: envelope ? envelope.title : (local?.data.title ?? ''), url: canonical }],
	}),
];
---

<BaseLayout
	title={title}
	description={description}
	canonical={canonical}
	jsonld={jsonld}
>
	<nav class="breadcrumbs" aria-label="Breadcrumb">
		<a href="/">Home</a> {' / '} <span>{envelope ? envelope.title : local?.data.title}</span>
	</nav>
	<article>
		<h1>{envelope ? envelope.title : local?.data.title}</h1>
		{
			draftPreview && (
				<div class="preview-banner" role="status">
					Draft preview — not publicly visible
				</div>
			)
		}
		{body.blocks ? <Blocks blocks={body.blocks} /> : <div class="content-body" set:html={body.html} />}
	</article>
</BaseLayout>

<style>
	.preview-banner {
		display: inline-block;
		margin-block-end: 1rem;
		padding: 0.35rem 0.75rem;
		border: 1px dashed var(--nv-line-strong, var(--nv-line));
		border-radius: var(--nv-radius);
		color: var(--nv-muted);
		font-size: 0.85rem;
	}
</style>
