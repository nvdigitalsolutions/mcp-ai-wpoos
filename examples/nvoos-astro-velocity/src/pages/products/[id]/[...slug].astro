---
// ---------------------------------------------------------------------------
// PDP — on-demand SSR (Proposal 104 §3.2, replacing the 092 §5.4 build-time
// prerender). Rationale: a prerendered catalog is only correct when it is
// stable at deploy time, and the mirror's hermetic build bakes fixture data
// — every live product URL 404'd (Proposal 104 Defect B). SSR against the
// same-origin /api/* proxy renders the live catalog, enables REAL 301s for
// slug drift, and carries Astro route caching (tags: products, product-<id>).
//
// Zero-JS by default: the gallery/add-to-cart/promo islands hydrate lazily.
// JSON-LD (Product/Offer/AggregateRating/BreadcrumbList) is in the initial
// HTML (P3/D10) — unchanged by the rendering-model switch.
// ---------------------------------------------------------------------------

import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryLightbox, { type GalleryEntry } from '../../../islands/GalleryLightbox';
import AddToCartButton from '../../../islands/AddToCartButton';
import VariantSelector from '../../../islands/VariantSelector';
import PromoCodeField from '../../../islands/PromoCodeField';
import ProductCard from '../../../components/ProductCard.astro';
import { getProduct, getProducts, getThemePolicy } from '../../../lib/commerce/client';
import { isPublished } from '../../../lib/commerce/publish';
import { normalizeProductMedia, sanitizeDescription } from '../../../lib/commerce/normalize';
import { formatPrice, resolveCurrency } from '../../../lib/commerce/money';
import { categoryPath, productPath, slugify, absoluteUrl } from '../../../lib/url';
import { jsonLdFor } from '../../../lib/seo/jsonld';
import { metaForProduct } from '../../../lib/seo/meta';
import { fixedImage, renderOrigin, responsiveImage } from '../../../lib/images';

Astro.response.headers.set(
	'Cache-Control',
	'public, s-maxage=300, stale-while-revalidate=600'
);

const id = Number(Astro.params.id ?? 0);
if (!Number.isInteger(id) || id <= 0) {
	return new Response('Not found', { status: 404 });
}

const raw = await getProduct(id, Astro.url);
// Publication guard: a draft (or non-publish WP status) 404s to storefront
// visitors even when the id is guessed — the Cactus "filter everywhere" rule.
if (!raw || !isPublished(raw)) {
	return new Response('Product not found', { status: 404 });
}

// Canonical-slug convergence: SSR makes real 301s possible (the prerendered
// page could not redirect; it could only note the canonical).
const requestedSlug = String(Astro.params.slug ?? '').replace(/\/+$/, '');
if (requestedSlug !== slugify(raw.name)) {
	return Astro.redirect(productPath(id, raw.name), 301);
}

// Theme policy revision rides the cache entry (Proposal 105 §3): the ETag
// carries the doc's updatedAt so a policy PATCH restamps every cached entry
// (tag list unchanged). Production invalidation stays the rebuild→redeploy
// loop; this covers the same-process e2e/dev surface.
const policy = await getThemePolicy(Astro.url);

if (Astro.cache.enabled) {
	Astro.cache.set({
		maxAge: 300,
		swr: 600,
		tags: ['products', `product-${id}`],
		etag: policy.updatedAt,
	});
}

const product = normalizeProductMedia(raw);
const site = Astro.site ?? new URL('https://store.nvoos.cloud');
const meta = metaForProduct(product, site);
// Branded OG card (Proposal 104 Q5) — the og:image slot points at the
// on-demand satori render; crawlability of the card is covered by the
// OG route e2e, and render failures fall back to the product image.
const ogImage = absoluteUrl(site, `/og/product/${product.id}.png`);

// Breadcrumb trail: Home → Category → Product (JSON-LD + visible).
const breadcrumbs = [
	{ name: 'Home', url: absoluteUrl(site, '/') },
	...(product.category
		? [
			{
				name: product.category.name,
				url: absoluteUrl(site, categoryPath(product.category.id, product.category.name)),
			},
		]
		: []),
];

// Related: same category, newest first, exclude self — request-time, not a
// whole-catalog build prop. Publication-filtered.
const related = product.category
	? (
		await getProducts(Astro.url, {
			page: 1,
			limit: 8,
			where: { category: { equals: product.category.id } },
			sort: '-date',
		})
	).docs
		.filter((candidate) => candidate.id !== product.id && isPublished(candidate))
		.map(normalizeProductMedia)
	: [];

const jsonld = jsonLdFor({
	type: 'Product',
	product,
	site,
	currency: resolveCurrency(),
	breadcrumb: breadcrumbs,
});

// Gallery entries — runtime-optimized via the /_image endpoint so the PDP
// build never fetches remote bytes.
const origin = renderOrigin(Astro.url, Astro.site);
const gallery: GalleryEntry[] = [product.image, ...product.images]
	.filter(Boolean)
	.map((src) => ({
		full: responsiveImage(origin, src, {
			width: 600,
			height: 750,
			widths: [600, 1200],
			sizes: '(min-width: 800px) 600px, 100vw',
		}),
		thumb: fixedImage(origin, src, 80, 100),
	}));
---

<BaseLayout
	title={meta.title}
	description={meta.description}
	canonical={meta.canonical}
	markdownHref={meta.canonical ? `${meta.canonical.replace(/\/+$/, '')}/index.md` : undefined}
	image={ogImage}
	jsonld={jsonld}
>
	<nav class="breadcrumbs" aria-label="Breadcrumb">
		<a href="/">Home</a>
		{
			product.category && (
				<>
					{' / '}
					<a href={categoryPath(product.category.id, product.category.name)}>
						{product.category.name}
					</a>
				</>
			)
		}
		{' / '}
		<span>{product.name}</span>
	</nav>

	<article class="pdp">
		<div>
			{/* client:load, not client:visible/client:idle — both emit a per-page
			    inline bootstrap that a hash-based CSP cannot allow on in-app
			    navigation (see the CSP note in BaseLayout). */}
			<GalleryLightbox entries={gallery} alt={product.name} client:load />
		</div>
		<div>
			<h1>{product.name}</h1>
			{
				product.brand && (
					<p>
						Brand:{' '}
						<a href={`/brands/${product.brand.id}/${slugify(product.brand.name)}/`}>
							{product.brand.name}
						</a>
					</p>
				)
			}
			{product.rating !== null && <p>Rating: {product.rating.toFixed(1)} / 5</p>}
			<p class="pdp__price" data-price-root>
				<span data-variant-price>{formatPrice(product.price)}</span>
				<span class="pdp__old-price" data-variant-old-price
					hidden={product.oldPrice === null || product.oldPrice <= product.price}>
					{product.oldPrice !== null && product.oldPrice > product.price
						? formatPrice(product.oldPrice)
						: ''}
				</span>
			</p>
			{
				product.colors.length > 0 && (
					<p>
						{product.colors.map((color) => (
							<span
								class="swatch"
								title={color.name}
								style={`background:${color.hexCode || '#ccc'}`}
							/>
						))}
					</p>
				)
			}
			{
				product.variants && product.variants.length > 0 && (
					<VariantSelector
						productId={product.id}
						basePrice={product.price}
						baseOldPrice={product.oldPrice}
						variants={product.variants}
						client:load
					/>
				)
			}
			<AddToCartButton
				productId={product.id}
				name={product.name}
				price={product.price}
				image={product.image}
				client:load
			/>
			<PromoCodeField client:load />
			<section>
				<h2>Description</h2>
				<div set:html={sanitizeDescription(product.description)} />
			</section>
		</div>
	</article>

	{
		related.length > 0 && (
			<section>
				<h2>You may also like</h2>
				<div class="product-grid">
					{related.map((item) => (
						<ProductCard product={item} />
					))}
				</div>
			</section>
		)
	}
</BaseLayout>
