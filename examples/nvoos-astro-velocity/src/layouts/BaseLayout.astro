---
// ---------------------------------------------------------------------------
// Base layout — Proposal 092 §5.4.
//
// Owns the document head (title/meta/canonical/OG/JSON-LD slots), the site
// header (with the cart badge island) and footer. View Transitions use the
// opt-in ClientRouter; the analytics forwarding hook (R4/D9) fires
// astro:page-load so tag managers work despite client-side navigation.
//
// Proposal 105 §3: the theme-policy doc is inlined as an is:inline JSON data
// block (data-theme-policy). The boot ladder applies a FORCED policy before
// storage (forced wins), keeps color-scheme in sync, and re-applies on every
// astro:after-swap (104 Defect A). The resolution runs server-side (registry
// known) so the raw boot script stays registry-free.
// ---------------------------------------------------------------------------

import { ClientRouter } from 'astro:transitions';
import CartBadge from '../islands/CartBadge';
import ManageLink from '../islands/ManageLink';
import ThemeToggle from '../components/ThemeToggle.astro';
import ContrastToggle from '../components/ContrastToggle.astro';
import { getThemePolicy } from '../lib/commerce/client';
import { resolvePolicyTheme } from '../lib/theme/policy';
import { ALL_THEMES } from '../lib/theme/registry';
import '../styles/generated/tokens.css';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	image?: string;
	jsonld?: Record<string, unknown>[];
}

const {
	title,
	description,
	canonical,
	image,
	jsonld = [],
} = Astro.props;

// Live policy for SSR renders (getThemePolicy falls back to the build-baked
// policy.generated.ts doc on any failure — never break a render). The
// resolved result (stored/media = null) carries the FORCED ladder steps; the
// boot script re-runs the auto ladder against real storage + media.
const policyDoc = await getThemePolicy(Astro.url);
const resolved = resolvePolicyTheme(policyDoc, null, null, ALL_THEMES);
const policyPayload = JSON.stringify({
	doc: policyDoc,
	resolved,
	registry: ALL_THEMES,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{
			description && (
				<meta name="description" content={description} />
			)
		}
		{canonical && <link rel="canonical" href={canonical} />}
		{image && <meta property="og:image" content={image} />}
		{
			jsonld.map((block) => (
				<script type="application/ld+json" set:html={JSON.stringify(block)} />
			))
		}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<!-- Theme-policy payload (105 §3): JSON data block, no event handlers —
		     the boot script and the toggles read it via [data-theme-policy]. -->
		<script type="application/json" data-theme-policy set:html={policyPayload} />
		<script is:inline>
			// ADS no-FOUC theme boot (Proposal 095/104/105): resolve the theme
			// + contrast axes before first paint, then RE-APPLY on every
			// client-side navigation — Astro's ClientRouter swaps the <html>
			// element (attributes included) and head scripts run only once,
			// so without the after-swap listener the theme resets to light on
			// page 2 (Proposal 104 Defect A; Astro docs' dark-mode pattern).
			//
			// Policy ladder (105 §3): a FORCED policy theme wins over storage;
			// auto keeps the 104 ladder (storage → media → defaultTheme).
			// Contrast mirrors it (forced axis or stored → standard).
			(function () {
				const KEY = 'nvoos-theme';
				const CKEY = 'nvoos-contrast';
				const stored = (key) => {
					try {
						return localStorage.getItem(key);
					} catch { /* storage unavailable */ }
					return null;
				};
				const readPolicy = () => {
					try {
						const node = document.querySelector('script[data-theme-policy]');
						return node ? JSON.parse(node.textContent || 'null') : null;
					} catch { /* malformed policy payload */ }
					return null;
				};
				const apply = () => {
					const policy = readPolicy();
					const doc = policy && policy.doc ? policy.doc : { defaultTheme: 'dark', contrast: 'auto' };
					const resolved = policy && policy.resolved ? policy.resolved : null;
					const registry = policy && Array.isArray(policy.registry) ? policy.registry : [];
					let theme = null;
					if (resolved && resolved.forced) {
						theme = resolved.theme;
					} else {
						const saved = stored(KEY);
						if (saved === 'light' || registry.indexOf(saved) !== -1) {
							theme = saved;
						}
					}
					if (!theme) {
						const media = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)');
						theme = media ? (media.matches ? 'light' : 'dark') : (doc.defaultTheme || 'dark');
					}
					if (theme === 'light') {
						document.documentElement.removeAttribute('data-theme');
					} else {
						document.documentElement.setAttribute('data-theme', theme);
					}
					document.documentElement.style.colorScheme = theme === 'dark' ? 'dark' : 'light';
					const contrast =
						resolved && resolved.contrastForced
							? resolved.contrast
							: stored(CKEY) === 'high'
								? 'high'
								: 'standard';
					if (contrast === 'high') {
						document.documentElement.setAttribute('data-contrast', 'high');
					} else {
						document.documentElement.removeAttribute('data-contrast');
					}
				};
				apply();
				// document survives the swap; the element does not.
				document.addEventListener('astro:after-swap', apply);
			})();
		</script>
		<ClientRouter />
		<script>
			// Analytics forwarding (R4/D9): client-side navigations via
			// ClientRouter do not fire real page loads, so tag managers must
			// listen here instead.
			document.addEventListener('astro:page-load', () => {
				window.dispatchEvent(new CustomEvent('nvoos:page-load'));
			});
		</script>
		<slot name="head" />
	</head>
	<body>
		<header class="site-header">
			<div class="container site-header__inner">
				<a class="site-header__brand" href="/">NV Store</a>
				<nav class="site-nav" aria-label="Primary">
					<a href="/products/">Products</a>
					<a href="/categories/">Categories</a>
					<a href="/brands/">Brands</a>
					<a href="/blog/">Blog</a>
					<a href="/promotions/">Promotions</a>
					<a href="/account/">Account</a>
				</nav>
				<CartBadge client:load transition:persist />
				<ThemeToggle />
				<ContrastToggle />
				<ManageLink client:load />
			</div>
		</header>
		<main class="container">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container">
				<p>
					NV Store — an NV-authored, MIT-licensed Astro storefront
					(Proposal 092). <a href="/about">About</a> · <a href="/terms">Terms</a>
				</p>
			</div>
		</footer>
	</body>
</html>
