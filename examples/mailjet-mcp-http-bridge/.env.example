# Port to listen on.
PORT=8080

# REQUIRED. Bearer token the NV oOS connection presents. The bridge fails
# closed when this is unset — it would otherwise be an open proxy for any
# Mailjet key pair.
BRIDGE_TOKEN=generate-a-long-random-value

# Optional. The upstream server reads this once at boot; one deployment serves
# one region. Use "eu" only if your API keys were minted in the EU region.
MAILJET_API_REGION=us

# Do NOT set MAILJET_API_KEY here. The bridge takes credentials per request
# (X-Mailjet-Key / X-Mailjet-Secret) and holds none of its own.
