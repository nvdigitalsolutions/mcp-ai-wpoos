{
  "name": "nvoos-complete-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "description": "NV oOS Complete Console — Cloudways Velocity app serving the full Pro SPA (spa-v2) admin surface for NV oOS Complete customers. Prebuilt bundle + zero-dependency cookie proxy; no build step on Velocity.",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:a11y": "eslint --max-warnings 0 src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "sync:dist": "node scripts/sync-dist.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "1.2.12",
    "cytoscape": "^3.33.1",
    "cytoscape-fcose": "^2.2.0",
    "dompurify": "^3.4.17",
    "jquery": "^3.7.1",
    "marked": "^9.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^6.30.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cytoscape": "^3.21.8",
    "@types/jquery": "^3.5.32",
    "@types/node": "22.15.17",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.4",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.27.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "typescript": "5.8.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@vitest/mocker": ">=4.1.12 <5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
