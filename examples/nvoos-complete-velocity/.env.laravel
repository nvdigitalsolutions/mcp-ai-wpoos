# Build profile for the Laravel runtime smoke (`npm run build:e2e`).
#
# Vite loads this file only under `--mode laravel`. The default `dist/` stays
# a WordPress-profile build; scripts/serve.mjs must run with
# NVOOS_BACKEND=laravel so the runtime profile and the proxied prefixes agree
# (runtime-config.ts asserts the pair at boot).
VITE_NVOOS_BACKEND=laravel
