{
  "version": 1,
  "comment": "Cross-language documentation contract (Proposal 166). Consumed by bin/check-file-docs.php and bin/check-license-boundary.sh. Licence evidence is recorded in docs/project/proposals/166-cross-language-documentation-contract-proposal.md Appendix A.",
  "extensions": ["ts", "tsx", "js", "jsx", "mjs", "cjs", "astro", "rs"],
  "exclude_dirs": ["vendor", "node_modules", "dist", "build", "target", "coverage", ".git", ".next", ".astro", "gen"],
  "exclude_paths": [
    "**/*.min.js",
    "**/*.min.css",
    "**/*.bundle.js",
    "examples/nvoos-dictate/vendor/**",
    "addons/canvas/assets/canvas/**"
  ],
  "scopes": [
    {
      "name": "ts:includes",
      "paths": ["includes/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "manifest": "package.json",
      "fallback": "GPL-3.0-or-later"
    },
    {
      "name": "ts:extensions",
      "paths": ["extensions/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "manifest": "package.json",
      "fallback": "GPL-3.0-or-later"
    },
    {
      "name": "ts:docs",
      "paths": ["docs/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "manifest": "package.json",
      "fallback": "GPL-3.0-or-later"
    },
    {
      "name": "ts:docker",
      "paths": ["docker/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "manifest": "package.json",
      "fallback": "LicenseRef-Proprietary"
    },
    {
      "name": "ts:repo-tooling",
      "paths": [".github/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}", "*.{ts,tsx,js,jsx,mjs,cjs}"],
      "manifest": "package.json",
      "fallback": "GPL-3.0-or-later"
    },
    {
      "name": "ts:root",
      "paths": [
        "assets/js/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}",
        "src/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"
      ],
      "manifest": "package.json",
      "fallback": "GPL-3.0-or-later"
    },
    {
      "name": "ts:packages",
      "paths": ["packages/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "manifest": "package.json",
      "fallback": "MIT"
    },
    {
      "name": "ts:addons",
      "paths": ["addons/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "manifest": "package.json",
      "fallback": null
    },
    {
      "name": "ts:plugins",
      "paths": ["plugins/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "manifest": "package.json",
      "fallback": null
    },
    {
      "name": "ts:examples",
      "paths": ["examples/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "manifest": "package.json",
      "fallback": null
    },
    {
      "name": "ts:tests",
      "paths": ["tests/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "manifest": "package.json",
      "fallback": "GPL-3.0-or-later"
    },
    {
      "name": "ts:bin",
      "paths": ["bin/**/*.{ts,tsx,js,jsx,mjs,cjs,astro}"],
      "manifest": "package.json",
      "fallback": "GPL-3.0-or-later"
    },
    {
      "name": "rust:dictate",
      "paths": ["examples/nvoos-dictate/src-tauri/**/*.rs"],
      "manifest": "Cargo.toml",
      "fallback": "LicenseRef-Proprietary"
    }
  ],
  "product_licences": {
    "addons/algorave": "AGPL-3.0-or-later",
