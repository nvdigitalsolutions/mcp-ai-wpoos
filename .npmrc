# WordPress Scripts Configuration
legacy-peer-deps=true
save-exact=false
# Skip optional dependencies that may have engine issues
omit=optional
# Show engine warnings but don't fail
engine-strict=false

# Production Optimization Settings
# Use offline cache when possible for faster installs
prefer-offline=true
# Reduce install time by skipping audit (run separately if needed)
audit=false
# Reduce install time by skipping funding messages
fund=false
# Use package-lock.json for consistent installs
package-lock=true
