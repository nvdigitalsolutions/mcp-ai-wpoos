/.codex-wordpress/
/.phpunit.result.cache
/node_modules/
.DS_Store
*.log
.env
.env.local
*.bak
opcache-reset.php
*.tar.gz
*.rar
composer.phar

# Temporary files
/tmp/

# Build output - keep only ZIP files, ignore extracted directories
/build/wp-mcp-ai/
/build/wp-mcp-ai-base/
/build/wp-mcp-ai-pro/
/build/mcp-ai-wpoos/
/build/mcp-ai-wpoos-base/
/build/mcp-ai-wpoos-pro/
/build/mcp-ai-wpoos-core/

# Ignore ZIP files everywhere except in build directory
*.zip
!/build/*.zip

# Ignore all vendor by default
/vendor/*

# But keep production dependencies only (negation)
!/vendor/autoload.php
!/vendor/composer/
!/vendor/nyholm/
!/vendor/php-http/
!/vendor/psr/
!/vendor/rahul900day/
!/vendor/symfony/

# Ignore composer temporary files
/vendor/composer/*.zip~
/vendor/composer/tmp-*.zip~

# Keep installed.php and installed.json so plugin works after cloning
# These files are needed for composer autoloader to function properly
#!/vendor/composer/installed.php
#!/vendor/composer/installed.json

# Exclude test and development files from vendor packages
/vendor/*/*/tests/
/vendor/*/*/Tests/
/vendor/*/*/Test/
/vendor/*/*/*/tests/
/vendor/*/*/*/Tests/
/vendor/*/*/*/Test/
/vendor/*/*/.github/
/vendor/*/*/*/.github/
/vendor/*/*/phpunit.xml*
/vendor/*/*/*/phpunit.xml*
/vendor/*/*/phpstan.neon*
/vendor/*/*/*/phpstan.neon*
/vendor/*/*/.editorconfig
/vendor/*/*/*/.editorconfig
/vendor/*/*/.gitignore
/vendor/*/*/*/.gitignore
/vendor/*/*/.gitattributes
/vendor/*/*/*/.gitattributes

# Pro addon node_modules - Document Generation Toolkit
# Ignore all node_modules in pro addon by default
/addons/pro/node_modules/*

# But keep document generation dependencies (negation)
# These are needed at runtime for PDF/Word/Excel generation tools
!/addons/pro/node_modules/pdfkit/
!/addons/pro/node_modules/docx/
!/addons/pro/node_modules/exceljs/

# Keep their direct dependencies as well
!/addons/pro/node_modules/png-js/
!/addons/pro/node_modules/fontkit/
!/addons/pro/node_modules/linebreak/
!/addons/pro/node_modules/@xmldom/
!/addons/pro/node_modules/archiver/
!/addons/pro/node_modules/jszip/

# Exclude test and build files from node_modules packages
/addons/pro/node_modules/*/test/
/addons/pro/node_modules/*/tests/
/addons/pro/node_modules/*/.github/
/addons/pro/node_modules/*/docs/
/addons/pro/node_modules/*/examples/
/addons/pro/node_modules/*/*.md
!/addons/pro/node_modules/*/README.md
!/addons/pro/node_modules/*/LICENSE*

# Minified assets (generated during build)
*.min.css
*.min.js
*.min.css.map
*.min.js.map

# But keep chat-bundle.min.js which is required for the plugin to work.
# The chat-bundle.js source file uses ES6 imports that browsers cannot execute directly.
!assets/js/chat-bundle.min.js
!assets/js/chat-bundle.min.js.map
mcp-diagnostic-debug.php
BUGFIX_SUMMARY.md
test-storage-service.html

# JavaScript test coverage
/coverage/
/.nyc_output/
*.lcov

# Development and test scripts
verify-*.php
/wp-content/
test-transcript-routes.php

# SVN working copies (for WordPress.org deployment)
/svn-*/

# Vectorizer vendor node_modules and native binaries (generated by postinstall scripts)
/assets/js/vendor/neplex-vectorizer/*/node_modules/
/assets/js/vendor/neplex-vectorizer/**/*.node
test-modal-fix.html
