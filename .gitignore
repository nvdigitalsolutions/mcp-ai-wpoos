/.codex-wordpress/
/.phpunit.result.cache
/node_modules/
.DS_Store
*.log
.env
.env.local
*.bak
opcache-reset.php
*.tar.gz
*.rar
composer.phar

# Temporary files
/tmp/

# Build output - keep only ZIP files, ignore extracted directories
/build/wp-mcp-ai/
/build/wp-mcp-ai-base/
/build/wp-mcp-ai-pro/
/build/mcp-ai-wpoos/
/build/mcp-ai-wpoos-base/
/build/mcp-ai-wpoos-pro/
/build/mcp-ai-wpoos-core/

# Ignore ZIP files everywhere except in build directory
*.zip
!/build/*.zip
!/build/optional-components/*.zip

# Ignore all vendor by default
/vendor/*

# But keep production dependencies only (negation)
!/vendor/autoload.php
!/vendor/composer/
!/vendor/firebase/
!/vendor/google/
!/vendor/guzzlehttp/
!/vendor/monolog/
!/vendor/nyholm/
!/vendor/paragonie/
!/vendor/php-http/
!/vendor/phpseclib/
!/vendor/psr/
!/vendor/rahul900day/
!/vendor/ralouphie/
!/vendor/symfony/

# Ignore composer temporary files
/vendor/composer/*.zip~
/vendor/composer/tmp-*.zip~

# Keep installed.php and installed.json so plugin works after cloning
# These files are needed for composer autoloader to function properly
#!/vendor/composer/installed.php
#!/vendor/composer/installed.json

# Exclude test and development files from vendor packages
/vendor/*/*/tests/
/vendor/*/*/Tests/
/vendor/*/*/Test/
/vendor/*/*/*/tests/
/vendor/*/*/*/Tests/
/vendor/*/*/*/Test/
/vendor/*/*/.github/
/vendor/*/*/*/.github/
/vendor/*/*/phpunit.xml*
/vendor/*/*/*/phpunit.xml*
/vendor/*/*/phpstan.neon*
/vendor/*/*/*/phpstan.neon*
/vendor/*/*/.editorconfig
/vendor/*/*/*/.editorconfig
/vendor/*/*/.gitignore
/vendor/*/*/*/.gitignore
/vendor/*/*/.gitattributes
/vendor/*/*/*/.gitattributes

# Exclude Symfony translations (saves ~2MB)
/vendor/symfony/*/Resources/translations/

# Pro addon dependencies
# Exclude node_modules (development only)
/addons/pro/node_modules/

# Include vendor directory (generated from node_modules, included in distribution)
!/addons/pro/assets/vendor/

# Minified assets (generated during build)
*.min.css
*.min.js
*.min.css.map
*.min.js.map

# But keep chat-bundle.min.js which is required for the plugin to work.
# The chat-bundle.js source file uses ES6 imports that browsers cannot execute directly.
!assets/js/chat-bundle.min.js
!assets/js/chat-bundle.min.js.map

# Keep Pro addon bundles (orchestration and research) which are required for the plugin to work.
# These bundle external npm dependencies (p-queue, cheerio, turndown) for browser use.
!addons/pro/assets/js/orchestration-bundle.min.js
!addons/pro/assets/js/orchestration-bundle.min.js.map
!addons/pro/assets/js/research-bundle.min.js
!addons/pro/assets/js/research-bundle.min.js.map

# Keep LangChain bundles in Pro addon (bundled from npm packages) for orchestration features.
# These bundle @langchain/core, @langchain/community, and langchain for browser use.
!addons/pro/assets/js/vendor/langchain-core.bundle.js
!addons/pro/assets/js/vendor/langchain-core.bundle.js.map
!addons/pro/assets/js/vendor/langchain-core.bundle.min.js
!addons/pro/assets/js/vendor/langchain-core.bundle.min.js.map
!addons/pro/assets/js/vendor/langchain.bundle.js
!addons/pro/assets/js/vendor/langchain.bundle.js.map
!addons/pro/assets/js/vendor/langchain.bundle.min.js
!addons/pro/assets/js/vendor/langchain.bundle.min.js.map
!addons/pro/assets/js/vendor/langchain-community.bundle.js
!addons/pro/assets/js/vendor/langchain-community.bundle.js.map
!addons/pro/assets/js/vendor/langchain-community.bundle.min.js
!addons/pro/assets/js/vendor/langchain-community.bundle.min.js.map

# Keep vendor production files (pre-built from npm packages)
!addons/pro/assets/vendor/**/*.min.js
!addons/pro/assets/vendor/**/*.min.css
!addons/pro/assets/vendor/**/*.js
!addons/pro/assets/vendor/**/*.css
mcp-diagnostic-debug.php
BUGFIX_SUMMARY.md
test-storage-service.html

# JavaScript test coverage
/coverage/
/.nyc_output/
*.lcov

# Development and test scripts
verify-*.php
/wp-content/
test-transcript-routes.php

# SVN working copies (for WordPress.org deployment)
/svn-*/

# Vectorizer vendor node_modules and native binaries (generated by postinstall scripts)
/assets/js/vendor/neplex-vectorizer/*/node_modules/
/assets/js/vendor/neplex-vectorizer/**/*.node
test-modal-fix.html
