# Set default behavior to auto-detect text vs binary
* text=auto eol=lf

# Explicitly declare text files
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.lock text eol=lf

# Binary files - mark explicitly to prevent corruption and improve pack efficiency
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary

# Fonts (binary)
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.z binary

# Archives and packages (binary)
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary

# Documents (binary)
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Native libraries and executables (binary)
*.so binary
*.dylib binary
*.dll binary
*.node binary
*.exe binary

# Source maps - mark as binary to prevent inefficient text processing
# These are large JSON files not meant for human editing or diff
*.js.map binary
*.ts.map binary
*.css.map binary
*.mjs.map binary

# Minified files - mark as binary (not human-readable, no meaningful diffs)
*.min.js binary
*.min.css binary

# Third-party vendor files - do not normalize line endings.
# These files are owned by external packages and may use CRLF; attempting
# to convert them causes spurious "unstaged changes" warnings during git
# operations (pull --rebase, stash, etc.).
addons/pro/assets/vendor/** -text

# -----------------------------------------------------------------------------
# export-ignore: paths excluded from `git archive` (GitHub "Download ZIP",
# release source tarballs, `composer create-project --prefer-dist`, etc.).
# These rules do NOT affect `git clone` — clones always materialize the full
# tree. For a clean post-clone tree on production servers, run
# bin/strip-dev-files.sh.
#
# Mirrors the dev-only exclusions in .distignore. Keep the two lists in sync
# when adding new dev-only directories or files.
#
# WARNING: patterns match at EVERY depth unless anchored with a leading `/`.
# A bare `src/` silently strips `lib/*/src`, `vendor/*/src` and `addons/*/src`;
# a bare `lib/` stripped the extracted engine from every archive. Anchor
# anything that is meant to be root-only. Note also that export-ignore cannot
# negate a pruned directory: to keep one file inside an ignored tree, ignore
# the children (`dir/**`) and un-ignore the file (`dir/keep.js -export-ignore`).
# -----------------------------------------------------------------------------

# Git / GitHub metadata
.gitattributes              export-ignore
.gitignore                  export-ignore
.git-branch-info            export-ignore
.github/                    export-ignore

# AI agent and editor configuration (dev-only)
.agents/                    export-ignore
.bmad/                      export-ignore
.codex/                     export-ignore
.context/                   export-ignore
.devcontainer/              export-ignore
.wordpress-org/             export-ignore
.editorconfig               export-ignore
.eslintrc.json              export-ignore
.eslintignore               export-ignore
.browserslistrc             export-ignore
.nvmrc                      export-ignore
.codecov.yml                export-ignore
.npmrc                      export-ignore
.idea/                      export-ignore
.vscode/                    export-ignore
.zap-rules.tsv              export-ignore

# Code-style / lint configs (dev-only)
phpcs.xml.dist              export-ignore
CODEOWNERS                  export-ignore
MAINTAINER_MAP.md           export-ignore

# JS/TS build tooling (dev-only)
package.json                export-ignore
package-lock.json           export-ignore
babel.config.js             export-ignore
cleancss.config.js          export-ignore
jest.config.js              export-ignore
jest.setup.js               export-ignore
esbuild.config.js           export-ignore
esbuild.config.pro.js       export-ignore
cosmos.config.json          export-ignore
cosmos.webpack.config.js    export-ignore
webpack.config.js           export-ignore
webpack.config.tma-builder.js   export-ignore
webpack.config.tma.js       export-ignore
webpack.config.workflow.js   export-ignore
tsconfig.json               export-ignore
Makefile                    export-ignore
Gruntfile.js                export-ignore
Gulpfile.js                 export-ignore

# Composer dev metadata
composer.lock               export-ignore
vendor-dev/                 export-ignore

# Development scripts and patches.
# bin/vectorize-image.js is RUNTIME: the image tools spawn it via node for
# SVG output, and bin/build-plugin-zip.sh re-includes it explicitly. It is
# therefore un-ignored below (export-ignore cannot negate a pruned
# directory, hence the `bin/**` file pattern rather than `bin/`).
bin/**                      export-ignore
bin/vectorize-image.js      -export-ignore
patches/                    export-ignore
patches.lock.json           export-ignore

# Test infrastructure (the core AV-trigger reduction goal)
tests/                      export-ignore
phpunit.xml                 export-ignore
phpunit.xml.dist            export-ignore
coverage/                   export-ignore
.phpunit.result.cache       export-ignore
.nyc_output/                export-ignore

# Pro addon test fixtures
addons/pro/tests/           export-ignore

# Embedded addon test fixtures
addons/embedded/tests/      export-ignore

# Proprietary addons must never appear in `git archive` output (GitHub
# release source ZIPs). They are distributed ONLY via their own rsync-built
# standalone ZIPs (bin/build-pro-standalone.sh, bin/build-canvas-addon.sh),
# which read from the working tree and are unaffected by export-ignore.
# The base/WP.org ZIP already excludes addons/ via .distignore.
# NOTE: deliberately NOT a bare `addons/` pattern - that would also strip
# addons/embedded and addons/cloud-worker, which ship inside the base build.
addons/pro/                 export-ignore
addons/canvas/              export-ignore

# Docker (dev-only)
docker-compose.yml          export-ignore
docker/                     export-ignore
Dockerfile                  export-ignore

# Documentation (dev-only; readme.txt / README.md / CHANGELOG.md / CONTRIBUTING.md kept)
docs/                       export-ignore

# Examples (dev/demo material).
# Root-anchored deliberately: the Pro blueprint library lives in
# addons/pro/includes/tools/*/examples/ and MUST ship in release ZIPs —
# an unanchored `examples/` pattern would strip it from `git archive`
# (GitHub release ZIPs), leaving the unified Blueprints page empty.
/examples/                  export-ignore
/assets/examples/           export-ignore

# Root SPA build sources only (only built bundles ship).
# ANCHORED: an unanchored `src/` would strip every nested source tree too -
# lib/core/src, vendor/guzzlehttp/*/src, addons/*/src - breaking both the
# extracted engine and the Composer autoloader in `git archive` output.
/src/                       export-ignore

# AI-generated archive material (dev-only)
archive/wordpress-org-submission/  export-ignore
archive/development-phases/        export-ignore
archive/production-status/         export-ignore

# Misc dev artifacts
mcp-diagnostic-debug.php    export-ignore
test-storage-service.html   export-ignore

# Extracted OOS engine (lib/).
#
# lib/core/src and lib/wordpress-adapter/src are RUNTIME code: the combined
# build ships them and the plugin loads them when the engine is enabled.
# They must survive `git archive`, otherwise a GitHub "Download ZIP" would
# install with an inert engine while bin/build-plugin-zip.sh ships it.
#
# Only analyser/test/dev material is excluded here, mirroring the targeted
# --exclude list in the combined build of bin/build-plugin-zip.sh and
# lib/core/.gitattributes. Base and WordPress.org builds still drop the
# whole tree via .distignore (which lists `lib`).
lib/core/tests/             export-ignore
lib/core/phpstan.neon       export-ignore
lib/core/phpstan.neon.dist  export-ignore
lib/core/phpunit.xml.dist   export-ignore
lib/core/.gitattributes     export-ignore
lib/laravel-adapter/        export-ignore
lib/craft-adapter/          export-ignore
