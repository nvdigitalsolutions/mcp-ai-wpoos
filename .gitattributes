# Set default behavior to auto-detect text vs binary
* text=auto eol=lf

# Explicitly declare text files
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ini text eol=lf
*.lock text eol=lf

# Binary files - mark explicitly to prevent corruption and improve pack efficiency
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary

# Fonts (binary)
# delta=false: font files are already compressed/encoded; delta computation wastes CPU
*.ttf binary delta=false
*.otf binary delta=false
*.woff binary delta=false
*.woff2 binary delta=false
*.eot binary delta=false
# .z = TCPDF/font compressed font data files (not Unix compress; not Zstandard)
*.z binary delta=false

# Archives and packages (binary)
# delta=false: archives are already compressed; attempting delta yields negligible savings
# and inflates pack CPU time, which slows clones of large repositories.
*.zip binary delta=false
*.tar binary
*.gz binary delta=false
*.rar binary delta=false
*.7z binary delta=false

# Documents (binary)
*.pdf binary delta=false
*.doc binary delta=false
*.docx binary delta=false
*.xls binary delta=false
*.xlsx binary delta=false
*.ppt binary delta=false
*.pptx binary delta=false

# Native libraries and executables (binary)
# delta=false: shared libraries and native modules are large pre-linked blobs;
# delta compression achieves almost nothing and wastes significant pack time.
*.so binary delta=false
*.dylib binary delta=false
*.dll binary delta=false
*.node binary delta=false
*.exe binary delta=false

# Source maps - mark as binary to prevent inefficient text processing
# These are large JSON files not meant for human editing or diff
*.js.map binary
*.ts.map binary
*.css.map binary
*.mjs.map binary

# Minified files - mark as binary (not human-readable, no meaningful diffs)
*.min.js binary
*.min.css binary

# Third-party vendor files - do not normalize line endings.
# These files are owned by external packages and may use CRLF; attempting
# to convert them causes spurious "unstaged changes" warnings during git
# operations (pull --rebase, stash, etc.).
addons/pro/assets/vendor/** -text

# ---------------------------------------------------------------------------
# export-ignore: exclude non-deployment paths from `git archive` tarballs.
# Cloudways and other hosts that generate deployment packages via git archive
# will produce significantly smaller archives when these directories are omitted.
# ---------------------------------------------------------------------------
.github export-ignore
.codex export-ignore
.devcontainer export-ignore
.vscode export-ignore
.wordpress-org export-ignore
archive export-ignore
bin export-ignore
docs export-ignore
tests export-ignore
build export-ignore
examples export-ignore
patches export-ignore
src export-ignore
coverage export-ignore
.codecov.yml export-ignore
.editorconfig export-ignore
.eslintignore export-ignore
.eslintrc.json export-ignore
.nvmrc export-ignore
.npmrc export-ignore
babel.config.js export-ignore
jest.config.js export-ignore
esbuild.config.js export-ignore
esbuild.config.pro.js export-ignore
webpack.config.js export-ignore
tsconfig.json export-ignore
phpcs.xml.dist export-ignore
phpunit.xml.dist export-ignore
docker-compose.yml export-ignore
CODEOWNERS export-ignore
CONTRIBUTING.md export-ignore
composer.json export-ignore
composer.lock export-ignore
package.json export-ignore
package-lock.json export-ignore
patches.lock.json export-ignore
.distignore export-ignore
.git-branch-info export-ignore
