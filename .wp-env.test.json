{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.2",
	"plugins": [
		".",
		"https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip",
		"https://downloads.wordpress.org/plugin/elementor.latest-stable.zip",
		"https://downloads.wordpress.org/plugin/seo-by-rank-math.latest-stable.zip",
		"https://downloads.wordpress.org/plugin/insert-headers-and-footers.latest-stable.zip"
	],
	"themes": [],
	"port": 8890,
	"testsPort": 8891,
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "development",
		"WP_MCP_AI_DEBUG": true,
		"WP_PHPUNIT__TESTS_CONFIG": "/var/www/html/wp-content/plugins/wp-mcp-ai/tests/wp-tests-config.php"
	},
	"mappings": {
		"wp-content/plugins/wp-mcp-ai": "."
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli --env-cwd=wp-content/plugins/wp-mcp-ai composer install --no-interaction"
	}
}
