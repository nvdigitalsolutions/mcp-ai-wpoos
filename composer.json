{
    "name": "nvdigitalsolutions/mcp-ai-wpoos",
    "description": "NV Digital Open Operator System (oOS) - WordPress plugin integrating MCP tools with AI workflows.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "NV Digital Solutions",
            "email": "developer@nvdigitalsolutions.com",
            "homepage": "https://nvdigitalsolutions.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://nvdigitalsolutions.com/wpoos",
    "support": {
        "issues": "https://github.com/nvdigitalsolutions/mcp-ai-wpoos/issues",
        "source": "https://github.com/nvdigitalsolutions/mcp-ai-wpoos"
    },
    "_comment": "Symfony deps are pinned to the 6.4 LTS line because the base plugin's PHP floor is 7.4. Symfony 7.x requires PHP 8.2+ and uses readonly/enum syntax that fatal-parses on PHP 7.4 even when not executed. 6.4 LTS is supported until November 2027.",
    "require": {
        "composer/installers": "^2.0",
        "rahul900day/tiktoken-php": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/http-client": "^6.4.36",
        "guzzlehttp/psr7": "^2.10.2",
        "nyholm/psr7": "^1.8",
        "symfony/validator": "^6.4.36",
        "symfony/cache": "^6.4.40",
        "symfony/filesystem": "^6.4.34",
        "symfony/process": "^6.4.33",
        "league/oauth2-client": "^2.7"
    },
    "require-dev": {
        "cweagans/composer-patches": "^2.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "php-stubs/wordpress-stubs": "^7.0",
        "squizlabs/php_codesniffer": "*",
        "wp-coding-standards/wpcs": "*",
        "phpunit/phpunit": "^11.5",
        "wp-phpunit/wp-phpunit": "*",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:errors-only": "phpcs --error-severity=1 --warning-severity=8",
        "lint:compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4-8.3 --extensions=php --ignore=vendor,node_modules,addons/pro/vendor,assets/examples,bin,docker,tests/helpers,tests/fixtures .",
        "lint:base": "phpcs --error-severity=1 --warning-severity=8 --ignore=vendor,node_modules,addons/pro,addons/pro/vendor,assets/examples,examples,bin,docker,tests .",
        "lint:base:compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4-8.3 --extensions=php --ignore=vendor,node_modules,addons/pro,addons/pro/vendor,assets/examples,examples,bin,docker,tests .",
        "format": "phpcbf",
        "pot": "wp i18n make-pot . languages/mcp-ai-wpoos.pot --exclude=vendor,node_modules",
        "test:install": "bash bin/install-wp-tests.sh wordpress_test root '' localhost latest",
        "test": "vendor/bin/phpunit",
        "test:studio": "@php bin/test-studio-runner.php",
        "test:coverage": "vendor/bin/phpunit --coverage-html coverage/ --coverage-clover coverage.xml",
        "test:coverage-dashboard": "bash bin/generate-coverage-dashboard.sh",
        "test:gaps": "bash bin/find-untested-classes.sh",
        "test:gaps:check": "bash bin/find-untested-classes.sh --check",
        "docs:check-folder-readmes": "php bin/check-folder-readmes.php --scope=base",
        "docs:check-folder-readmes:all": "php bin/check-folder-readmes.php --scope=all",
        "docs:check-folder-readmes:strict": "php bin/check-folder-readmes.php --scope=base --strict",
        "build:autoload": "composer install --no-dev --classmap-authoritative --no-interaction",
        "skills:sync": "@php bin/sync-agent-skills.php",
        "ci:all": [
            "@lint:errors-only",
            "@docs:check-folder-readmes",
            "@test:gaps:check",
            "@test:coverage"
        ]
    },
    "extra": {
        "patches": {
            "wp-phpunit/wp-phpunit": {
                "Add guard check for WP_LANG_DIR constant": "patches/wp-phpunit-wp-lang-dir-guard.patch",
                "PHPUnit 10+ compatibility: Reflection fallback and getTickets guard": "patches/wp-phpunit-phpunit10-compat.patch"
            },
            "league/oauth2-client": {
                "Remove deprecated approval_prompt parameter to fix Google OAuth conflict": "patches/league-oauth2-client-remove-approval-prompt.patch"
            },
            "phpunit/phpunit": {
                "Allow WordPress hyphenated test file names in TestSuiteLoader": "patches/phpunit11-allow-wordpress-test-naming.patch"
            }
        },
        "php_codesniffer": {
            "installed_paths": [
                "vendor/wp-coding-standards/wpcs",
                "vendor/phpcompatibility/php-compatibility"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "composer/installers": true
        },
        "classmap-authoritative": true,
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": {
            "wp-phpunit/wp-phpunit": "source",
            "league/oauth2-client": "source",
            "phpunit/phpunit": "source",
            "*": "dist"
        }
    }
}
